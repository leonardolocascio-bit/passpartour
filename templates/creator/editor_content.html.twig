{% extends 'app.html.twig' %}

{% block title %}Editor Content · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Editor Content{% endblock %}

{% block main %}
<p class="muted" style="margin:0 0 16px;max-width:760px">
    Post singoli e caroselli Instagram/Facebook (3:4, 1080×1440) generati dall'offerta.
    Con «Salva in Archivio Digital» le slide finiscono in archivio come JPG, pronte per la pubblicazione.
    Contenuti già pronti si caricano direttamente dall'<a class="tab-link" href="{{ path('app_creator_archivio_digital') }}">Archivio Digital</a>.
</p>

<div class="card" style="max-width:560px"><div class="card-pad">
    <strong>Genera contenuto</strong>
    <p class="muted" style="font-size:13px;margin:6px 0 12px">Scegli l'offerta da impaginare: resti nel Creator Studio.</p>
    {% if offerte|length %}
        <form method="get" id="form-genera-contenuto" style="display:flex;gap:10px;align-items:center">
            <select id="sel-offerta-content" style="flex:1;min-width:0">
                {% for o in offerte %}
                    <option value="{{ path('app_creator_content_offerta', {id: o.id}) }}">
                        {{ o.titolo }}{{ o.destinazioneMacro ? ' · ' ~ o.destinazioneMacro }}{{ o.prezzoDa ? ' · da € ' ~ o.prezzoDa|number_format(0, ',', '.') }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-primary">✨ Genera contenuto</button>
        </form>
        <script>
            document.getElementById('form-genera-contenuto').addEventListener('submit', function (e) {
                e.preventDefault();
                window.location.href = document.getElementById('sel-offerta-content').value;
            });
        </script>
    {% else %}
        <p class="muted" style="margin:0">Nessuna offerta: creane una nella sezione Portale → Offerte.</p>
    {% endif %}
</div></div>
{% endblock %}
