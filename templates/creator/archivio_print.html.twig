{% extends 'app.html.twig' %}

{% block title %}Archivio Print · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Archivio Print{% endblock %}

{% block main %}
<div class="card" style="margin-bottom:18px">
    <div class="card-pad">
        <h3 style="margin-bottom:12px">Aggiungi PDF</h3>
        <form method="post" action="{{ path('app_creator_print_nuovo') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('print_nuovo') }}">
            <div style="display:grid;grid-template-columns:2fr 2fr 1fr 2fr;gap:14px;align-items:end">
                <div>
                    <label>Offerta</label>
                    <select name="offerta_id">
                        <option value="">— nessuna (titolo libero) —</option>
                        {% for o in offerte %}<option value="{{ o.id }}">{{ o.titolo }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label>Titolo <span class="muted" style="font-weight:400">(se nessuna offerta)</span></label>
                    <input type="text" name="titolo" placeholder="es. Cartello vetrina Natale">
                </div>
                <div>
                    <label>Formato</label>
                    <select name="formato">
                        {% for f in formati %}<option value="{{ f.value }}">{{ f.label }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label>File PDF</label>
                    <input type="file" name="file" accept=".pdf" required>
                </div>
            </div>
            <button class="btn btn-primary" style="margin-top:12px">Aggiungi all'archivio</button>
        </form>
        <p class="muted" style="margin:10px 0 0;font-size:12px">Il file viene archiviato come <code>[offerta]_[formato]_[orientamento]_[data generazione].pdf</code></p>
    </div>
</div>

<div class="card">
    <div class="card-pad" style="border-bottom:1px solid var(--line)">
        <h3>PDF archiviati <span class="muted" style="font-weight:500">({{ contenuti|length }})</span></h3>
    </div>
    <table class="grid-table">
        <thead><tr><th>Titolo</th><th>Formato</th><th>Nome file</th><th>Generato il</th><th></th></tr></thead>
        <tbody>
        {% for c in contenuti %}
            <tr>
                <td style="font-weight:600">{{ c.titolo }}</td>
                <td><span class="badge">{{ c.formato.label }}</span></td>
                <td class="muted" style="font-size:12px">{{ c.file }}</td>
                <td class="muted">{{ c.createdAt|date('d/m/Y H:i') }}</td>
                <td style="text-align:right;white-space:nowrap">
                    <a class="btn" href="{{ asset('uploads/creator/print/' ~ c.file) }}" target="_blank">Apri PDF</a>
                    <form method="post" action="{{ path('app_creator_print_elimina', {id: c.id}) }}" style="display:inline" onsubmit="return confirm('Eliminare questo PDF?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('print_elimina_' ~ c.id) }}">
                        <button class="btn" style="color:var(--danger)">Elimina</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="muted" style="text-align:center;padding:28px">Archivio vuoto: i PDF generati dall'editor print finiranno qui.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
