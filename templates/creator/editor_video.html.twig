{% extends 'app.html.twig' %}

{% block title %}Editor Video · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Editor Video{% endblock %}

{% block main %}
<style>
    /* ---- workspace scuro stile CapCut: rail + libreria + preview + proprietà, timeline sotto ---- */
    .ev-studio { --evbg:#10151f; --evpan:#161d2b; --evpan2:#1c2434; --evline:#2a3650; --evtx:#e8edf5; --evmut:#8fa0bb;
        background:var(--evbg); border-radius:14px; color:var(--evtx); overflow:hidden; border:1px solid #0b0f17;
        font-size:12px; }
    .ev-top { display:grid; grid-template-columns:56px 254px minmax(0,1fr) 292px; min-height:480px; }
    .ev-studio label { font-size:11px; color:var(--evmut); }
    .ev-studio input, .ev-studio select, .ev-studio textarea {
        background:#0d1420; border:1px solid var(--evline); color:var(--evtx); border-radius:7px; padding:5px 8px; font-size:12px; width:100%; }
    .ev-studio input[type=range] { padding:0; background:transparent; border:0; accent-color:var(--brand); }
    .ev-studio input[type=checkbox] { width:auto; accent-color:var(--brand); }
    .ev-studio input[type=color] { padding:2px; height:30px; cursor:pointer; }
    .ev-btn { background:var(--evpan2); border:1px solid var(--evline); color:var(--evtx); border-radius:7px;
        padding:5px 10px; font-size:12px; cursor:pointer; display:inline-flex; align-items:center; gap:6px; }
    .ev-btn:hover { border-color:var(--brand); }
    .ev-btn.on { background:var(--brand); border-color:var(--brand); color:#fff; }
    .ev-btn:disabled { opacity:.35; cursor:default; }
    .ev-btn.primario { background:var(--brand); border-color:var(--brand); color:#fff; font-weight:600; }
    .ev-studio .ico { display:inline-flex; }
    .ev-studio .ico svg { width:15px; height:15px; }
    .ev-tbtn { width:36px; height:36px; border-radius:50%; background:var(--evpan2); border:1px solid var(--evline);
        color:var(--evtx); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
    .ev-tbtn:hover { border-color:var(--brand); }
    .ev-tbtn svg { width:15px; height:15px; }
    .ev-tbtn.grande { width:44px; height:44px; background:var(--brand); border-color:var(--brand); color:#fff; }
    .ev-tbtn.grande svg { width:18px; height:18px; }

    /* rail icone */
    .ev-rail { background:#0b101a; display:flex; flex-direction:column; align-items:center; gap:2px; padding:10px 0; }
    .ev-rail button { width:48px; padding:8px 0 6px; background:none; border:0; color:var(--evmut); cursor:pointer;
        border-radius:10px; line-height:1.1; display:flex; flex-direction:column; align-items:center; gap:3px; }
    .ev-rail button svg { width:18px; height:18px; }
    .ev-rail button small { font-size:8.5px; letter-spacing:.02em; }
    .ev-rail button.on { background:var(--evpan2); color:#fff; }
    .ev-rail button:hover { color:#fff; }

    /* libreria */
    .ev-lib { background:var(--evpan); border-right:1px solid var(--evline); padding:12px; overflow-y:auto; max-height:72vh; }
    .ev-lib h4, .ev-prop h3 { font-size:10.5px; margin:0 0 10px; color:var(--evmut); text-transform:uppercase; letter-spacing:.09em; font-weight:700; }
    .ev-prop h3 .valore { color:var(--evtx); font-weight:500; text-transform:none; letter-spacing:0; }
    .ev-lib .hint { font-size:10.5px; color:var(--evmut); margin:8px 0; line-height:1.5; }
    .ev-cards { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .ev-card { background:var(--evpan2); border:2px solid transparent; border-radius:9px; padding:0; cursor:pointer;
        overflow:hidden; text-align:center; color:var(--evtx); }
    .ev-card:hover { border-color:#3b4c6e; }
    .ev-card.on { border-color:var(--brand); }
    .ev-card .anteprima { height:52px; display:flex; align-items:center; justify-content:center; font-size:21px;
        background:linear-gradient(135deg,#123a72,#1f9fd6); position:relative; overflow:hidden; }
    .ev-card .anteprima img { width:100%; height:100%; object-fit:cover; }
    .ev-card .etich { display:block; font-size:10.5px; padding:4px 4px 5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ev-bin { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; }
    .ev-bin .ev-card { cursor:grab; }
    .ev-bin .ev-card .anteprima { background:#0d1420; }
    .ev-bin .durata { position:absolute; right:3px; bottom:3px; background:rgba(0,0,0,.72); color:#fff; font-size:9px;
        padding:1px 4px; border-radius:4px; }
    .ev-stilecard { background:var(--evpan2); border:2px solid transparent; border-radius:9px; cursor:pointer;
        padding:10px 6px; text-align:center; color:#fff; overflow:hidden; }
    .ev-stilecard:hover { border-color:#3b4c6e; }

    /* centro: preview */
    .ev-centro { display:flex; flex-direction:column; align-items:center; padding:14px 14px 10px; min-width:0; }
    .ev-palco { position:relative; display:flex; align-items:center; justify-content:center; width:100%; }
    #tela { max-width:100%; max-height:46vh; background:#000; border-radius:8px; touch-action:none; box-shadow:0 0 0 1px #000; }
    .ev-controlli { display:flex; gap:10px; align-items:center; margin-top:12px; flex-wrap:wrap; justify-content:center; }
    #stato { font-size:11.5px; color:var(--evmut); margin-top:7px; text-align:center; }

    /* proprietà */
    .ev-prop { background:var(--evpan); border-left:1px solid var(--evline); padding:12px; overflow-y:auto; max-height:72vh; }
    .ev-prop .sez { border-top:1px solid var(--evline); margin-top:12px; padding-top:10px; }
    .ev-row2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .ev-row3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; }
    .ev-mini { font-size:11px; padding:4px 8px; }
    .ev-sw { display:flex; gap:4px; }
    .ev-sw button { width:24px; height:24px; border-radius:6px; border:2px solid transparent; cursor:pointer; }
    .ev-sw button.on { border-color:var(--brand); }
    .ev-stili { display:flex; gap:5px; flex-wrap:wrap; }
    .ev-stili button { font-size:10.5px; padding:3px 8px; border-radius:999px; border:1px solid var(--evline);
        background:var(--evpan2); color:var(--evtx); cursor:pointer; }
    .ev-stili button:hover { border-color:var(--brand); }
    details.ev-sez { border-top:1px solid var(--evline); margin-top:10px; padding-top:8px; }
    details.ev-sez summary { font-size:11px; font-weight:700; cursor:pointer; color:#9fc1ee; text-transform:uppercase; letter-spacing:.07em; }

    /* timeline con intestazioni di traccia fisse */
    .ev-tlbar { display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:8px 14px;
        border-top:1px solid var(--evline); background:var(--evpan); }
    .ev-tlzona { display:flex; background:#0d1320; }
    .ev-gutter { flex:0 0 102px; padding:10px 8px 12px 14px; border-right:1px solid var(--evline); }
    .g-riga { display:flex; align-items:center; gap:6px; font-size:9.5px; color:#5e6f8d; text-transform:uppercase;
        letter-spacing:.05em; margin-top:5px; white-space:nowrap; }
    .g-riga.ruler { height:22px; margin-top:0; }
    .g-riga.v { height:50px; }
    .g-riga.s { height:34px; }
    .g-riga.m { height:46px; }
    .g-tgl { background:none; border:0; color:#5e6f8d; cursor:pointer; padding:0; display:inline-flex; }
    .g-tgl svg { width:13px; height:13px; }
    .g-tgl:hover { color:#fff; }
    .g-tgl.off { color:#39455e; }
    .ev-timeline { overflow-x:auto; flex:1; padding:10px 14px 12px 10px; }
    .ev-timeline::-webkit-scrollbar, .ev-lib::-webkit-scrollbar, .ev-prop::-webkit-scrollbar { width:9px; height:9px; }
    .ev-timeline::-webkit-scrollbar-thumb, .ev-lib::-webkit-scrollbar-thumb, .ev-prop::-webkit-scrollbar-thumb { background:#2a3650; border-radius:5px; }
    .ev-ruler { position:relative; height:22px; cursor:pointer; }
    .ev-ruler .tick { position:absolute; top:0; font-size:9px; color:#5e6f8d;
        border-left:1px solid #2b3954; padding-left:3px; height:22px; }
    .ev-track { position:relative; height:50px; margin-top:5px; border-radius:6px;
        background:rgba(255,255,255,.022); }
    .ev-track.bassa { height:34px; }
    .ev-track.media { height:46px; }
    .ev-track.off .ev-blocco { opacity:.3; filter:grayscale(.6); }
    .ev-blocco { position:absolute; top:3px; height:44px; border-radius:7px; overflow:hidden; cursor:grab;
        border:2px solid transparent; background:#1d3a6b; color:#fff; font-size:10.5px; user-select:none; }
    .ev-blocco.sel { border-color:var(--brand); box-shadow:0 0 0 2px rgba(234,91,36,.3); }
    .ev-blocco .nome { padding:3px 8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; position:relative;
        z-index:1; background:linear-gradient(180deg,rgba(5,10,20,.65),rgba(5,10,20,0)); }
    .ev-blocco .maniglia { position:absolute; top:0; bottom:0; width:9px; cursor:ew-resize; z-index:2;
        background:rgba(255,255,255,.3); opacity:0; }
    .ev-blocco:hover .maniglia, .ev-blocco.sel .maniglia { opacity:1; }
    .ev-blocco .maniglia.l { left:0; border-radius:7px 0 0 7px; }
    .ev-blocco .maniglia.r { right:0; border-radius:0 7px 7px 0; }
    .ev-blocco.testo { height:28px; background:var(--amber); color:#5b3b00; font-weight:600; }
    .ev-blocco.testo .nome, .ev-blocco.grafica .nome { background:none; }
    .ev-blocco.grafica { height:28px; background:#1f9fd6; }
    .ev-blocco.musica { height:40px; background:#17804a; background-size:100% 100%; }
    .ev-playhead { position:absolute; top:0; bottom:0; width:2px; background:var(--brand); z-index:3; pointer-events:none; }
    .ev-playhead::before { content:''; position:absolute; top:-1px; left:-5px; border:6px solid transparent; border-top-color:var(--brand); }

    @media (max-width: 1100px) { .ev-top { grid-template-columns:56px 212px minmax(0,1fr); } .ev-prop { grid-column:1 / -1; border-left:0; border-top:1px solid var(--evline); max-height:none; } }
</style>

<div class="ev-studio">
    <div class="ev-top">
        {# ------- rail ------- #}
        <div class="ev-rail" id="rail">
            <button type="button" data-lib="media" data-ico="film" class="on"><small>Media</small></button>
            <button type="button" data-lib="audio" data-ico="musica"><small>Audio</small></button>
            <button type="button" data-lib="testo" data-ico="testo"><small>Testo</small></button>
            <button type="button" data-lib="graf" data-ico="img"><small>Grafiche</small></button>
            <button type="button" data-lib="effetti" data-ico="fx"><small>Effetti</small></button>
            <button type="button" data-lib="trans" data-ico="trans"><small>Transiz.</small></button>
            <button type="button" data-lib="filtri" data-ico="goccia"><small>Filtri</small></button>
        </div>

        {# ------- libreria ------- #}
        <div class="ev-lib">
            <div data-pane="media">
                <h4>File multimediali</h4>
                <label class="ev-btn" style="display:flex;justify-content:center;cursor:pointer">＋ Carica clip
                    <input type="file" id="clip-file" accept="video/*" multiple style="display:none">
                </label>
                <span id="sting-btns" style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap"></span>
                <div class="ev-bin" id="bin-media"></div>
                <p class="hint">Trascina una scheda sulla traccia che vuoi (A, B o C) nel punto giusto della timeline;
                    un clic la accoda alla traccia A. Le clip in timeline si spostano anche <b>in verticale</b> tra le tracce.</p>
            </div>
            <div data-pane="audio" hidden>
                <h4>Audio</h4>
                <label class="ev-btn" style="display:flex;justify-content:center;cursor:pointer">＋ Carica musica
                    <input type="file" id="musica-file" accept="audio/*" multiple style="display:none">
                </label>
                <div class="ev-bin" id="bin-audio" style="grid-template-columns:1fr"></div>
                <p class="hint">Trascina sulla traccia Musica o clicca per aggiungere al cursore. Dal pannello della clip
                    puoi anche <b>estrarre l'audio</b> di un video.</p>
            </div>
            <div data-pane="testo" hidden>
                <h4>Testo</h4>
                <button type="button" class="ev-btn" id="btn-overlay" style="display:flex;width:100%;justify-content:center">＋ Testo semplice</button>
                <div class="ev-cards" id="gal-stili" style="margin-top:10px"></div>
                <p class="hint">Un clic aggiunge il testo al cursore con lo stile scelto; poi trascinalo sul video e
                    ridimensionalo con la maniglia d'angolo.</p>
            </div>
            <div data-pane="graf" hidden>
                <h4>Grafiche</h4>
                <label class="ev-btn" style="display:flex;justify-content:center;cursor:pointer">＋ Carica immagine
                    <input type="file" id="grafica-file" accept="image/*" multiple style="display:none">
                </label>
                <div id="icone-tit" class="hint" style="display:none;margin-bottom:4px"><b>Icone del Media Kit</b></div>
                <div class="ev-cards" id="icone-grid" style="grid-template-columns:1fr 1fr 1fr"></div>
                <p class="hint">Trascinala sul video; angolo = ridimensiona, maniglia in alto = ruota. Opacità nel pannello.</p>
            </div>
            <div data-pane="effetti" hidden>
                <h4>Effetti clip</h4>
                <div class="ev-cards" id="gal-effetti"></div>
                <p class="hint">Seleziona una clip in timeline, poi clicca un effetto per applicarlo.
                    <b>Chroma key e scontorno AI</b> sono nel pannello della clip.</p>
            </div>
            <div data-pane="trans" hidden>
                <h4>Transizioni</h4>
                <div class="ev-cards" id="gal-trans"></div>
                <p class="hint">Si applica all'<b>ingresso</b> della clip selezionata. Durata nel pannello a destra.</p>
            </div>
            <div data-pane="filtri" hidden>
                <h4>Filtri colore</h4>
                <div class="ev-cards" id="gal-filtri"></div>
                <p class="hint">Anteprima sul fotogramma della clip selezionata; un clic lo applica.</p>
            </div>
        </div>

        {# ------- centro: preview ------- #}
        <div class="ev-centro">
            <div class="ev-palco"><canvas id="tela"></canvas></div>
            <div class="ev-controlli">
                <button type="button" class="ev-tbtn" id="btn-inizio" title="Torna all'inizio"></button>
                <button type="button" class="ev-tbtn grande" id="btn-play" title="Riproduci / pausa (spazio)"></button>
                <span style="font-size:12px;color:var(--evmut);font-variant-numeric:tabular-nums"><span id="t-cur">0.0</span>s / <span id="t-tot">0.0</span>s</span>
                <button type="button" class="ev-btn ev-mini" id="btn-guide" title="Zone sicure IG/TikTok in anteprima (non esportate)">Guide</button>
                <button type="button" class="ev-btn primario" id="btn-esporta"><span class="ico" data-ico="scarica"></span> Esporta</button>
                <label style="display:flex;gap:5px;align-items:center;font-size:11.5px;cursor:pointer;color:var(--evmut)">
                    <input type="checkbox" id="chk-no-musica"> senza musica
                </label>
            </div>
            <div id="riga-eyeline" style="display:none;align-items:center;gap:8px;justify-content:center;margin-top:6px">
                <span style="font-size:11px;color:var(--evmut)">Linea occhi</span>
                <input type="range" id="eyeline" min="10" max="90" value="38" style="width:160px">
            </div>
            <div id="stato">Carica le clip per iniziare.</div>
            <div id="risultato" style="margin-top:10px;display:none;width:100%;max-width:420px">
                <video id="video-finale" controls style="width:100%;max-height:260px;border-radius:10px"></video>
                <div style="display:flex;gap:8px;justify-content:center;margin-top:8px;flex-wrap:wrap">
                    <a class="ev-btn" id="btn-scarica" download>⬇ Scarica</a>
                    <button type="button" class="ev-btn primario" id="btn-archivia">Salva in Archivio Digital</button>
                </div>
            </div>
        </div>

        {# ------- proprietà ------- #}
        <div class="ev-prop">
            <div>
                <h3>Progetto</h3>
                <div class="ev-row2">
                    <div>
                        <label>Formato</label>
                        <select id="imp-formato">
                            <option value="9:16">Reel 9:16</option>
                            <option value="4:5">Post 4:5</option>
                            <option value="1:1">Quadrato 1:1</option>
                            <option value="16:9">16:9</option>
                        </select>
                    </div>
                    <div>
                        <label>Titolo (archivio)</label>
                        <input type="text" id="imp-nome" placeholder="es. Reel Maldive">
                    </div>
                </div>
                <div class="ev-row2" style="margin-top:8px">
                    <div>
                        <label>Logo (Media Kit)</label>
                        <select id="imp-logo">
                            <option value="">Nessuno</option>
                            <option value="tr" selected>In alto a destra</option>
                            <option value="tl">In alto a sinistra</option>
                            <option value="br">In basso a destra</option>
                            <option value="bl">In basso a sinistra</option>
                        </select>
                    </div>
                    <div>
                        <label>Dim. logo <span id="logo-size-v">18%</span></label>
                        <input type="range" id="imp-logo-size" min="8" max="36" value="18">
                    </div>
                </div>
            </div>

            <div class="sez" id="pan-vuoto">
                <p class="hint" style="font-size:11px;color:var(--evmut);line-height:1.5;margin:0">
                    Seleziona un blocco in timeline (o un testo/grafica sul video) per vederne le proprietà qui.
                </p>
            </div>

            <div class="sez" id="pan-clip" style="display:none">
                <h3>Clip <span class="valore" id="pc-nome"></span></h3>
                <div class="ev-row3">
                    <div><label>Inizio (s)</label><input type="number" id="pc-t" min="0" step="0.1"></div>
                    <div><label>Da (s)</label><input type="number" id="pc-in" min="0" step="0.1"></div>
                    <div><label>A (s)</label><input type="number" id="pc-out" min="0" step="0.1"></div>
                </div>
                <div class="ev-row3" style="margin-top:8px">
                    <div><label>Traccia</label>
                        <select id="pc-traccia"><option value="0">A (base)</option><option value="1">B</option><option value="2">C</option></select>
                    </div>
                    <div><label>Velocità</label>
                        <select id="pc-vel"><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option><option value="3">3×</option></select>
                    </div>
                    <div><label>Riquadro</label>
                        <select id="pc-pip"><option value="1">Pieno</option><option value="0.45">PiP piccolo</option><option value="0.6">PiP medio</option></select>
                    </div>
                </div>
                <div style="display:flex;gap:5px;margin-top:6px;flex-wrap:wrap">
                    <button type="button" class="ev-btn ev-mini" id="pc-in-ph">[ dal cursore</button>
                    <button type="button" class="ev-btn ev-mini" id="pc-out-ph">al cursore ]</button>
                    <button type="button" class="ev-btn ev-mini" id="pc-estrai" title="Sposta l'audio della clip su una traccia musicale (clip muta)">Estrai audio</button>
                </div>
                <div class="ev-row2" style="margin-top:8px">
                    <div>
                        <label>Transizione ingresso</label>
                        <select id="pc-trans"></select>
                    </div>
                    <div><label>Durata trans. (s)</label><input type="number" id="pc-transdur" min="0.2" max="2" step="0.1" value="0.6"></div>
                </div>
                <div class="ev-row2" style="margin-top:8px">
                    <div><label>Filtro colore</label><select id="pc-preset"></select></div>
                    <div><label>Effetto</label><select id="pc-effetto"></select></div>
                </div>
                <div class="ev-row3" style="margin-top:8px">
                    <div><label>Lum. <span id="pc-lum-v">100</span></label><input type="range" id="pc-lum" min="50" max="150" value="100"></div>
                    <div><label>Contr. <span id="pc-con-v">100</span></label><input type="range" id="pc-con" min="50" max="150" value="100"></div>
                    <div><label>Sat. <span id="pc-sat-v">100</span></label><input type="range" id="pc-sat" min="0" max="200" value="100"></div>
                </div>
                <details class="ev-sez" open>
                    <summary>Trasforma e trasparenza</summary>
                    <div class="ev-row3" style="margin-top:8px">
                        <div><label>Riempimento</label>
                            <select id="pc-fit"><option value="cover">Riempi</option><option value="contain">Adatta</option><option value="sfondo">Adatta + sfondo sfocato</option></select>
                        </div>
                        <div><label>Scala <span id="pc-scala-v">100%</span></label><input type="range" id="pc-scala" min="50" max="250" value="100"></div>
                        <div><label>Rotaz. <span id="pc-rot-v">0°</span></label><input type="range" id="pc-rot" min="-45" max="45" value="0"></div>
                    </div>
                    <div class="ev-row3" style="margin-top:8px;align-items:center">
                        <div><label>Pos. X <span id="pc-px-v">0</span></label><input type="range" id="pc-px" min="-50" max="50" value="0"></div>
                        <div><label>Pos. Y <span id="pc-py-v">0</span></label><input type="range" id="pc-py" min="-50" max="50" value="0"></div>
                        <div><label>Opacità <span id="pc-opa-v">100%</span></label><input type="range" id="pc-opa" min="5" max="100" value="100"></div>
                    </div>
                    <label style="display:flex;gap:6px;align-items:center;cursor:pointer;margin-top:8px;font-size:12px;color:var(--evtx)">
                        <input type="checkbox" id="pc-flip"> Specchia orizzontalmente
                    </label>
                </details>
                <details class="ev-sez">
                    <summary>Chroma key e scontorno</summary>
                    <label style="display:flex;gap:6px;align-items:center;cursor:pointer;margin-top:8px;font-size:12px;color:var(--evtx)">
                        <input type="checkbox" id="pc-chroma"> Chroma key (rimuovi un colore)
                    </label>
