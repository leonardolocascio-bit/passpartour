        stingBox.appendChild(b);
    }

    /* ================= chroma key ================= */
    function applicaChroma(c) {
        const v = c.video;
        const cfg = c.chromaCol + '|' + c.chromaTol + '|' + c.chromaMorb;
        if (c._fx && c._fxT === v.currentTime && c._fxCfg === cfg) return c._fx;
        if (!c._fx) { c._fx = document.createElement('canvas'); c._fxCtx = c._fx.getContext('2d', { willReadFrequently: true }); }
        // elaborazione a risoluzione ridotta: basta per il compositing, costa 1/4
        const sc = Math.min(1, 540 / (v.videoHeight || 540));
        const w = Math.max(2, Math.round(v.videoWidth * sc)), h = Math.max(2, Math.round(v.videoHeight * sc));
        if (c._fx.width !== w || c._fx.height !== h) { c._fx.width = w; c._fx.height = h; }
        const g = c._fxCtx;
        g.clearRect(0, 0, w, h);
        g.drawImage(v, 0, 0, w, h);
        let im;
        try { im = g.getImageData(0, 0, w, h); } catch (e) { return v; }
        const d = im.data;
        const kr = parseInt(c.chromaCol.slice(1, 3), 16), kg = parseInt(c.chromaCol.slice(3, 5), 16), kb = parseInt(c.chromaCol.slice(5, 7), 16);
        const t0 = c.chromaTol * 2.0, t1 = t0 + 1 + c.chromaMorb * 1.6;
        for (let i = 0; i < d.length; i += 4) {
            const dr = d[i] - kr, dg = d[i + 1] - kg, db = d[i + 2] - kb;
            const dist = Math.sqrt(dr * dr + dg * dg + db * db);
            if (dist < t0) d[i + 3] = 0;
            else if (dist < t1) d[i + 3] = (d[i + 3] * (dist - t0) / (t1 - t0)) | 0;
        }
        g.putImageData(im, 0, 0);
        c._fxT = v.currentTime; c._fxCfg = cfg;
        return c._fx;
    }

    /* ================= scontorno automatico (MediaPipe Selfie Segmentation) ================= */
    let segm = null, segmStato = 'spento', segmBusy = false, segmClip = null; // spento|carico|pronto|fallito
    const segmCb = [];
    function caricaSegm(cb) {
        if (segmStato === 'pronto') return cb(true);
        if (segmStato === 'fallito') return cb(false);
        segmCb.push(cb);
        if (segmStato === 'carico') return;
        segmStato = 'carico';
        const s = document.createElement('script');
        s.src = SEGM_BASE + 'selfie_segmentation.js';
        s.onload = () => {
            try {
                segm = new SelfieSegmentation({ locateFile: f => SEGM_BASE + f });
                segm.setOptions({ modelSelection: 1 });
                segm.onResults(r => {
                    const c = segmClip; segmBusy = false;
                    if (!c) return;
                    if (!c._mask) c._mask = document.createElement('canvas');
                    const w = r.image.videoWidth || r.image.width, h = r.image.videoHeight || r.image.height;
                    if (!w || !h) return;
                    const m = c._mask;
                    if (m.width !== w || m.height !== h) { m.width = w; m.height = h; }
                    const g = m.getContext('2d');
                    g.save();
                    g.globalCompositeOperation = 'source-over';
                    g.clearRect(0, 0, w, h);
                    g.drawImage(r.segmentationMask, 0, 0, w, h);
                    g.globalCompositeOperation = 'source-in';
                    g.drawImage(r.image, 0, 0, w, h);
                    g.restore();
                    if (!inPlay && !esportando) disegnaFrame(playhead);
                });
                segmStato = 'pronto';
            } catch (e) { segmStato = 'fallito'; }
            segmCb.splice(0).forEach(f => f(segmStato === 'pronto'));
        };
        s.onerror = () => { segmStato = 'fallito'; segmCb.splice(0).forEach(f => f(false)); };
        document.head.appendChild(s);
    }
    // pompa: una richiesta di segmentazione alla volta, sulla clip attiva col ritaglio
    function pompaSegm() {
        if (segmStato !== 'pronto' || segmBusy) return;
        const c = clips.find(c => c.ritaglio && playhead >= c.t - 0.3 && playhead < fineClip(c) && c.video.readyState >= 2);
        if (!c) return;
        segmBusy = true; segmClip = c;
        segm.send({ image: c.video }).catch(() => { segmBusy = false; });
    }

    // la sorgente da disegnare: cutout AI, chroma key o il video nudo
    function fonte(c) {
        const v = c.video;
        if (c.ritaglio) return (c._mask && c._mask.width) ? c._mask : v;
        if (c.chromaOn && v.videoWidth) return applicaChroma(c);
        return v;
    }

    /* ================= gallerie visuali (effetti / transizioni / filtri / stili) ================= */
    function cardGalleria(box, chiave, icona, label, anteprimaHtml) {
