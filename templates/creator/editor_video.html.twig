    });
    // stato attivo delle gallerie in base alla clip selezionata
    function aggiornaGalleria() {
        const c = clipSel();
        [['gal-effetti', c ? c.effetto : null], ['gal-trans', c ? c.trans : null], ['gal-filtri', c ? c.preset : null]].forEach(([id, val]) => {
