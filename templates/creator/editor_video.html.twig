    $('pc-out-ph').addEventListener('click', () => { const c = clipSel(); if (c && playhead > c.t && playhead < fineClip(c)) { salvaStato(); c.out = Math.min(c.durata, Math.max(tClip(c, playhead), c.in + 0.1)); riempiPannelloClip(c); render(); } });
    function duplicaClip() {
