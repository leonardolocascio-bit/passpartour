{% extends 'app.html.twig' %}

{% block title %}Editor Video · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Editor Video{% endblock %}

{% block main %}
<style>
    .ev-grid { display:grid; grid-template-columns: minmax(0,1fr) minmax(300px,380px); gap:16px; align-items:start; }
    .ev-timeline { overflow-x:auto; border:1px solid var(--line); border-radius:10px; background:#f8fafc; padding:10px; }
    .ev-ruler { position:relative; height:22px; cursor:pointer; }
    .ev-ruler .tick { position:absolute; top:0; font-size:10px; color:var(--muted); border-left:1px solid var(--line); padding-left:3px; height:22px; }
    .ev-track { position:relative; min-height:52px; margin-top:6px; border-top:1px dashed #e3e8f0; }
    .ev-track-label { position:sticky; left:0; font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); z-index:2; }
    .ev-blocco { position:absolute; top:4px; height:46px; border-radius:8px; overflow:hidden; cursor:grab; border:2px solid transparent; background:#123a72; color:#fff; font-size:11px; user-select:none; }
    .ev-blocco.sel { border-color:var(--brand); box-shadow:0 0 0 2px rgba(234,91,36,.25); }
    .ev-blocco .nome { padding:3px 8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; position:relative; z-index:1; text-shadow:0 1px 3px rgba(0,0,0,.8); }
    .ev-blocco img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.7; }
    .ev-blocco .maniglia { position:absolute; top:0; bottom:0; width:9px; cursor:ew-resize; z-index:2; background:rgba(255,255,255,.25); opacity:0; }
    .ev-blocco:hover .maniglia, .ev-blocco.sel .maniglia { opacity:1; }
    .ev-blocco .maniglia.l { left:0; border-radius:8px 0 0 8px; }
    .ev-blocco .maniglia.r { right:0; border-radius:0 8px 8px 0; }
    .ev-blocco.testo { height:30px; background:var(--amber); color:#5b3b00; font-weight:600; }
    .ev-blocco.musica { height:34px; background:#1f9d54; }
    .ev-playhead { position:absolute; top:0; bottom:0; width:2px; background:var(--brand); z-index:3; pointer-events:none; }
    .ev-pan label { font-size:12px; }
    .ev-pan input[type=range] { width:100%; }
    .ev-row2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .ev-row3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; }
    .ev-mini { font-size:12px; padding:4px 8px; }
    .ev-mini.on { background:var(--navy); color:#fff; }
    .ev-sw { display:flex; gap:4px; }
    .ev-sw button { width:26px; height:26px; border-radius:6px; border:2px solid transparent; cursor:pointer; }
    .ev-sw button.on { border-color:var(--brand); }
</style>

<p class="muted" style="margin:0 0 12px;max-width:960px">
    Montaggio multi-traccia: 3 livelli video, testi e più tracce musicali. Trascina liberamente i blocchi sulla
    timeline (🧲 magnete per agganciarli), usa le maniglie per tagliare, estrai l'audio da una clip, trascina i testi
    direttamente sul video. Guide IG/TikTok in anteprima, sting dal Media Kit, export anche senza musica.
</p>

<div class="ev-grid">
    {# ---------------- colonna sinistra: player + timeline ---------------- #}
    <div style="display:grid;gap:12px">
        <div class="card"><div class="card-pad" style="text-align:center">
            <canvas id="tela" style="max-width:100%;max-height:46vh;background:#0a162c;border-radius:10px;touch-action:none"></canvas>
            <div style="display:flex;gap:8px;justify-content:center;align-items:center;margin-top:10px;flex-wrap:wrap">
                <button type="button" class="btn" id="btn-play">▶ Riproduci</button>
                <button type="button" class="btn" id="btn-stop" disabled>⏹ Stop</button>
                <span class="muted" style="font-size:12px"><span id="t-cur">0.0</span>s / <span id="t-tot">0.0</span>s</span>
                <button type="button" class="btn ev-mini" id="btn-guide" title="Zone sicure IG/TikTok in anteprima (non esportate)">📐 Guide</button>
                <button type="button" class="btn btn-primary" id="btn-esporta">⬇ Esporta</button>
                <label style="display:flex;gap:5px;align-items:center;font-size:12px;cursor:pointer">
                    <input type="checkbox" id="chk-no-musica" style="width:auto"> senza musica
                </label>
            </div>
            <div id="riga-eyeline" style="display:none;align-items:center;gap:8px;justify-content:center;margin-top:6px">
                <span class="muted" style="font-size:11px">Linea occhi</span>
                <input type="range" id="eyeline" min="10" max="90" value="38" style="width:160px">
            </div>
            <div id="stato" class="muted" style="font-size:12px;margin-top:6px">Carica le clip per iniziare.</div>
            <div id="risultato" style="margin-top:10px;display:none">
                <video id="video-finale" controls style="width:100%;max-height:300px;border-radius:10px"></video>
                <div style="display:flex;gap:8px;justify-content:center;margin-top:8px;flex-wrap:wrap">
                    <a class="btn" id="btn-scarica" download>⬇ Scarica</a>
                    <button type="button" class="btn btn-primary" id="btn-archivia">🗂 Salva in Archivio Digital</button>
                </div>
            </div>
        </div></div>

        <div class="card"><div class="card-pad">
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px">
                <label class="btn ev-mini" style="cursor:pointer">+ Clip
                    <input type="file" id="clip-file" accept="video/*" multiple style="display:none">
                </label>
                <label class="btn ev-mini" style="cursor:pointer">🎵 Musica
                    <input type="file" id="musica-file" accept="audio/*" multiple style="display:none">
                </label>
                <button type="button" class="btn ev-mini" id="btn-overlay">＋ Testo</button>
                <button type="button" class="btn ev-mini" id="btn-split">✂ Dividi</button>
                <button type="button" class="btn ev-mini" id="btn-magnete" title="Aggancia i blocchi a bordi e cursore">🧲 Magnete</button>
                <span id="sting-btns"></span>
                <span style="margin-left:auto;display:flex;gap:6px;align-items:center" class="muted">
                    <span style="font-size:11px">Zoom</span>
                    <input type="range" id="zoom" min="6" max="80" value="26" style="width:110px">
                </span>
            </div>
            <div class="ev-timeline" id="timeline">
                <div style="position:relative" id="tl-inner">
                    <div class="ev-ruler" id="ruler"></div>
                    <div class="ev-track" id="track-v2"><span class="ev-track-label">Video C (sopra)</span></div>
                    <div class="ev-track" id="track-v1"><span class="ev-track-label">Video B</span></div>
                    <div class="ev-track" id="track-v0"><span class="ev-track-label">Video A (base)</span></div>
                    <div class="ev-track" id="track-testi" style="min-height:40px"><span class="ev-track-label">Testi</span></div>
                    <div class="ev-track" id="track-musica" style="min-height:44px"><span class="ev-track-label">Musica</span></div>
                    <div class="ev-playhead" id="playhead" style="left:0"></div>
                </div>
            </div>
            <p class="muted" style="font-size:11px;margin:6px 0 0">Trascina per spostare · maniglie ai bordi per tagliare · doppio clic su una clip per mandarci il cursore.</p>
        </div></div>
    </div>

    {# ---------------- colonna destra: pannelli proprietà ---------------- #}
    <div style="display:grid;gap:12px" class="ev-pan">
        <div class="card"><div class="card-pad">
            <h3 style="margin-bottom:8px;font-size:14px">Progetto</h3>
            <div class="ev-row2">
                <div>
                    <label>Formato</label>
                    <select id="imp-formato">
                        <option value="9:16">Reel 9:16</option>
                        <option value="1:1">Quadrato 1:1</option>
                        <option value="16:9">16:9</option>
                    </select>
                </div>
                <div>
                    <label>Titolo (per l'archivio)</label>
                    <input type="text" id="imp-nome" placeholder="es. Reel Maldive">
                </div>
            </div>
            <div class="ev-row2" style="margin-top:8px">
                <div>
                    <label>Logo (Media Kit)</label>
                    <select id="imp-logo">
                        <option value="">Nessuno</option>
                        <option value="tr" selected>In alto a destra</option>
                        <option value="tl">In alto a sinistra</option>
                        <option value="br">In basso a destra</option>
                        <option value="bl">In basso a sinistra</option>
                    </select>
                </div>
                <div>
                    <label>Dimensione logo <span id="logo-size-v" class="muted">18%</span></label>
                    <input type="range" id="imp-logo-size" min="8" max="36" value="18">
                </div>
            </div>
        </div></div>

        <div class="card" id="pan-clip" style="display:none"><div class="card-pad">
            <h3 style="margin-bottom:8px;font-size:14px">Clip: <span id="pc-nome" class="muted" style="font-weight:500"></span></h3>
            <div class="ev-row3">
                <div><label>Inizio (s)</label><input type="number" id="pc-t" min="0" step="0.1"></div>
                <div><label>Da (s)</label><input type="number" id="pc-in" min="0" step="0.1"></div>
                <div><label>A (s)</label><input type="number" id="pc-out" min="0" step="0.1"></div>
            </div>
            <div class="ev-row3" style="margin-top:8px">
                <div><label>Traccia</label>
                    <select id="pc-traccia"><option value="0">A (base)</option><option value="1">B</option><option value="2">C</option></select>
                </div>
                <div><label>Velocità</label>
                    <select id="pc-vel"><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.5">1.5×</option><option value="2">2×</option></select>
                </div>
                <div><label>Riquadro</label>
                    <select id="pc-pip"><option value="1">Pieno</option><option value="0.45">PiP piccolo</option><option value="0.6">PiP medio</option></select>
                </div>
            </div>
            <div style="display:flex;gap:6px;margin-top:6px">
                <button type="button" class="btn ev-mini" id="pc-in-ph">[ dal cursore</button>
                <button type="button" class="btn ev-mini" id="pc-out-ph">al cursore ]</button>
                <button type="button" class="btn ev-mini" id="pc-estrai" title="Sposta l'audio della clip su una traccia musicale (clip muta)">🎙 Estrai audio</button>
            </div>
            <div class="ev-row2" style="margin-top:8px">
                <div>
                    <label>Transizione in ingresso</label>
                    <select id="pc-trans">
                        <option value="taglio">Taglio</option>
                        <option value="dissolvenza">Dissolvenza</option>
                        <option value="nero">Dissolvenza al nero</option>
                        <option value="scorri">Scorrimento</option>
                        <option value="wipe">Wipe</option>
                        <option value="zoomin">Zoom in</option>
                    </select>
                </div>
                <div><label>Durata trans. (s)</label><input type="number" id="pc-transdur" min="0.2" max="2" step="0.1" value="0.6"></div>
            </div>
            <div style="margin-top:8px">
                <label>Preset colore</label>
                <select id="pc-preset"></select>
            </div>
            <div class="ev-row3" style="margin-top:8px">
                <div><label>Lumin. <span id="pc-lum-v" class="muted">100</span></label><input type="range" id="pc-lum" min="50" max="150" value="100"></div>
                <div><label>Contr. <span id="pc-con-v" class="muted">100</span></label><input type="range" id="pc-con" min="50" max="150" value="100"></div>
                <div><label>Satur. <span id="pc-sat-v" class="muted">100</span></label><input type="range" id="pc-sat" min="0" max="200" value="100"></div>
            </div>
            <div class="ev-row2" style="margin-top:8px;align-items:center">
                <div><label>Volume clip <span id="pc-vol-v" class="muted">100%</span></label><input type="range" id="pc-vol" min="0" max="100" value="100"></div>
                <label style="display:flex;gap:6px;align-items:center;font-weight:500;cursor:pointer;margin-top:14px">
                    <input type="checkbox" id="pc-kb" style="width:auto"> Zoom lento (Ken Burns)
                </label>
            </div>
            <div style="display:flex;gap:6px;margin-top:10px;justify-content:space-between">
                <button type="button" class="btn ev-mini" id="pc-dup">⧉ Duplica</button>
                <button type="button" class="btn ev-mini" id="pc-del" style="color:var(--danger)">✕ Rimuovi</button>
            </div>
        </div></div>

        <div class="card" id="pan-ov" style="display:none"><div class="card-pad">
            <h3 style="margin-bottom:8px;font-size:14px">Testo <span class="muted" style="font-weight:500;font-size:11px">(trascinalo sul video per posizionarlo)</span></h3>
            <div><label>Testo</label><input type="text" id="po-testo"></div>
            <div class="ev-row3" style="margin-top:8px">
                <div><label>Da (s)</label><input type="number" id="po-da" min="0" step="0.1"></div>
                <div><label>A (s)</label><input type="number" id="po-a" min="0" step="0.1"></div>
                <div><label>Dimensione</label>
                    <select id="po-size"><option value="0.045">Piccolo</option><option value="0.07" selected>Medio</option><option value="0.1">Grande</option></select>
                </div>
            </div>
            <div class="ev-row2" style="margin-top:8px;align-items:end">
                <div>
                    <label>Colore testo</label>
                    <div class="ev-sw" id="po-colori"></div>
                </div>
                <div>
                    <label>Sfondo</label>
                    <div style="display:flex;gap:6px">
                        <select id="po-bg" style="flex:1"><option value="">Nessuno</option><option value="pill">Pillola</option><option value="band">Banda</option></select>
                        <div class="ev-sw" id="po-bg-colori"></div>
                    </div>
                </div>
            </div>
            <div class="ev-row2" style="margin-top:8px">
                <div>
                    <label>Effetto entrata</label>
                    <select id="po-effin">
                        <option value="">Nessuno</option>
                        <option value="fade">Dissolvenza</option>
                        <option value="su">Scorri dal basso</option>
                        <option value="giu">Scorri dall'alto</option>
                        <option value="zoom">Zoom</option>
                        <option value="macchina">Macchina da scrivere</option>
                    </select>
                </div>
                <div>
                    <label>Effetto uscita</label>
                    <select id="po-effout">
                        <option value="">Nessuno</option>
                        <option value="fade">Dissolvenza</option>
                        <option value="su">Scorri verso l'alto</option>
                        <option value="giu">Scorri verso il basso</option>
                        <option value="zoom">Zoom out</option>
                    </select>
                </div>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px">
                <label style="display:flex;gap:5px;align-items:center;font-size:12px;cursor:pointer"><input type="checkbox" id="po-maiuscolo" style="width:auto"> MAIUSCOLO</label>
                <label style="display:flex;gap:5px;align-items:center;font-size:12px;cursor:pointer"><input type="checkbox" id="po-enfasi" style="width:auto" checked> Enfasi (bold)</label>
            </div>
            <div style="display:flex;gap:6px;margin-top:10px;justify-content:space-between">
                <button type="button" class="btn ev-mini" id="po-ph">⏱ Inizia dal cursore</button>
                <button type="button" class="btn ev-mini" id="po-del" style="color:var(--danger)">✕ Rimuovi</button>
            </div>
        </div></div>

        <div class="card" id="pan-mus" style="display:none"><div class="card-pad">
            <h3 style="margin-bottom:8px;font-size:14px">Audio: <span id="pm-nome" class="muted" style="font-weight:500"></span></h3>
            <div class="ev-row3">
                <div><label>Inizio (s)</label><input type="number" id="pm-t" min="0" step="0.1"></div>
                <div><label>Da (s)</label><input type="number" id="pm-in" min="0" step="0.1"></div>
                <div><label>A (s)</label><input type="number" id="pm-out" min="0" step="0.1"></div>
            </div>
            <div style="margin-top:8px"><label>Volume <span id="pm-vol-v" class="muted">60%</span></label><input type="range" id="pm-vol" min="0" max="100" value="60"></div>
            <div class="ev-row2" style="margin-top:8px">
                <div><label>Fade in (s)</label><input type="number" id="pm-fi" min="0" step="0.5" value="1"></div>
                <div><label>Fade out (s)</label><input type="number" id="pm-fo" min="0" step="0.5" value="2"></div>
            </div>
            <button type="button" class="btn ev-mini" id="pm-del" style="color:var(--danger);margin-top:10px">✕ Rimuovi traccia</button>
        </div></div>
    </div>
</div>

<script>
(function () {
    'use strict';
    const LOGO_URL = {{ asset(logo_url)|json_encode|raw }};
    const KIT_FONT = {{ kit_font|json_encode|raw }} || {};
    const FONT_TITOLI = (KIT_FONT.titoli ? "'" + KIT_FONT.titoli + "'," : '') + "-apple-system,'Segoe UI',Roboto,sans-serif";
    const URL_ARCHIVIA = {{ path('app_creator_video_archivia')|json_encode|raw }};
    const CSRF = {{ csrf_token('video_archivia')|json_encode|raw }};
    const STING = {
        apertura: {{ sting_apertura ? asset(sting_apertura)|json_encode|raw : 'null' }},
        chiusura: {{ sting_chiusura ? asset(sting_chiusura)|json_encode|raw : 'null' }},
    };
    const PRESET = {
        nessuno: '', vivido: 'saturate(1.35) contrast(1.08)', caldo: 'sepia(0.25) saturate(1.3) hue-rotate(-8deg)',
        freddo: 'saturate(1.1) hue-rotate(12deg) brightness(1.03)', cinema: 'contrast(1.18) saturate(0.9) brightness(0.96)',
        bn: 'grayscale(1) contrast(1.1)', seppia: 'sepia(0.8)',
    };
    const PRESET_LABEL = { nessuno: 'Nessuno', vivido: 'Vivido', caldo: 'Caldo', freddo: 'Freddo', cinema: 'Cinema', bn: 'Bianco e nero', seppia: 'Seppia' };
    // palette Passpartour per i testi
    const PALETTE = ['#ffffff', '#f6a41f', '#ea5b24', '#1f9fd6', '#123a72', '#0a162c'];
    const PALETTE_BG = ['', '#0a162c', '#123a72', '#ea5b24', '#f6a41f', '#ffffff'];

    const $ = id => document.getElementById(id);
    const tela = $('tela'), ctx = tela.getContext('2d');
    const clips = [];   // {id,url,nome,video,durata,traccia,t,in,out,vel,vol,muto,pip,preset,lum,con,sat,kb,trans,transDur,thumb,srcNode,gain}
    const testi = [];   // {id,testo,da,a,size,x,y,colore,bg,bgColore,maiuscolo,enfasi,effIn,effOut}
    const musiche = []; // {id,nome,url,audio,t,in,out,durata,vol,fadeIn,fadeOut,srcNode,gain}
    let sel = null;     // {tipo:'clip'|'ov'|'mus', id}
    let scala = 26;     // px per secondo
    let playhead = 0;
    let inPlay = false, fermaRichiesto = false, esportando = false;
    let magnete = true, guide = false;
    let logoImg = null; (function(){ const i=new Image(); i.onload=()=>{logoImg=i; disegnaA(playhead);}; i.src=LOGO_URL; })();
    let audioCtx = null, audioDest = null;
    let ultimoBlob = null, ultimaExt = 'webm';
    let uid = 1;

    /* ================= modello ================= */
    const effDur = c => Math.max(0.1, (c.out - c.in) / c.vel);
    const fineClip = c => c.t + effDur(c);
    const durMus = m => Math.max(0.1, m.out - m.in);
    const fineMus = m => m.t + durMus(m);
    const tClip = (c, t) => c.in + (t - c.t) * c.vel;
    function durataTotale() {
        let d = 0;
        clips.forEach(c => d = Math.max(d, fineClip(c)));
        testi.forEach(o => d = Math.max(d, o.a));
        musiche.forEach(m => d = Math.max(d, fineMus(m)));
        return d;
    }
    // la clip visibile a t su una traccia è l'ultima (in ordine di inizio) che copre t
    function clipA(traccia, t) {
        const att = clips.filter(c => c.traccia === traccia && t >= c.t && t < fineClip(c));
        return att.length ? att.sort((a, b) => a.t - b.t)[att.length - 1] : null;
    }
    const fineTraccia = tr => clips.filter(c => c.traccia === tr).reduce((m, c) => Math.max(m, fineClip(c)), 0);

    /* ================= caricamento ================= */
    function aggiungiClip(file, url, nome, cb) {
        const video = document.createElement('video');
        video.src = url; video.preload = 'auto'; video.playsInline = true; video.crossOrigin = 'anonymous'; video.muted = false;
        const c = { id: uid++, url, nome, video, durata: 0, traccia: 0, t: 0,
            in: 0, out: 0, vel: 1, vol: 1, muto: false, pip: 1, preset: 'nessuno', lum: 100, con: 100, sat: 100, kb: false,
            trans: clips.length ? 'dissolvenza' : 'taglio', transDur: 0.6, thumb: null, srcNode: null, gain: null, _auto: true };
        video.addEventListener('loadedmetadata', () => {
            c.durata = video.duration; c.out = Math.round(video.duration * 10) / 10;
            // accodamento sulla traccia base SOLO ora che la durata è nota
            if (c._auto) { c.t = clips.filter(o => o !== c && o.traccia === 0).reduce((m, o) => Math.max(m, fineClip(o)), 0); c._auto = false; }
            video.currentTime = Math.min(0.15, video.duration / 2);
            video.addEventListener('seeked', function una() {
                video.removeEventListener('seeked', una);
                try {
                    const cv = document.createElement('canvas'); cv.width = 120; cv.height = 68;
                    cv.getContext('2d').drawImage(video, 0, 0, 120, 68);
                    c.thumb = cv.toDataURL('image/jpeg', 0.6);
                } catch (err) {}
                render(); disegnaA(playhead);
            }, { once: true });
            cb && cb(c);
            render();
        });
        clips.push(c);
        return c;
    }

    $('clip-file').addEventListener('change', e => {
        for (const file of e.target.files) {
            const c = aggiungiClip(file, URL.createObjectURL(file), file.name.replace(/\.[^.]+$/, ''));
            seleziona('clip', c.id);
        }
        e.target.value = ''; render();
    });

    function aggiungiMusica(url, nome, t) {
        const audio = new Audio(url); audio.crossOrigin = 'anonymous'; audio.preload = 'auto';
        const m = { id: uid++, nome, url, audio, t: t !== undefined ? t : 0, in: 0, out: 0, durata: 0,
            vol: 0.6, fadeIn: 1, fadeOut: 2, srcNode: null, gain: null };
        audio.addEventListener('loadedmetadata', () => {
            m.durata = audio.duration; m.out = m.out || Math.round(audio.duration * 10) / 10;
            render();
        });
        musiche.push(m);
        return m;
    }
    $('musica-file').addEventListener('change', e => {
        for (const file of e.target.files) {
            const m = aggiungiMusica(URL.createObjectURL(file), file.name);
            seleziona('mus', m.id);
        }
        e.target.value = ''; render();
    });

    /* ---- sting apertura/chiusura dal Media Kit ---- */
    const stingBox = $('sting-btns');
    if (STING.apertura) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn ev-mini'; b.textContent = '🎬 Sting apertura';
        b.addEventListener('click', () => {
            aggiungiClip(null, STING.apertura, 'Sting apertura', c => {
                // tutte le clip della traccia base scorrono a destra per far posto
                clips.forEach(o => { if (o !== c && o.traccia === 0) o.t += effDur(c); });
                c.t = 0; c.trans = 'taglio';
                render(); disegnaA(playhead);
            });
        });
        stingBox.appendChild(b);
    }
    if (STING.chiusura) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn ev-mini'; b.textContent = '🏁 Sting chiusura';
        b.addEventListener('click', () => {
            aggiungiClip(null, STING.chiusura, 'Sting chiusura', c => {
                c.t = fineTraccia(0) - effDur(c) <= 0 ? 0 : fineTraccia(0) - effDur(c);
                // appesa in coda alla traccia base
                c.t = Math.max(0, clips.filter(o => o !== c && o.traccia === 0).reduce((m, o) => Math.max(m, fineClip(o)), 0));
                c.trans = 'dissolvenza';
                render(); disegnaA(playhead);
            });
        });
        stingBox.appendChild(b);
    }

    /* ================= selezione e pannelli ================= */
    function seleziona(tipo, id) {
        sel = { tipo, id };
        $('pan-clip').style.display = tipo === 'clip' ? '' : 'none';
        $('pan-ov').style.display = tipo === 'ov' ? '' : 'none';
        $('pan-mus').style.display = tipo === 'mus' ? '' : 'none';
        if (tipo === 'clip') { const c = clipSel(); if (c) riempiPannelloClip(c); }
        if (tipo === 'ov') { const o = ovSel(); if (o) riempiPannelloOv(o); }
        if (tipo === 'mus') { const m = musSel(); if (m) riempiPannelloMus(m); }
        render();
    }
    const clipSel = () => clips.find(c => sel && sel.tipo === 'clip' && c.id === sel.id);
    const ovSel = () => testi.find(o => sel && sel.tipo === 'ov' && o.id === sel.id);
    const musSel = () => musiche.find(m => sel && sel.tipo === 'mus' && m.id === sel.id);

    function riempiPannelloClip(c) {
        $('pc-nome').textContent = c.nome;
        $('pc-t').value = c.t.toFixed(1); $('pc-in').value = c.in; $('pc-out').value = c.out;
        $('pc-traccia').value = String(c.traccia); $('pc-vel').value = String(c.vel); $('pc-pip').value = String(c.pip);
        $('pc-trans').value = c.trans; $('pc-transdur').value = c.transDur;
        const selP = $('pc-preset'); selP.innerHTML = '';
        Object.keys(PRESET).forEach(k => { const o = document.createElement('option'); o.value = k; o.textContent = PRESET_LABEL[k]; selP.appendChild(o); });
        selP.value = c.preset;
        $('pc-lum').value = c.lum; $('pc-con').value = c.con; $('pc-sat').value = c.sat;
        $('pc-lum-v').textContent = c.lum; $('pc-con-v').textContent = c.con; $('pc-sat-v').textContent = c.sat;
        $('pc-vol').value = Math.round((c.muto ? 0 : c.vol) * 100); $('pc-vol-v').textContent = Math.round((c.muto ? 0 : c.vol) * 100) + '%';
        $('pc-kb').checked = c.kb;
    }
    function riempiPannelloOv(o) {
        $('po-testo').value = o.testo; $('po-da').value = o.da; $('po-a').value = o.a;
        $('po-size').value = String(o.size); $('po-bg').value = o.bg;
        $('po-effin').value = o.effIn; $('po-effout').value = o.effOut;
        $('po-maiuscolo').checked = o.maiuscolo; $('po-enfasi').checked = o.enfasi;
        disegnaSwatch('po-colori', PALETTE, o.colore, v => { o.colore = v; disegnaA(playhead); });
        disegnaSwatch('po-bg-colori', PALETTE_BG, o.bgColore, v => { o.bgColore = v; disegnaA(playhead); });
    }
    function disegnaSwatch(id, colori, attivo, onPick) {
        const box = $(id); box.innerHTML = '';
        colori.forEach(col => {
            const b = document.createElement('button');
            b.type = 'button';
            b.style.background = col || 'repeating-linear-gradient(45deg,#eee 0 4px,#fff 4px 8px)';
            b.title = col || 'Nessuno';
            if (col === attivo) b.classList.add('on');
            b.addEventListener('click', () => { onPick(col); disegnaSwatch(id, colori, col, onPick); });
            box.appendChild(b);
        });
    }
    function riempiPannelloMus(m) {
        $('pm-nome').textContent = m.nome;
        $('pm-t').value = m.t.toFixed(1); $('pm-in').value = m.in; $('pm-out').value = m.out;
        $('pm-vol').value = Math.round(m.vol * 100); $('pm-vol-v').textContent = Math.round(m.vol * 100) + '%';
        $('pm-fi').value = m.fadeIn; $('pm-fo').value = m.fadeOut;
    }

    // binding pannello clip
    const bindC = (id, fn) => $(id).addEventListener('input', () => { const c = clipSel(); if (c) { fn(c, $(id)); render(); disegnaA(playhead); } });
    bindC('pc-t', (c, el) => c.t = Math.max(0, parseFloat(el.value) || 0));
    bindC('pc-in', (c, el) => c.in = Math.max(0, Math.min(parseFloat(el.value) || 0, c.out - 0.1)));
    bindC('pc-out', (c, el) => c.out = Math.min(c.durata, Math.max(parseFloat(el.value) || 0, c.in + 0.1)));
    bindC('pc-traccia', (c, el) => c.traccia = +el.value);
    bindC('pc-vel', (c, el) => c.vel = parseFloat(el.value));
    bindC('pc-pip', (c, el) => c.pip = parseFloat(el.value));
    bindC('pc-trans', (c, el) => c.trans = el.value);
    bindC('pc-transdur', (c, el) => c.transDur = Math.max(0.2, parseFloat(el.value) || 0.6));
    bindC('pc-preset', (c, el) => c.preset = el.value);
    bindC('pc-lum', (c, el) => { c.lum = +el.value; $('pc-lum-v').textContent = el.value; });
    bindC('pc-con', (c, el) => { c.con = +el.value; $('pc-con-v').textContent = el.value; });
    bindC('pc-sat', (c, el) => { c.sat = +el.value; $('pc-sat-v').textContent = el.value; });
    bindC('pc-vol', (c, el) => { c.vol = el.value / 100; c.muto = c.vol === 0; $('pc-vol-v').textContent = el.value + '%'; });
    $('pc-kb').addEventListener('change', () => { const c = clipSel(); if (c) c.kb = $('pc-kb').checked; });
    $('pc-in-ph').addEventListener('click', () => { const c = clipSel(); if (c && playhead > c.t && playhead < fineClip(c)) { c.in = Math.max(0, Math.min(tClip(c, playhead), c.out - 0.1)); riempiPannelloClip(c); render(); } });
    $('pc-out-ph').addEventListener('click', () => { const c = clipSel(); if (c && playhead > c.t && playhead < fineClip(c)) { c.out = Math.min(c.durata, Math.max(tClip(c, playhead), c.in + 0.1)); riempiPannelloClip(c); render(); } });
    $('pc-dup').addEventListener('click', () => { const c = clipSel(); if (!c) return;
        const copia = Object.assign({}, c, { id: uid++, t: fineClip(c), srcNode: null, gain: null }); clips.push(copia); seleziona('clip', copia.id); });
    $('pc-del').addEventListener('click', () => { const c = clipSel(); if (!c) return; clips.splice(clips.indexOf(c), 1); sel = null; seleziona('clip', -1); });

    // estrazione audio: l'audio della clip passa su una traccia musicale, la clip resta muta
    $('pc-estrai').addEventListener('click', () => {
        const c = clipSel(); if (!c) return;
        const m = aggiungiMusica(c.url, '🎙 ' + c.nome, c.t);
        m.in = c.in; m.out = c.out; m.vol = c.vol || 1; m.fadeIn = 0; m.fadeOut = 0;
        c.muto = true; c.vol = 0;
        riempiPannelloClip(c);
        seleziona('mus', m.id);
    });

    // binding pannello testo
    const bindO = (id, fn, ev) => $(id).addEventListener(ev || 'input', () => { const o = ovSel(); if (o) { fn(o, $(id)); render(); disegnaA(playhead); } });
    bindO('po-testo', (o, el) => o.testo = el.value);
    bindO('po-da', (o, el) => o.da = Math.max(0, parseFloat(el.value) || 0));
    bindO('po-a', (o, el) => o.a = Math.max(o.da + 0.2, parseFloat(el.value) || 0));
    bindO('po-size', (o, el) => o.size = parseFloat(el.value));
    bindO('po-bg', (o, el) => o.bg = el.value);
    bindO('po-effin', (o, el) => o.effIn = el.value);
    bindO('po-effout', (o, el) => o.effOut = el.value);
    bindO('po-maiuscolo', (o, el) => o.maiuscolo = el.checked, 'change');
    bindO('po-enfasi', (o, el) => o.enfasi = el.checked, 'change');
    $('po-ph').addEventListener('click', () => { const o = ovSel(); if (o) { const d = o.a - o.da; o.da = playhead; o.a = playhead + d; riempiPannelloOv(o); render(); } });
    $('po-del').addEventListener('click', () => { const o = ovSel(); if (!o) return; testi.splice(testi.indexOf(o), 1); sel = null; $('pan-ov').style.display = 'none'; render(); disegnaA(playhead); });
    $('btn-overlay').addEventListener('click', () => {
        const o = { id: uid++, testo: 'NUOVO TESTO', da: playhead, a: playhead + 3, size: 0.07,
            x: 0.5, y: 0.8, colore: '#ffffff', bg: '', bgColore: '#0a162c', maiuscolo: false, enfasi: true, effIn: 'fade', effOut: 'fade' };
        testi.push(o); seleziona('ov', o.id); disegnaA(playhead);
    });

    // binding pannello musica
    const bindM = (id, fn) => $(id).addEventListener('input', () => { const m = musSel(); if (m) { fn(m, $(id)); render(); } });
    bindM('pm-t', (m, el) => m.t = Math.max(0, parseFloat(el.value) || 0));
    bindM('pm-in', (m, el) => m.in = Math.max(0, Math.min(parseFloat(el.value) || 0, m.out - 0.1)));
    bindM('pm-out', (m, el) => m.out = Math.min(m.durata || 9999, Math.max(parseFloat(el.value) || 0, m.in + 0.1)));
    bindM('pm-vol', (m, el) => { m.vol = el.value / 100; $('pm-vol-v').textContent = el.value + '%'; });
    bindM('pm-fi', (m, el) => m.fadeIn = parseFloat(el.value) || 0);
    bindM('pm-fo', (m, el) => m.fadeOut = parseFloat(el.value) || 0);
    $('pm-del').addEventListener('click', () => { const m = musSel(); if (!m) return; m.audio.pause(); musiche.splice(musiche.indexOf(m), 1); sel = null; $('pan-mus').style.display = 'none'; render(); });

    // split al cursore (sulla clip selezionata, o sulla base)
    $('btn-split').addEventListener('click', () => {
        let c = clipSel();
        if (!c || playhead <= c.t + 0.15 || playhead >= fineClip(c) - 0.15) c = clipA(0, playhead);
        if (!c || playhead <= c.t + 0.15 || playhead >= fineClip(c) - 0.15) return;
        const tc = tClip(c, playhead);
        const copia = Object.assign({}, c, { id: uid++, t: playhead, in: tc, trans: 'taglio', srcNode: null, gain: null });
        c.out = tc;
        clips.push(copia);
        seleziona('clip', copia.id);
    });

    $('btn-magnete').classList.add('on');
    $('btn-magnete').addEventListener('click', () => { magnete = !magnete; $('btn-magnete').classList.toggle('on', magnete); });
    $('btn-guide').addEventListener('click', () => { guide = !guide; $('btn-guide').classList.toggle('on', guide); $('riga-eyeline').style.display = guide ? 'flex' : 'none'; disegnaA(playhead); });
    $('eyeline').addEventListener('input', () => disegnaA(playhead));

    /* ================= timeline UI ================= */
    $('zoom').addEventListener('input', () => { scala = +$('zoom').value; render(); });

    // punti di aggancio del magnete: 0, cursore, bordi di tutti i blocchi
    function puntiSnap(escludi) {
        const p = [0, playhead];
        clips.forEach(c => { if (c !== escludi) { p.push(c.t, fineClip(c)); } });
        testi.forEach(o => { if (o !== escludi) { p.push(o.da, o.a); } });
        musiche.forEach(m => { if (m !== escludi) { p.push(m.t, fineMus(m)); } });
        return p;
    }
    function snap(v, escludi) {
        if (!magnete) return Math.max(0, v);
        const soglia = 8 / scala;
        let meglio = v, dist = soglia;
        puntiSnap(escludi).forEach(p => { const d = Math.abs(v - p); if (d < dist) { dist = d; meglio = p; } });
        return Math.max(0, meglio);
    }

    function blocco(classe, left, width, selOn) {
        const d = document.createElement('div');
        d.className = 'ev-blocco ' + classe + (selOn ? ' sel' : '');
        d.style.left = left + 'px'; d.style.width = Math.max(22, width) + 'px';
        const ml = document.createElement('div'); ml.className = 'maniglia l';
        const mr = document.createElement('div'); mr.className = 'maniglia r';
        d.appendChild(ml); d.appendChild(mr);
        return { d, ml, mr };
    }

    // drag generico: move / resize sinistra / destra
    let drag = null; // {tipo, item, modo, dxT (offset in s), startX}
    function iniziaDrag(ev, tipo, item, modo) {
        ev.preventDefault(); ev.stopPropagation();
        const r = $('tl-inner').getBoundingClientRect();
        const tMouse = (ev.clientX - r.left) / scala;
        drag = { tipo, item, modo, dxT: tMouse - (tipo === 'mus' ? item.t : tipo === 'ov' ? item.da : item.t) };
    }
    document.addEventListener('mousemove', ev => {
        if (!drag) return;
        const r = $('tl-inner').getBoundingClientRect();
        const tMouse = (ev.clientX - r.left) / scala;
        const it = drag.item;
        if (drag.tipo === 'clip') {
            if (drag.modo === 'move') it.t = snap(tMouse - drag.dxT, it);
            else if (drag.modo === 'l') {
                const nuovoT = Math.min(snap(tMouse, it), fineClip(it) - 0.2);
                const delta = (nuovoT - it.t) * it.vel;
                if (it.in + delta >= 0 && it.in + delta < it.out - 0.1) { it.in += delta; it.t = nuovoT; }
            } else {
                const fine = Math.max(snap(tMouse, it), it.t + 0.2);
                it.out = Math.min(it.durata, it.in + (fine - it.t) * it.vel);
            }
            if (sel && sel.tipo === 'clip' && sel.id === it.id) riempiPannelloClip(it);
        } else if (drag.tipo === 'ov') {
            const durata = it.a - it.da;
            if (drag.modo === 'move') { it.da = snap(tMouse - drag.dxT, it); it.a = it.da + durata; }
            else if (drag.modo === 'l') it.da = Math.min(snap(tMouse, it), it.a - 0.2);
            else it.a = Math.max(snap(tMouse, it), it.da + 0.2);
            if (sel && sel.tipo === 'ov' && sel.id === it.id) riempiPannelloOv(it);
        } else if (drag.tipo === 'mus') {
            if (drag.modo === 'move') it.t = snap(tMouse - drag.dxT, it);
            else if (drag.modo === 'l') {
                const nuovoT = Math.min(snap(tMouse, it), fineMus(it) - 0.2);
                const delta = nuovoT - it.t;
                if (it.in + delta >= 0 && it.in + delta < it.out - 0.1) { it.in += delta; it.t = nuovoT; }
            } else {
                const fine = Math.max(snap(tMouse, it), it.t + 0.2);
                it.out = Math.min(it.durata || 9999, it.in + (fine - it.t));
            }
            if (sel && sel.tipo === 'mus' && sel.id === it.id) riempiPannelloMus(it);
        }
        render();
    });
    document.addEventListener('mouseup', () => { if (drag) { drag = null; disegnaA(playhead); } });

    function render() {
        const durata = Math.max(durataTotale(), 10);
        const W = Math.max(durata * scala + 60, 400);
        $('tl-inner').style.width = W + 'px';

        const ruler = $('ruler'); ruler.innerHTML = '';
        const passo = scala < 14 ? 5 : scala < 30 ? 2 : 1;
        for (let s = 0; s <= durata + passo; s += passo) {
            const d = document.createElement('div'); d.className = 'tick'; d.style.left = (s * scala) + 'px'; d.textContent = s + 's';
            ruler.appendChild(d);
        }

        // tracce video (2 = sopra, 0 = base)
        [2, 1, 0].forEach(tr => {
            const tv = $('track-v' + tr);
            tv.querySelectorAll('.ev-blocco').forEach(n => n.remove());
            clips.filter(c => c.traccia === tr).forEach(c => {
                const { d, ml, mr } = blocco('', c.t * scala, effDur(c) * scala, sel && sel.tipo === 'clip' && sel.id === c.id);
                if (c.thumb) { const im = document.createElement('img'); im.src = c.thumb; d.insertBefore(im, d.firstChild); }
                const n = document.createElement('div'); n.className = 'nome';
                n.textContent = (c.trans !== 'taglio' ? '⇄ ' : '') + c.nome + ' · ' + effDur(c).toFixed(1) + 's' + (c.vel !== 1 ? ' · ' + c.vel + '×' : '') + (c.muto ? ' · 🔇' : '');
                d.appendChild(n);
                d.addEventListener('mousedown', ev => { if (ev.target === ml || ev.target === mr) return; seleziona('clip', c.id); iniziaDrag(ev, 'clip', c, 'move'); });
                ml.addEventListener('mousedown', ev => { seleziona('clip', c.id); iniziaDrag(ev, 'clip', c, 'l'); });
                mr.addEventListener('mousedown', ev => { seleziona('clip', c.id); iniziaDrag(ev, 'clip', c, 'r'); });
                d.addEventListener('dblclick', () => { playhead = c.t + 0.01; render(); disegnaA(playhead); });
                tv.appendChild(d);
            });
        });

        // testi
        const to = $('track-testi');
        to.querySelectorAll('.ev-blocco').forEach(n => n.remove());
        testi.forEach(o => {
            const { d, ml, mr } = blocco('testo', o.da * scala, (o.a - o.da) * scala, sel && sel.tipo === 'ov' && sel.id === o.id);
            const n = document.createElement('div'); n.className = 'nome'; n.textContent = o.testo || 'testo';
            d.appendChild(n);
            d.addEventListener('mousedown', ev => { if (ev.target === ml || ev.target === mr) return; seleziona('ov', o.id); iniziaDrag(ev, 'ov', o, 'move'); });
            ml.addEventListener('mousedown', ev => { seleziona('ov', o.id); iniziaDrag(ev, 'ov', o, 'l'); });
            mr.addEventListener('mousedown', ev => { seleziona('ov', o.id); iniziaDrag(ev, 'ov', o, 'r'); });
            to.appendChild(d);
        });

        // musiche (ognuna un blocco libero)
        const tm = $('track-musica');
        tm.querySelectorAll('.ev-blocco').forEach(n => n.remove());
        musiche.forEach(m => {
            const { d, ml, mr } = blocco('musica', m.t * scala, durMus(m) * scala, sel && sel.tipo === 'mus' && sel.id === m.id);
            const n = document.createElement('div'); n.className = 'nome';
            n.textContent = '🎵 ' + m.nome + ' · ' + Math.round(m.vol * 100) + '%';
            d.appendChild(n);
            d.addEventListener('mousedown', ev => { if (ev.target === ml || ev.target === mr) return; seleziona('mus', m.id); iniziaDrag(ev, 'mus', m, 'move'); });
            ml.addEventListener('mousedown', ev => { seleziona('mus', m.id); iniziaDrag(ev, 'mus', m, 'l'); });
            mr.addEventListener('mousedown', ev => { seleziona('mus', m.id); iniziaDrag(ev, 'mus', m, 'r'); });
            tm.appendChild(d);
        });

        $('playhead').style.left = (playhead * scala) + 'px';
        $('t-tot').textContent = durataTotale().toFixed(1);
        $('t-cur').textContent = playhead.toFixed(1);
        $('stato').textContent = clips.length ? clips.length + ' clip · ' + musiche.length + ' audio · ' + durataTotale().toFixed(1) + 's' : 'Carica le clip per iniziare.';
    }

    // scrub sul righello / spazi vuoti
    let scrubbing = false;
    function scrubA(ev) {
        const r = $('tl-inner').getBoundingClientRect();
        playhead = Math.max(0, Math.min((ev.clientX - r.left) / scala, durataTotale()));
        $('playhead').style.left = (playhead * scala) + 'px';
        $('t-cur').textContent = playhead.toFixed(1);
        disegnaA(playhead);
    }
    $('timeline').addEventListener('mousedown', ev => {
        if (inPlay || drag) return;
        if (ev.target.closest('.ev-blocco')) return;
        scrubbing = true; scrubA(ev);
    });
    document.addEventListener('mousemove', ev => { if (scrubbing && !drag) scrubA(ev); });
    document.addEventListener('mouseup', () => scrubbing = false);

    /* ================= disegno frame ================= */
    function dimensioni() { const f = $('imp-formato').value; return f === '1:1' ? [1080, 1080] : f === '16:9' ? [1920, 1080] : [1080, 1920]; }
    function applicaFormato() { const [w, h] = dimensioni(); tela.width = w; tela.height = h; disegnaA(playhead); }
    $('imp-formato').addEventListener('change', applicaFormato);
    $('imp-logo-size').addEventListener('input', () => { $('logo-size-v').textContent = $('imp-logo-size').value + '%'; disegnaA(playhead); });
    $('imp-logo').addEventListener('change', () => disegnaA(playhead));

    function filtroClip(c) {
        const reg = 'brightness(' + c.lum / 100 + ') contrast(' + c.con / 100 + ') saturate(' + c.sat / 100 + ')';
        return ((PRESET[c.preset] || '') + ' ' + reg).trim();
    }

    function disegnaVideo(c, t, opz) {
        const v = c.video, W = tela.width, H = tela.height;
        if (!v.videoWidth) return;
        opz = opz || {};
        ctx.save();
        if (opz.alpha !== undefined) ctx.globalAlpha = opz.alpha;
        if (opz.clipW !== undefined) { ctx.beginPath(); ctx.rect(0, 0, opz.clipW, H); ctx.clip(); }
        ctx.filter = filtroClip(c);
        let z = opz.zoom || 1;
        if (c.kb) { const p = Math.max(0, Math.min(1, (t - c.in) / Math.max(0.1, c.out - c.in))); z *= 1 + 0.08 * p; }
        const area = c.pip < 1 ? c.pip : 1;
        const aw = W * area, ah = H * area;
        const r = Math.max(aw / v.videoWidth, ah / v.videoHeight) * z;
        const w = v.videoWidth * r, h = v.videoHeight * r;
        const cx = c.pip < 1 ? W - aw / 2 - W * 0.04 : W / 2;
        const cy = c.pip < 1 ? H * 0.04 + ah / 2 : H / 2;
        if (c.pip < 1) {
            ctx.beginPath(); ctx.roundRect(cx - aw / 2, cy - ah / 2, aw, ah, W * 0.02); ctx.clip();
        }
        ctx.translate(opz.dx || 0, 0);
        ctx.drawImage(v, cx - w / 2, cy - h / 2, w, h);
        ctx.restore();
    }

    function disegnaFrame(t) {
        const W = tela.width, H = tela.height;
        ctx.filter = 'none'; ctx.globalAlpha = 1;
        ctx.fillStyle = '#000'; ctx.fillRect(0, 0, W, H);

        // tracce dal basso verso l'alto; la transizione di una clip la fa entrare
        // sopra quello che c'è sotto (clip precedente o traccia inferiore)
        [0, 1, 2].forEach(tr => {
            const att = clips.filter(c => c.traccia === tr && t >= c.t && t < fineClip(c)).sort((a, b) => a.t - b.t);
            att.forEach(c => {
                const tc = Math.min(tClip(c, t), c.durata - 0.05);
                const dEntra = t - c.t;
                if (c.trans !== 'taglio' && dEntra < c.transDur) {
                    const p = Math.max(0, Math.min(1, dEntra / c.transDur));
                    if (c.trans === 'dissolvenza') disegnaVideo(c, tc, { alpha: p });
                    else if (c.trans === 'nero') { disegnaVideo(c, tc, {}); ctx.fillStyle = 'rgba(0,0,0,' + (1 - p) + ')'; ctx.fillRect(0, 0, W, H); }
                    else if (c.trans === 'scorri') disegnaVideo(c, tc, { dx: (1 - p) * W });
                    else if (c.trans === 'wipe') disegnaVideo(c, tc, { clipW: p * W });
                    else if (c.trans === 'zoomin') disegnaVideo(c, tc, { alpha: p, zoom: 1.25 - 0.25 * p });
                } else {
                    disegnaVideo(c, tc, {});
                }
            });
        });

        // testi con effetti di entrata/uscita
        testi.forEach(o => {
            if (t < o.da || t > o.a || !o.testo) return;
            let testo = o.maiuscolo ? o.testo.toUpperCase() : o.testo;
            const durIn = Math.min(0.5, (o.a - o.da) / 3), durOut = durIn;
            const pIn = Math.min(1, (t - o.da) / durIn), pOut = Math.min(1, (o.a - t) / durOut);
            let alpha = 1, dx = 0, dy = 0, zoom = 1;
            if (o.effIn === 'fade' && pIn < 1) alpha = pIn;
            if (o.effIn === 'su' && pIn < 1) { dy = (1 - pIn) * H * 0.06; alpha = pIn; }
            if (o.effIn === 'giu' && pIn < 1) { dy = -(1 - pIn) * H * 0.06; alpha = pIn; }
            if (o.effIn === 'zoom' && pIn < 1) { zoom = 0.6 + 0.4 * pIn; alpha = pIn; }
            if (o.effIn === 'macchina') testo = testo.slice(0, Math.max(1, Math.ceil(testo.length * Math.min(1, (t - o.da) / Math.min(1.2, (o.a - o.da) * 0.5)))));
            if (o.effOut === 'fade' && pOut < 1) alpha = Math.min(alpha, pOut);
            if (o.effOut === 'su' && pOut < 1) { dy -= (1 - pOut) * H * 0.06; alpha = Math.min(alpha, pOut); }
            if (o.effOut === 'giu' && pOut < 1) { dy += (1 - pOut) * H * 0.06; alpha = Math.min(alpha, pOut); }
            if (o.effOut === 'zoom' && pOut < 1) { zoom *= 0.6 + 0.4 * pOut; alpha = Math.min(alpha, pOut); }

            const size = Math.round(W * o.size * zoom);
            const x = W * o.x + dx, y = H * o.y + dy;
            ctx.save(); ctx.globalAlpha = Math.max(0, alpha);
            ctx.font = (o.enfasi ? '900 ' : '600 ') + size + 'px ' + FONT_TITOLI;
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            const tw = ctx.measureText(testo).width;
            if (o.bg === 'pill' && o.bgColore) {
                ctx.fillStyle = o.bgColore + 'd9';
                const px = x - tw / 2 - size * 0.5, pw = tw + size, ph = size * 1.5;
                ctx.beginPath(); ctx.roundRect(px, y - ph / 2, pw, ph, ph / 2); ctx.fill();
            } else if (o.bg === 'band' && o.bgColore) {
                ctx.fillStyle = o.bgColore + 'b0'; ctx.fillRect(0, y - size * 0.9, W, size * 1.8);
            } else {
                ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = 20;
            }
            ctx.fillStyle = o.colore;
            ctx.fillText(testo, x, y);
            ctx.restore();
            o._hit = { x, y, w: tw + size, h: size * 1.6 }; // per il drag sul video
        });

        // logo
        const pos = $('imp-logo').value;
        if (pos && logoImg) {
            const lw = W * ($('imp-logo-size').value / 100), lh = lw * logoImg.height / logoImg.width, m = W * 0.035;
            const x = pos.endsWith('r') ? W - lw - m : m;
            const y = pos.startsWith('t') ? m : H - lh - m;
            ctx.save(); ctx.globalAlpha = 0.92; ctx.drawImage(logoImg, x, y, lw, lh); ctx.restore();
        }

        // guide zone sicure IG/TikTok: SOLO in anteprima, mai in export
        if (guide && !esportando) {
            ctx.save();
            ctx.strokeStyle = 'rgba(31,159,214,.9)'; ctx.setLineDash([12, 10]); ctx.lineWidth = 3;
            // margini UI reel/tiktok: alto 10%, basso 20% (barre azioni), destro 12% (icone)
            ctx.strokeRect(W * 0.04, H * 0.10, W * 0.80, H * 0.70);
            ctx.fillStyle = 'rgba(31,159,214,.85)'; ctx.font = '600 ' + Math.round(W * 0.028) + 'px sans-serif';
            ctx.fillText('zona sicura IG/TikTok', W * 0.05, H * 0.10 - 10);
            // linea occhi (modificabile)
            const ey = H * ($('eyeline').value / 100);
            ctx.strokeStyle = 'rgba(246,164,31,.95)'; ctx.setLineDash([6, 8]); ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(0, ey); ctx.lineTo(W, ey); ctx.stroke();
            ctx.fillStyle = 'rgba(246,164,31,.95)';
            ctx.fillText('linea occhi', 12, ey - 8);
            ctx.restore();
        }
    }

    // drag dei testi direttamente sul video
    let dragTesto = null;
    function coordCanvas(ev) {
        const r = tela.getBoundingClientRect();
        return [ (ev.clientX - r.left) * tela.width / r.width, (ev.clientY - r.top) * tela.height / r.height ];
    }
    tela.addEventListener('mousedown', ev => {
        if (inPlay) return;
        const [mx, my] = coordCanvas(ev);
        const visibili = testi.filter(o => playhead >= o.da && playhead <= o.a && o._hit);
        for (let i = visibili.length - 1; i >= 0; i--) {
            const o = visibili[i], h = o._hit;
            if (Math.abs(mx - h.x) < h.w / 2 && Math.abs(my - h.y) < h.h / 2) {
                dragTesto = o; seleziona('ov', o.id);
                ev.preventDefault();
                return;
            }
        }
    });
    document.addEventListener('mousemove', ev => {
        if (!dragTesto) return;
        const [mx, my] = coordCanvas(ev);
        dragTesto.x = Math.max(0.05, Math.min(0.95, mx / tela.width));
        dragTesto.y = Math.max(0.05, Math.min(0.95, my / tela.height));
        disegnaA(playhead);
    });
    document.addEventListener('mouseup', () => dragTesto = null);

    // disegno asincrono di un singolo frame (scrub): seeka i video coinvolti
    let disegnoTok = 0;
    function disegnaA(t) {
        const tok = ++disegnoTok;
        const attivi = clips.filter(c => t >= c.t && t < fineClip(c));
        if (!attivi.length) { disegnaFrame(t); return; }
        let pend = 0;
        attivi.forEach(c => {
            const v = c.video, tc = Math.min(tClip(c, t), c.durata - 0.05);
            if (v.readyState >= 1 && Math.abs(v.currentTime - tc) > 0.05) {
                pend++;
                v.addEventListener('seeked', function una() { v.removeEventListener('seeked', una); if (tok === disegnoTok && --pend <= 0) disegnaFrame(t); }, { once: true });
                v.currentTime = tc;
            }
        });
        if (pend === 0) disegnaFrame(t);
    }

    /* ================= audio ================= */
    function setupAudio() {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        audioDest = audioDest || audioCtx.createMediaStreamDestination();
        // una MediaElementSource PER ELEMENTO, creata una sola volta
        clips.forEach(c => {
            if (!c.srcNode) {
                c.srcNode = audioCtx.createMediaElementSource(c.video);
                c.gain = audioCtx.createGain(); c.gain.gain.value = 0;
                c.srcNode.connect(c.gain); c.gain.connect(audioCtx.destination); c.gain.connect(audioDest);
            }
        });
        musiche.forEach(m => {
            if (!m.srcNode) {
                m.srcNode = audioCtx.createMediaElementSource(m.audio);
                m.gain = audioCtx.createGain(); m.gain.gain.value = 0;
                m.srcNode.connect(m.gain); m.gain.connect(audioCtx.destination); m.gain.connect(audioDest);
            }
        });
        return audioCtx.resume();
    }

    function volumeMusica(m, t) {
        if (t < m.t || t >= fineMus(m)) return 0;
        let v = m.vol;
        const dentro = t - m.t, resta = fineMus(m) - t;
        if (m.fadeIn > 0) v *= Math.min(1, dentro / m.fadeIn);
        if (m.fadeOut > 0) v *= Math.max(0, Math.min(1, resta / m.fadeOut));
        return Math.max(0, v);
    }

    /* ================= motore di riproduzione ================= */
    async function riproduci(daT, onFine) {
        if (!clips.length && !musiche.length) return;
        await setupAudio();
        inPlay = true; fermaRichiesto = false;
        $('btn-stop').disabled = false; $('btn-play').disabled = true;
        const durata = durataTotale();
        const t0clock = performance.now() / 1000 - daT;
        const senzaMusica = esportando && $('chk-no-musica').checked;
        // in «senza musica» restano le voci estratte? No: TUTTE le tracce musicali
        // sono escluse; l'audio originale delle clip non mute resta.

        // con la scheda in background requestAnimationFrame si ferma: il timer
        // tiene vivo l'export anche se l'utente cambia scheda a metà
        const pianifica = fn => document.hidden ? setTimeout(fn, 33) : requestAnimationFrame(fn);
        await new Promise(res => {
            const loop = () => {
                const t = performance.now() / 1000 - t0clock;
                if (fermaRichiesto || t >= durata) { res(); return; }
                playhead = t;
                clips.forEach(c => {
                    const v = c.video;
                    const attivo = t >= c.t && t < fineClip(c);
                    const prossimo = t >= c.t - 0.4 && t < c.t; // pre-roll
                    if (attivo || prossimo) {
                        const tc = Math.min(tClip(c, Math.max(t, c.t)), c.durata - 0.05);
                        if (v.paused) { v.playbackRate = c.vel; v.currentTime = tc; v.play().catch(() => {}); }
                        else if (Math.abs(v.currentTime - tc) > 0.12) { v.currentTime = tc; }
                        if (c.gain) {
                            let g = (attivo && !c.muto) ? c.vol : 0;
                            // dissolvenza audio in ingresso quando la clip ha una transizione
                            if (g > 0 && c.trans !== 'taglio' && t < c.t + c.transDur) g *= (t - c.t) / c.transDur;
                            c.gain.gain.setTargetAtTime(g, audioCtx.currentTime, 0.03);
                        }
                    } else if (!v.paused) { v.pause(); if (c.gain) c.gain.gain.value = 0; }
                });
                musiche.forEach(m => {
                    const attivo = t >= m.t && t < fineMus(m);
                    const prossimo = t >= m.t - 0.4 && t < m.t;
                    if ((attivo || prossimo) && !senzaMusica) {
                        const tm = Math.min(m.in + Math.max(0, t - m.t), (m.durata || 9999) - 0.05);
                        if (m.audio.paused) { m.audio.currentTime = tm; m.audio.play().catch(() => {}); }
                        else if (Math.abs(m.audio.currentTime - tm) > 0.25) { m.audio.currentTime = tm; }
                        if (m.gain) m.gain.gain.setTargetAtTime(attivo ? volumeMusica(m, t) : 0, audioCtx.currentTime, 0.05);
                    } else if (!m.audio.paused) { m.audio.pause(); if (m.gain) m.gain.gain.value = 0; }
                });
                disegnaFrame(t);
                $('playhead').style.left = (t * scala) + 'px';
                $('t-cur').textContent = t.toFixed(1);
                pianifica(loop);
            };
            pianifica(loop);
        });

        clips.forEach(c => { c.video.pause(); if (c.gain) c.gain.gain.value = 0; });
        musiche.forEach(m => { m.audio.pause(); if (m.gain) m.gain.gain.value = 0; });
        inPlay = false; $('btn-stop').disabled = true; $('btn-play').disabled = false;
        onFine && onFine();
    }

    $('btn-play').addEventListener('click', () => {
        if ((!clips.length && !musiche.length) || inPlay) return;
        applicaFormato();
        const da = playhead >= durataTotale() - 0.2 ? 0 : playhead;
        riproduci(da, () => $('stato').textContent = 'Riproduzione terminata.');
    });
    $('btn-stop').addEventListener('click', () => fermaRichiesto = true);

    /* ================= export ================= */
    $('btn-esporta').addEventListener('click', async () => {
        if (!clips.length || inPlay) return;
        applicaFormato();
        await setupAudio();
        esportando = true;
        const mime = MediaRecorder.isTypeSupported('video/mp4') ? 'video/mp4'
            : MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus') ? 'video/webm;codecs=vp9,opus' : 'video/webm';
        ultimaExt = mime.indexOf('mp4') !== -1 ? 'mp4' : 'webm';
        const flusso = tela.captureStream(30);
        audioDest.stream.getAudioTracks().forEach(tr => flusso.addTrack(tr));
        const rec = new MediaRecorder(flusso, { mimeType: mime, videoBitsPerSecond: 8_000_000 });
        const pezzi = [];
        rec.ondataavailable = e => { if (e.data.size) pezzi.push(e.data); };
        rec.onstop = () => {
            esportando = false;
            ultimoBlob = new Blob(pezzi, { type: mime });
            const url = URL.createObjectURL(ultimoBlob);
            $('risultato').style.display = 'block';
            $('video-finale').src = url;
            $('btn-scarica').href = url;
            $('btn-scarica').download = ($('imp-nome').value.trim() || 'video') + '.' + ultimaExt;
            $('stato').textContent = 'Export completato (' + ultimaExt.toUpperCase() + ', ' + (ultimoBlob.size / 1048576).toFixed(1) + ' MB' + ($('chk-no-musica').checked ? ', senza musica' : '') + ').';
        };
        $('stato').textContent = 'Export in corso… (tempo reale: ' + durataTotale().toFixed(0) + 's)';
        rec.start();
        riproduci(0, () => rec.stop());
    });

    $('btn-archivia').addEventListener('click', async () => {
        if (!ultimoBlob) return;
        const b = $('btn-archivia'); b.disabled = true; b.textContent = '… archivio';
        try {
            const fd = new FormData();
            const nome = ($('imp-nome').value.trim() || 'video');
            fd.append('titolo', nome);
            // estensione ESPLICITA: i blob del recorder non si lasciano sniffare
            fd.append('file', new File([ultimoBlob], nome + '.' + ultimaExt, { type: ultimoBlob.type }));
            const r = await fetch(URL_ARCHIVIA, { method: 'POST', headers: { 'X-CSRF-Token': CSRF }, body: fd });
            const dati = await r.json();
            if (dati.ok) { b.textContent = '✓ In archivio'; window.open(dati.url, '_blank'); return; }
            alert(dati.error || 'Archiviazione non riuscita.');
        } catch (e) { alert('Archiviazione non riuscita.'); }
        b.disabled = false; b.textContent = '🗂 Salva in Archivio Digital';
    });

    applicaFormato();
    render();
})();
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set famiglie = [] %}
    {% if kit_font.titoli|default('') %}{% set famiglie = famiglie|merge(['family=' ~ kit_font.titoli|replace({' ': '+'}) ~ ':wght@400;600;700;900']) %}{% endif %}
    {% if kit_font.testo|default('') and kit_font.testo|default('') != kit_font.titoli|default('') %}{% set famiglie = famiglie|merge(['family=' ~ kit_font.testo|replace({' ': '+'}) ~ ':wght@400;600;700;900']) %}{% endif %}
    {% if famiglie|length %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ famiglie|join('&') }}&display=swap">
    {% endif %}
{% endblock %}
