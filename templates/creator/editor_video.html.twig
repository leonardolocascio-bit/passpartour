        pausa: '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="4" width="4.5" height="16" rx="1"/><rect x="14.5" y="4" width="4.5" height="16" rx="1"/></svg>',
        inizio: '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"/><rect x="4" y="4" width="2.5" height="16" rx="1"/></svg>',
        scarica: svgI('<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>'),
        occhio: svgI('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'),
        occhioNo: svgI('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/><line x1="3" y1="3" x2="21" y2="21"/>'),
        vol: svgI('<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/>'),
        volNo: svgI('<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="15" y1="9" x2="21" y2="15"/><line x1="21" y1="9" x2="15" y2="15"/>'),
    };
    document.querySelectorAll('[data-ico]').forEach(el => { const i = ICO[el.dataset.ico]; if (!i) return;
        el.tagName === 'SPAN' ? el.innerHTML = i : el.insertAdjacentHTML('afterbegin', i); });

    // filtri colore in stile CapCut (combinazioni di filtri CSS canvas)
    const PRESET = {
        nessuno: '', vivido: 'saturate(1.35) contrast(1.08)', caldo: 'sepia(0.25) saturate(1.3) hue-rotate(-8deg)',
        freddo: 'saturate(1.1) hue-rotate(12deg) brightness(1.03)', cinema: 'contrast(1.18) saturate(0.9) brightness(0.96)',
        hollywood: 'contrast(1.12) saturate(1.18) sepia(0.12) brightness(1.02)',
        fuji: 'saturate(1.15) hue-rotate(-5deg) contrast(1.05) brightness(1.04)',
        autunno: 'sepia(0.35) saturate(1.25) hue-rotate(-14deg)',
        crema: 'sepia(0.18) brightness(1.08) contrast(0.95) saturate(0.9)',
        notte: 'brightness(0.85) saturate(0.8) hue-rotate(18deg) contrast(1.1)',
        bn: 'grayscale(1) contrast(1.1)', seppia: 'sepia(0.8)',
    };
    const PRESET_LABEL = { nessuno: 'Nessuno', vivido: 'Vivido', caldo: 'Caldo', freddo: 'Freddo', cinema: 'Cinema',
        hollywood: 'Hollywood', fuji: 'Fuji', autunno: 'Autunno', crema: 'Crema', notte: 'Notte', bn: 'Bianco e nero', seppia: 'Seppia' };
    const TRANS = { taglio: ['✂', 'Taglio'], dissolvenza: ['◐', 'Dissolvenza'], nero: ['⬛', 'Al nero'],
        flashbianco: ['⚡', 'Flash bianco'], sfocata: ['🌫', 'Sfocata'], scorri: ['➡', 'Scorri'],
        su: ['⬆', 'Dal basso'], giu: ['⬇', "Dall'alto"], wipe: ['▥', 'Wipe'], cerchio: ['◯', 'Cerchio'],
        dividi: ['⬌', 'Dividi'], zoomin: ['🔍', 'Zoom in'] };
    const EFFETTI = { '': ['∅', 'Nessuno'], vignetta: ['🌓', 'Vignetta'], grana: ['🎞', 'Grana'],
        sfocatura: ['🌫', 'Sfocatura'], glitch: ['📺', 'Glitch'], scossa: ['💥', 'Scossa'],
        impulso: ['🫀', 'Impulso'], cromatico: ['🌈', 'Cromatico'] };
    // palette Passpartour per i testi
    const PALETTE = ['#ffffff', '#f6a41f', '#ea5b24', '#1f9fd6', '#123a72', '#0a162c'];
    const PALETTE_BG = ['', '#0a162c', '#123a72', '#ea5b24', '#f6a41f', '#ffffff'];
    // stili di testo pronti (alla Canva)
    const STILI_TESTO = {
        'Titolo':      { size: 0.095, colore: '#ffffff', bg: '', maiuscolo: true, enfasi: true, contorno: false, ombra: true, font: 'titoli', effIn: 'zoom' },
        'Sottotitolo': { size: 0.07, colore: '#f6a41f', bg: '', maiuscolo: false, enfasi: true, contorno: false, ombra: true, font: 'titoli', effIn: 'fade' },
        'Caption':     { size: 0.045, colore: '#ffffff', bg: 'pill', bgColore: '#0a162c', maiuscolo: false, enfasi: false, contorno: false, ombra: false, font: 'testo', effIn: 'su' },
        'CTA':         { size: 0.045, colore: '#ffffff', bg: 'pill', bgColore: '#ea5b24', maiuscolo: true, enfasi: true, contorno: false, ombra: false, font: 'titoli', effIn: 'zoom' },
        'Impatto':     { size: 0.12, colore: '#f6a41f', bg: '', maiuscolo: true, enfasi: true, contorno: true, ombra: false, font: 'titoli', effIn: 'macchina' },
    };

    const $ = id => document.getElementById(id);
    const tela = $('tela'), ctx = tela.getContext('2d');
    const clips = [];    // + chromaOn/chromaCol/chromaTol/chromaMorb/ritaglio rispetto al v3
    const testi = [];
    const grafiche = [];
    const musiche = [];
    const binMedia = [], binAudio = []; // cestelli: {url,nome,thumb,durata}
    let sel = null;
    let scala = 26;
    let playhead = 0;
    let inPlay = false, fermaRichiesto = false, esportando = false;
    let magnete = true, guide = false, pipetta = false;
    const trackVis = { 0: true, 1: true, 2: true };
    let muteMus = false;
    let logoImg = null; (function(){ const i=new Image(); i.onload=()=>{logoImg=i; disegnaA(playhead);}; i.src=LOGO_URL; })();
    let audioCtx = null, audioDest = null;
    let ultimoBlob = null, ultimaExt = 'webm';
    let uid = 1;
    // registro dei media per id: sopravvive alle cancellazioni, così annulla/ripeti
    // riaggancia gli stessi elementi <video>/<audio> (e le loro MediaElementSource)
    const registro = new Map();

    /* ================= libreria: rail + pannelli ================= */
    document.querySelectorAll('#rail button').forEach(b => {
        b.addEventListener('click', () => {
            document.querySelectorAll('#rail button').forEach(x => x.classList.toggle('on', x === b));
            document.querySelectorAll('.ev-lib [data-pane]').forEach(p => p.hidden = p.dataset.pane !== b.dataset.lib);
        });
    });

    /* ================= modello ================= */
    const effDur = c => Math.max(0.1, (c.out - c.in) / c.vel);
    const fineClip = c => c.t + effDur(c);
    const durMus = m => Math.max(0.1, m.out - m.in);
    const fineMus = m => m.t + durMus(m);
    const tClip = (c, t) => c.in + (t - c.t) * c.vel;
    function durataTotale() {
        let d = 0;
        clips.forEach(c => d = Math.max(d, fineClip(c)));
        testi.forEach(o => d = Math.max(d, o.a));
        grafiche.forEach(g => d = Math.max(d, g.a));
        musiche.forEach(m => d = Math.max(d, fineMus(m)));
        return d;
    }
    function clipA(traccia, t) {
        const att = clips.filter(c => c.traccia === traccia && t >= c.t && t < fineClip(c));
        return att.length ? att.sort((a, b) => a.t - b.t)[att.length - 1] : null;
    }

    /* ================= annulla / ripeti ================= */
    const storia = [], futuro = [];
    let salvaChiave = '', salvaQuando = 0;
    const CAMPI_CLIP = ['id','url','nome','durata','traccia','t','in','out','vel','vol','muto','pip','preset','effetto','lum','con','sat','kb','trans','transDur','fit','scalaZ','px','py','rot','flip','opa','chromaOn','chromaCol','chromaTol','chromaMorb','ritaglio'];
    const CAMPI_TESTO = ['id','testo','da','a','size','x','y','colore','bg','bgColore','maiuscolo','enfasi','contorno','ombra','font','effIn','effOut','opa'];
    const CAMPI_GRAF = ['id','url','nome','da','a','x','y','scala','rot','opa'];
    const CAMPI_MUS = ['id','nome','url','t','in','out','durata','vol','fadeIn','fadeOut','duck'];
    const estrai = (o, campi) => { const r = {}; campi.forEach(k => r[k] = o[k]); return r; };
    const fotografa = () => ({
        clips: clips.map(c => estrai(c, CAMPI_CLIP)),
        testi: testi.map(o => estrai(o, CAMPI_TESTO)),
        grafiche: grafiche.map(g => estrai(g, CAMPI_GRAF)),
        musiche: musiche.map(m => estrai(m, CAMPI_MUS)),
    });
    function salvaStato(chiave) {
        const ora = Date.now();
        if (chiave && chiave === salvaChiave && ora - salvaQuando < 800) { salvaQuando = ora; return; }
        salvaChiave = chiave || ''; salvaQuando = ora;
        storia.push(fotografa());
        if (storia.length > 60) storia.shift();
        futuro.length = 0;
        aggiornaUndo();
    }
    function applicaStato(s) {
        [ [clips, s.clips], [grafiche, s.grafiche], [musiche, s.musiche] ].forEach(([arr, snap]) => {
            arr.length = 0;
            snap.forEach(sc => { const vivo = registro.get(sc.id); if (vivo) { Object.assign(vivo, sc); arr.push(vivo); } });
        });
        testi.length = 0;
        s.testi.forEach(st => testi.push(Object.assign({}, st)));
        musiche.forEach(m => m.audio.pause());
        deseleziona();
        render(); disegnaA(playhead);
    }
    function annulla() { if (!storia.length) return; futuro.push(fotografa()); applicaStato(storia.pop()); aggiornaUndo(); }
    function ripeti() { if (!futuro.length) return; storia.push(fotografa()); applicaStato(futuro.pop()); aggiornaUndo(); }
    function aggiornaUndo() { $('btn-undo').disabled = !storia.length; $('btn-redo').disabled = !futuro.length; }
    $('btn-undo').addEventListener('click', annulla);
    $('btn-redo').addEventListener('click', ripeti);

    /* ================= caricamento ================= */
    function aggiungiClip(file, url, nome, cb) {
        const video = document.createElement('video');
        video.src = url; video.preload = 'auto'; video.playsInline = true; video.crossOrigin = 'anonymous'; video.muted = false;
        const c = { id: uid++, url, nome, video, durata: 0, traccia: 0, t: 0,
            in: 0, out: 0, vel: 1, vol: 1, muto: false, pip: 1, preset: 'nessuno', effetto: '', lum: 100, con: 100, sat: 100, kb: false,
            trans: clips.length ? 'dissolvenza' : 'taglio', transDur: 0.6,
            fit: 'cover', scalaZ: 100, px: 0, py: 0, rot: 0, flip: false, opa: 100,
            chromaOn: false, chromaCol: '#00b140', chromaTol: 40, chromaMorb: 25, ritaglio: false,
            thumb: null, srcNode: null, gain: null, _auto: true };
        video.addEventListener('loadedmetadata', () => {
            c.durata = video.duration;
            if (!c.out) c.out = Math.round(video.duration * 10) / 10; // un clone ha già i suoi tagli
            piazzaAuto();
            video.currentTime = Math.min(0.15, video.duration / 2);
            video.addEventListener('seeked', function una() {
                video.removeEventListener('seeked', una);
                try {
                    const cv = document.createElement('canvas'); cv.width = 120; cv.height = 68;
                    cv.getContext('2d').drawImage(video, 0, 0, 120, 68);
                    c.thumb = cv.toDataURL('image/jpeg', 0.6);
                } catch (err) {}
                if (c._asset) { c._asset.thumb = c.thumb; c._asset.durata = c.durata; disegnaBin(); }
                render(); disegnaA(playhead); disegnaGalFiltri();
            }, { once: true });
            cb && cb(c);
            render();
        });
        clips.push(c);
        registro.set(c.id, c);
        return c;
    }

    // accodamento in ordine di aggiunta: una clip _auto si piazza solo quando
    // TUTTE le precedenti hanno la durata (i metadata arrivano in ordine sparso)
    function piazzaAuto() {
        let mosso = true;
        while (mosso) {
            mosso = false;
            for (const c of clips) {
                if (!c._auto || !c.durata) continue;
                if (clips.slice(0, clips.indexOf(c)).some(o => o._auto)) continue; // rispetta l'ordine
                const altri = clips.filter(o => o !== c && o.traccia === 0 && !o._auto);
                if (altri.some(o => !o.durata)) continue;
                c.t = altri.reduce((m, o) => Math.max(m, fineClip(o)), 0);
                c._auto = false;
                mosso = true;
            }
        }
    }

    // clona una clip su un NUOVO elemento video (mai condividere l'elemento:
    // due clip sullo stesso <video> si rubano il seek e la MediaElementSource)
    function clonaClip(c, campi) {
        const n = aggiungiClip(null, c.url, c.nome);
        n._auto = false;
        CAMPI_CLIP.forEach(k => { if (k !== 'id' && k !== 'url' && k !== 'nome') n[k] = c[k]; });
        Object.assign(n, campi || {});
        n.thumb = c.thumb;
        return n;
    }

    $('clip-file').addEventListener('change', e => {
        salvaStato();
        for (const file of e.target.files) {
            const c = aggiungiClip(file, URL.createObjectURL(file), file.name.replace(/\.[^.]+$/, ''));
            c._asset = { url: c.url, nome: c.nome, thumb: null, durata: 0 };
            binMedia.push(c._asset);
            seleziona('clip', c.id);
        }
        e.target.value = ''; render(); disegnaBin();
    });

    function aggiungiMusica(url, nome, t) {
        const audio = new Audio(url); audio.crossOrigin = 'anonymous'; audio.preload = 'auto';
        const m = { id: uid++, nome, url, audio, t: t !== undefined ? t : 0, in: 0, out: 0, durata: 0,
            vol: 0.6, fadeIn: 1, fadeOut: 2, duck: false, wave: null, srcNode: null, gain: null };
        audio.addEventListener('loadedmetadata', () => {
            m.durata = audio.duration; m.out = m.out || Math.round(audio.duration * 10) / 10;
            if (m._asset) { m._asset.durata = m.durata; disegnaBin(); }
            render();
        });
        musiche.push(m);
        registro.set(m.id, m);
        generaWave(m);
        return m;
    }
    $('musica-file').addEventListener('change', e => {
        salvaStato();
        for (const file of e.target.files) {
            const m = aggiungiMusica(URL.createObjectURL(file), file.name);
            m._asset = { url: m.url, nome: m.nome, durata: 0 };
            binAudio.push(m._asset);
            seleziona('mus', m.id);
        }
        e.target.value = ''; render(); disegnaBin();
    });

    // cestelli: clic = accoda; drag sulla timeline = scegli traccia e punto
    function disegnaBin() {
        const bm = $('bin-media'); bm.innerHTML = '';
        binMedia.forEach((a, idx) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'ev-card'; b.draggable = true;
            b.innerHTML = '<span class="anteprima">' + (a.thumb ? '<img src="' + a.thumb + '" draggable="false">' : ICO.film)
                + (a.durata ? '<span class="durata">' + a.durata.toFixed(1) + 's</span>' : '') + '</span>'
                + '<span class="etich">' + a.nome.replace(/</g, '&lt;') + '</span>';
            b.title = 'Trascina su una traccia, o clic per accodare';
            b.addEventListener('click', () => { salvaStato(); const c = aggiungiClip(null, a.url, a.nome); c.thumb = a.thumb; seleziona('clip', c.id); });
            b.addEventListener('dragstart', ev => {
                ev.dataTransfer.setData('application/x-ev', JSON.stringify({ tipo: 'media', idx }));
                ev.dataTransfer.effectAllowed = 'copy';
            });
            bm.appendChild(b);
        });
        const ba = $('bin-audio'); ba.innerHTML = '';
        binAudio.forEach((a, idx) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'ev-card'; b.draggable = true;
            b.innerHTML = '<span class="etich" style="padding:8px 6px">🎵 ' + a.nome.replace(/</g, '&lt;')
                + (a.durata ? ' · ' + a.durata.toFixed(0) + 's' : '') + '</span>';
            b.title = 'Trascina sulla traccia Musica, o clic per aggiungere al cursore';
            b.addEventListener('click', () => { salvaStato(); const m = aggiungiMusica(a.url, a.nome, Math.round(playhead * 10) / 10); seleziona('mus', m.id); });
            b.addEventListener('dragstart', ev => {
                ev.dataTransfer.setData('application/x-ev', JSON.stringify({ tipo: 'audio', idx }));
                ev.dataTransfer.effectAllowed = 'copy';
            });
            ba.appendChild(b);
        });
    }

    // drop dal cestello sulla timeline: la traccia la decide la riga su cui molli
    function tracciaDaY(y) {
        for (const tr of [2, 1, 0]) {
            const r = $('track-v' + tr).getBoundingClientRect();
            if (y >= r.top && y <= r.bottom) return tr;
        }
        return null;
    }
    const tlInner = $('tl-inner');
    tlInner.addEventListener('dragover', ev => {
        if ([...ev.dataTransfer.types].includes('application/x-ev')) { ev.preventDefault(); ev.dataTransfer.dropEffect = 'copy'; }
    });
    tlInner.addEventListener('drop', ev => {
        const grezzo = ev.dataTransfer.getData('application/x-ev'); if (!grezzo) return;
        ev.preventDefault();
        const { tipo, idx } = JSON.parse(grezzo);
        const r = tlInner.getBoundingClientRect();
        const t = Math.round(snap(Math.max(0, (ev.clientX - r.left) / scala), null) * 10) / 10;
        if (tipo === 'media') {
            const a = binMedia[idx]; if (!a) return;
            const tr = tracciaDaY(ev.clientY);
            salvaStato();
            const c = aggiungiClip(null, a.url, a.nome);
            c._auto = false; c.t = t; c.traccia = tr === null ? 0 : tr; c.thumb = a.thumb;
            if (c.traccia > 0) c.trans = 'taglio'; // i livelli sopra entrano secchi
            seleziona('clip', c.id);
        } else {
            const a = binAudio[idx]; if (!a) return;
            salvaStato();
            const m = aggiungiMusica(a.url, a.nome, t);
            seleziona('mus', m.id);
        }
    });

    // forma d'onda del blocco musica (decodifica fuori dal grafo audio live)
    async function generaWave(m) {
        try {
            const buf = await (await fetch(m.url)).arrayBuffer();
            const dec = new OfflineAudioContext(1, 44100, 44100);
            const audioBuf = await dec.decodeAudioData(buf);
            const dati = audioBuf.getChannelData(0);
            const cv = document.createElement('canvas'); cv.width = 600; cv.height = 36;
            const g = cv.getContext('2d');
            g.fillStyle = 'rgba(255,255,255,.55)';
            const passo = Math.max(1, Math.floor(dati.length / 600));
            for (let x = 0; x < 600; x++) {
                let max = 0;
                for (let i = x * passo; i < (x + 1) * passo && i < dati.length; i += 20) max = Math.max(max, Math.abs(dati[i]));
                const h = Math.max(1, max * 34);
                g.fillRect(x, 18 - h / 2, 1, h);
            }
            m.wave = cv.toDataURL();
            render();
        } catch (err) { /* contenitore non decodificabile: nessuna onda */ }
    }

    /* ---- grafiche: immagini caricate o icone del Media Kit ---- */
    function aggiungiGrafica(url, nome) {
