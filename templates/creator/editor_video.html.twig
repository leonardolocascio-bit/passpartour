            + (s.bg === 'pill' ? 'background:' + s.bgColore + ';border-radius:999px;padding:3px 10px;' : '')
            + (s.enfasi ? 'font-weight:900;' : 'font-weight:500;')
            + (s.contorno ? '-webkit-text-stroke:1px #0a162c;' : '')
            + (s.ombra ? 'text-shadow:0 2px 6px rgba(0,0,0,.6);' : '')
            + 'font-size:' + Math.round(70 * s.size / 0.07) + '%;';
        b.innerHTML = '<span style="display:inline-block;' + stile + '">' + (s.maiuscolo ? nome.toUpperCase() : nome) + '</span>';
        b.title = 'Aggiungi un testo «' + nome + '» al cursore';
        b.addEventListener('click', () => {
            salvaStato();
            const t0 = Math.round(playhead * 10) / 10;
            const o = Object.assign({ id: uid++, testo: nome === 'CTA' ? 'PRENOTA ORA' : 'NUOVO TESTO',
                da: t0, a: t0 + 3, x: 0.5, y: 0.8, bgColore: '#0a162c', effOut: 'fade', opa: 100 }, s);
            testi.push(o); seleziona('ov', o.id); disegnaA(playhead);
        });
