    $('po-ph').addEventListener('click', () => { const o = ovSel(); if (o) { salvaStato(); const d = o.a - o.da; o.da = playhead; o.a = playhead + d; riempiPannelloOv(o); render(); } });
    $('po-dup').addEventListener('click', () => { const o = ovSel(); if (!o) return; salvaStato();
