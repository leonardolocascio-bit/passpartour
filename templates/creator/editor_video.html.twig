{% extends 'app.html.twig' %}

{% block title %}Editor Video · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Editor Video{% endblock %}

{% block main %}
<p class="muted" style="margin:0 0 14px;max-width:820px">
    Montaggio semplice, tutto nel browser: carica le clip, tagliale, scegli preset colore e dissolvenze,
    aggiungi titolo e logo (dal Media Kit). L'export salva il file e lo può archiviare in Archivio Digital.
</p>

<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,420px);gap:18px;align-items:start">
    {# ---- colonna sinistra: clip e impostazioni ---- #}
    <div style="display:grid;gap:16px">
        <div class="card"><div class="card-pad">
            <h3 style="margin-bottom:10px">Clip</h3>
            <input type="file" id="clip-file" accept="video/*" multiple style="font-size:13px">
            <div id="clip-lista" style="display:grid;gap:10px;margin-top:12px"></div>
        </div></div>

        <div class="card"><div class="card-pad">
            <h3 style="margin-bottom:10px">Impostazioni</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div>
                    <label>Formato</label>
                    <select id="imp-formato">
                        <option value="9:16">Reel / Story 9:16 (1080×1920)</option>
                        <option value="1:1">Quadrato 1:1 (1080×1080)</option>
                        <option value="16:9">Orizzontale 16:9 (1920×1080)</option>
                    </select>
                </div>
                <div>
                    <label>Titolo video <span class="muted" style="font-weight:400">(per l'archivio)</span></label>
                    <input type="text" id="imp-nome" placeholder="es. Reel Maldive inverno">
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
                <div>
                    <label>Titolo in sovrimpressione <span class="muted" style="font-weight:400">(primi 3s)</span></label>
                    <input type="text" id="imp-titolo" placeholder="es. MALDIVE DA SOGNO">
                </div>
                <div>
                    <label>Sottotitolo</label>
                    <input type="text" id="imp-sottotitolo" placeholder="es. 7 notti in overwater · da €1.990">
                </div>
            </div>
            <div style="display:flex;gap:18px;margin-top:12px;flex-wrap:wrap">
                <label style="display:flex;gap:8px;align-items:center;font-weight:500;cursor:pointer">
                    <input type="checkbox" id="imp-logo" checked style="width:auto"> Logo Passpartour (Media Kit)
                </label>
                <label style="display:flex;gap:8px;align-items:center;font-weight:500;cursor:pointer">
                    <input type="checkbox" id="imp-dissolvenze" checked style="width:auto"> Dissolvenze (apertura, tra le clip, chiusura)
                </label>
            </div>
        </div></div>
    </div>

    {# ---- colonna destra: anteprima ed export ---- #}
    <div class="card"><div class="card-pad" style="text-align:center">
        <canvas id="tela" style="width:100%;max-height:60vh;background:#0a162c;border-radius:10px"></canvas>
        <div style="display:flex;gap:8px;justify-content:center;margin-top:12px;flex-wrap:wrap">
            <button type="button" class="btn" id="btn-anteprima">▶ Anteprima</button>
            <button type="button" class="btn" id="btn-stop" disabled>⏹ Stop</button>
            <button type="button" class="btn btn-primary" id="btn-esporta">⬇ Esporta video</button>
        </div>
        <div id="stato" class="muted" style="font-size:12px;margin-top:8px">Carica almeno una clip per iniziare.</div>
        <div id="risultato" style="margin-top:10px;display:none">
            <video id="video-finale" controls style="width:100%;border-radius:10px"></video>
            <div style="display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap">
                <a class="btn" id="btn-scarica" download>⬇ Scarica</a>
                <button type="button" class="btn btn-primary" id="btn-archivia">🗂 Salva in Archivio Digital</button>
            </div>
        </div>
        <p class="muted" style="font-size:11px;margin:10px 0 0">
            L'export avviene in tempo reale (dura quanto il video). Formato mp4 se il browser lo supporta, altrimenti WebM.
        </p>
    </div></div>
</div>

<script>
(function () {
    const LOGO_URL = {{ asset(logo_url)|json_encode|raw }};
    const KIT_FONT = {{ kit_font|json_encode|raw }} || {};
    const FONT_TITOLI = (KIT_FONT.titoli ? "'" + KIT_FONT.titoli + "'," : '') + "-apple-system,'Segoe UI',Roboto,sans-serif";
    const FONT_TESTO = (KIT_FONT.testo ? "'" + KIT_FONT.testo + "'," : '') + "-apple-system,'Segoe UI',Roboto,sans-serif";
    const URL_ARCHIVIA = {{ path('app_creator_video_archivia')|json_encode|raw }};
    const CSRF = {{ csrf_token('video_archivia')|json_encode|raw }};
    const PRESET = {
        nessuno: 'none',
        vivido: 'saturate(1.35) contrast(1.08)',
        caldo: 'sepia(0.25) saturate(1.3) hue-rotate(-8deg)',
        freddo: 'saturate(1.1) hue-rotate(12deg) brightness(1.03)',
        cinema: 'contrast(1.18) saturate(0.9) brightness(0.96)',
        bn: 'grayscale(1) contrast(1.1)',
        seppia: 'sepia(0.8)',
    };
    const PRESET_LABEL = { nessuno: 'Nessuno', vivido: 'Vivido', caldo: 'Caldo', freddo: 'Freddo', cinema: 'Cinema', bn: 'Bianco e nero', seppia: 'Seppia' };
    const FADE = 0.5; // secondi

    const clips = [];   // {file, url, nome, video, durata, in, out, preset}
    const tela = document.getElementById('tela');
    const ctx = tela.getContext('2d');
    const stato = document.getElementById('stato');
    let logoImg = null;
    (function () { const i = new Image(); i.onload = () => logoImg = i; i.src = LOGO_URL; })();
    let inRiproduzione = false;
    let fermaRichiesto = false;

    function dimensioni() {
        const f = document.getElementById('imp-formato').value;
        return f === '1:1' ? [1080, 1080] : f === '16:9' ? [1920, 1080] : [1080, 1920];
    }
    function applicaFormato() { const [w, h] = dimensioni(); tela.width = w; tela.height = h; disegnaCopertina(); }
    document.getElementById('imp-formato').addEventListener('change', applicaFormato);

    function disegnaCopertina() {
        ctx.filter = 'none';
        ctx.fillStyle = '#0a162c'; ctx.fillRect(0, 0, tela.width, tela.height);
        if (clips.length) {
            const v = clips[0].video; v.currentTime = Math.min(clips[0].in + 0.1, v.duration || 0);
            v.addEventListener('seeked', function una() { v.removeEventListener('seeked', una); disegnaFrame(clips[0], 1, 0); }, { once: true });
        }
    }

    /* ---------- gestione clip ---------- */
    document.getElementById('clip-file').addEventListener('change', (e) => {
        for (const file of e.target.files) {
            const url = URL.createObjectURL(file);
            const video = document.createElement('video');
            video.src = url; video.preload = 'metadata'; video.muted = false; video.playsInline = true;
            video.crossOrigin = 'anonymous';
            const clip = { file, url, nome: file.name, video, durata: 0, in: 0, out: 0, preset: 'nessuno', srcNode: null };
            video.addEventListener('loadedmetadata', () => {
                clip.durata = video.duration; clip.out = Math.round(video.duration * 10) / 10;
                renderClips(); if (clips[0] === clip) disegnaCopertina();
            });
            clips.push(clip);
        }
        e.target.value = '';
        renderClips();
    });

    function renderClips() {
        const box = document.getElementById('clip-lista');
        box.innerHTML = '';
        clips.forEach((c, i) => {
            const div = document.createElement('div');
            div.style.cssText = 'border:1px solid var(--line);border-radius:10px;padding:10px;display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center';
            const info = document.createElement('div');
            info.innerHTML = '<div style="font-weight:600;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + (i + 1) + '. ' + c.nome + '</div>'
                + '<div class="muted" style="font-size:11px">' + (c.durata ? c.durata.toFixed(1) + 's' : 'carico…') + '</div>';
            const controlli = document.createElement('div');
            controlli.style.cssText = 'display:flex;gap:4px;align-items:center;flex-wrap:wrap;justify-content:flex-end';

            const mkNum = (val, label, onInput) => {
                const wrap = document.createElement('label');
                wrap.style.cssText = 'font-size:11px;display:flex;gap:3px;align-items:center';
                wrap.textContent = label;
                const inp = document.createElement('input');
                inp.type = 'number'; inp.min = 0; inp.step = 0.1; inp.value = val;
                inp.style.cssText = 'width:64px;font-size:12px;padding:3px 6px';
                inp.addEventListener('input', () => onInput(parseFloat(inp.value) || 0));
                wrap.appendChild(inp);
                return wrap;
            };
            controlli.appendChild(mkNum(c.in, 'da s', v => c.in = v));
            controlli.appendChild(mkNum(c.out, 'a s', v => c.out = v));

            const sel = document.createElement('select');
            sel.style.cssText = 'font-size:12px;padding:3px 6px';
            Object.keys(PRESET).forEach(k => {
                const o = document.createElement('option'); o.value = k; o.textContent = PRESET_LABEL[k];
                sel.appendChild(o);
            });
            sel.value = c.preset;
            sel.addEventListener('change', () => c.preset = sel.value);
            controlli.appendChild(sel);

            const btn = (t, title, fn) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.style.cssText = 'padding:2px 8px;font-size:12px'; b.textContent = t; b.title = title; b.addEventListener('click', fn); return b; };
            controlli.appendChild(btn('↑', 'Sposta su', () => { if (i > 0) { [clips[i - 1], clips[i]] = [clips[i], clips[i - 1]]; renderClips(); } }));
            controlli.appendChild(btn('↓', 'Sposta giù', () => { if (i < clips.length - 1) { [clips[i + 1], clips[i]] = [clips[i], clips[i + 1]]; renderClips(); } }));
            controlli.appendChild(btn('✕', 'Rimuovi clip', () => { clips.splice(i, 1); renderClips(); }));

            div.append(info, controlli);
            box.appendChild(div);
        });
        if (!clips.length) box.innerHTML = '<p class="muted" style="font-size:12px;margin:0">Nessuna clip caricata.</p>';
        stato.textContent = clips.length ? 'Pronto: ' + clips.length + ' clip.' : 'Carica almeno una clip per iniziare.';
    }

    /* ---------- disegno ---------- */
    function disegnaFrame(clip, alpha, tGlobale) {
        const v = clip.video, W = tela.width, H = tela.height;
        ctx.filter = PRESET[clip.preset] || 'none';
        // cover-fit
        const r = Math.max(W / v.videoWidth, H / v.videoHeight);
        const w = v.videoWidth * r, h = v.videoHeight * r;
        ctx.drawImage(v, (W - w) / 2, (H - h) / 2, w, h);
        ctx.filter = 'none';

        // dissolvenza (a nero)
        if (alpha < 1) { ctx.fillStyle = 'rgba(0,0,0,' + (1 - alpha) + ')'; ctx.fillRect(0, 0, W, H); }

        // titolo nei primi 3 secondi (con fade out)
        const titolo = document.getElementById('imp-titolo').value.trim();
        const sotto = document.getElementById('imp-sottotitolo').value.trim();
        if (titolo && tGlobale < 3) {
            const a = tGlobale > 2.4 ? (3 - tGlobale) / 0.6 : 1;
            ctx.save(); ctx.globalAlpha = Math.max(0, a);
            ctx.textAlign = 'center';
            ctx.shadowColor = 'rgba(0,0,0,.55)'; ctx.shadowBlur = 24;
            ctx.fillStyle = '#fff';
            ctx.font = '900 ' + Math.round(W * 0.07) + 'px ' + FONT_TITOLI;
            ctx.fillText(titolo.toUpperCase(), W / 2, H * 0.44);
            if (sotto) {
                ctx.font = '600 ' + Math.round(W * 0.035) + 'px ' + FONT_TESTO;
                ctx.fillStyle = '#f6a41f';
                ctx.fillText(sotto, W / 2, H * 0.44 + W * 0.055);
            }
            ctx.restore();
        }

        // logo watermark
        if (document.getElementById('imp-logo').checked && logoImg) {
            const lw = W * 0.18, lh = lw * logoImg.height / logoImg.width;
            ctx.save(); ctx.globalAlpha = 0.92;
            ctx.drawImage(logoImg, W - lw - W * 0.04, H * 0.035, lw, lh);
            ctx.restore();
        }
    }

    /** Riproduce la timeline disegnando sul canvas; chiama onFine() al termine. */
    async function riproduci(onFine) {
        const usaDissolvenze = document.getElementById('imp-dissolvenze').checked;
        inRiproduzione = true; fermaRichiesto = false;
        document.getElementById('btn-stop').disabled = false;
        let tGlobale = 0;

        for (let i = 0; i < clips.length && !fermaRichiesto; i++) {
            const c = clips[i], v = c.video;
            const fine = Math.min(c.out || c.durata, c.durata);
            v.currentTime = Math.min(c.in, fine);
            await v.play();
            await new Promise((res) => {
                const loop = () => {
                    if (fermaRichiesto || v.currentTime >= fine || v.ended) { v.pause(); res(); return; }
                    let alpha = 1;
                    if (usaDissolvenze) {
                        const dentro = v.currentTime - c.in, manca = fine - v.currentTime;
                        if ((i > 0 || true) && dentro < FADE) alpha = dentro / FADE;
                        if (manca < FADE && (i < clips.length - 1 || true)) alpha = Math.min(alpha, manca / FADE);
                    }
                    disegnaFrame(c, alpha, tGlobale + (v.currentTime - c.in));
                    requestAnimationFrame(loop);
                };
                requestAnimationFrame(loop);
            });
            tGlobale += Math.max(0, fine - c.in);
        }

        inRiproduzione = false;
        document.getElementById('btn-stop').disabled = true;
        onFine && onFine();
    }

    document.getElementById('btn-anteprima').addEventListener('click', () => {
        if (!clips.length || inRiproduzione) return;
        applicaFormato();
        stato.textContent = 'Anteprima in corso…';
        riproduci(() => stato.textContent = 'Anteprima terminata.');
    });
    document.getElementById('btn-stop').addEventListener('click', () => { fermaRichiesto = true; });

    /* ---------- export ---------- */
    let audioCtx = null, audioDest = null, ultimoBlob = null, ultimaExt = 'webm';

    function sorgenteAudio(clip) {
        // createMediaElementSource si può chiamare UNA volta per elemento: cache sul clip
        if (!clip.srcNode) {
            clip.srcNode = audioCtx.createMediaElementSource(clip.video);
            clip.srcNode.connect(audioDest);
            clip.srcNode.connect(audioCtx.destination); // si sente anche durante l'export
        }
    }

    document.getElementById('btn-esporta').addEventListener('click', async () => {
        if (!clips.length || inRiproduzione) return;
        applicaFormato();
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        await audioCtx.resume();
        audioDest = audioDest || audioCtx.createMediaStreamDestination();
        clips.forEach(sorgenteAudio);

        const mime = MediaRecorder.isTypeSupported('video/mp4') ? 'video/mp4'
            : MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus') ? 'video/webm;codecs=vp9,opus' : 'video/webm';
        ultimaExt = mime.indexOf('mp4') !== -1 ? 'mp4' : 'webm';

        const flusso = tela.captureStream(30);
        audioDest.stream.getAudioTracks().forEach(t => flusso.addTrack(t));
        const rec = new MediaRecorder(flusso, { mimeType: mime, videoBitsPerSecond: 8_000_000 });
        const pezzi = [];
        rec.ondataavailable = (e) => { if (e.data.size) pezzi.push(e.data); };
        rec.onstop = () => {
            ultimoBlob = new Blob(pezzi, { type: mime });
            const url = URL.createObjectURL(ultimoBlob);
            document.getElementById('risultato').style.display = 'block';
            document.getElementById('video-finale').src = url;
            const a = document.getElementById('btn-scarica');
            a.href = url; a.download = (document.getElementById('imp-nome').value.trim() || 'video') + '.' + ultimaExt;
            stato.textContent = 'Export completato (' + ultimaExt.toUpperCase() + ', ' + (ultimoBlob.size / 1048576).toFixed(1) + ' MB).';
        };

        stato.textContent = 'Export in corso… (tempo reale)';
        rec.start();
        riproduci(() => rec.stop());
    });

    document.getElementById('btn-archivia').addEventListener('click', async () => {
        if (!ultimoBlob) return;
        const b = document.getElementById('btn-archivia'); b.disabled = true; b.textContent = '… archivio';
        try {
            const fd = new FormData();
            const nome = (document.getElementById('imp-nome').value.trim() || 'video');
            fd.append('titolo', nome);
            fd.append('file', new File([ultimoBlob], nome + '.' + ultimaExt, { type: ultimoBlob.type }));
            const r = await fetch(URL_ARCHIVIA, { method: 'POST', headers: { 'X-CSRF-Token': CSRF }, body: fd });
            const dati = await r.json();
            if (dati.ok) { b.textContent = '✓ In archivio'; window.open(dati.url, '_blank'); return; }
            alert(dati.error || 'Archiviazione non riuscita.');
        } catch (e) { alert('Archiviazione non riuscita.'); }
        b.disabled = false; b.textContent = '🗂 Salva in Archivio Digital';
    });

    applicaFormato();
})();
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set famiglie = [] %}
    {% if kit_font.titoli|default('') %}{% set famiglie = famiglie|merge(['family=' ~ kit_font.titoli|replace({' ': '+'}) ~ ':wght@400;600;700;900']) %}{% endif %}
    {% if kit_font.testo|default('') and kit_font.testo|default('') != kit_font.titoli|default('') %}{% set famiglie = famiglie|merge(['family=' ~ kit_font.testo|replace({' ': '+'}) ~ ':wght@400;600;700;900']) %}{% endif %}
    {% if famiglie|length %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ famiglie|join('&') }}&display=swap">
    {% endif %}
{% endblock %}
