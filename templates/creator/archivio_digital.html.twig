{% extends 'app.html.twig' %}

{% block title %}Archivio Digital · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Archivio Digital{% endblock %}

{% block main %}
<div class="card" style="margin-bottom:18px">
    <div class="card-pad">
        <h3 style="margin-bottom:12px">Aggiungi contenuto</h3>
        <form method="post" action="{{ path('app_creator_digital_nuovo') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('digital_nuovo') }}">
            <div style="display:grid;grid-template-columns:2fr 1fr 2fr;gap:14px">
                <div>
                    <label>Titolo</label>
                    <input type="text" name="titolo" required placeholder="es. Carosello Maldive inverno">
                </div>
                <div>
                    <label>Tipo</label>
                    <select name="tipo">
                        {% for t in tipi %}<option value="{{ t.value }}">{{ t.label }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label>Offerta collegata</label>
                    <select name="offerta_id">
                        <option value="">— nessuna —</option>
                        {% for o in offerte %}<option value="{{ o.id }}">{{ o.titolo }}</option>{% endfor %}
                    </select>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-top:12px">
                <div>
                    <label>File (immagine o video)</label>
                    <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,.mp4,.mov,.webm" required>
                </div>
                <div>
                    <label>Data di pubblicazione <span class="muted" style="font-weight:400">(opzionale → stato «Programmato»)</span></label>
                    <input type="datetime-local" name="data_pubblicazione">
                </div>
            </div>
            <div style="margin-top:12px">
                <label>Caption <span class="muted" style="font-weight:400">(opzionale)</span></label>
                <textarea name="caption" placeholder="Testo del post…"></textarea>
            </div>
            <button class="btn btn-primary" style="margin-top:12px">Aggiungi all'archivio</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-pad" style="border-bottom:1px solid var(--line)">
        <h3>Contenuti <span class="muted" style="font-weight:500">({{ contenuti|length }})</span></h3>
    </div>
    <table class="grid-table">
        <thead><tr><th>Titolo</th><th>Tipo</th><th>Offerta</th><th>Pubblicazione</th><th>Stato</th><th></th></tr></thead>
        <tbody>
        {% for c in contenuti %}
            <tr>
                <td style="font-weight:600"><a href="{{ path('app_creator_digital_anteprima', {id: c.id}) }}">{{ c.titolo }}</a></td>
                <td class="muted">{{ c.tipo.label }}</td>
                <td class="muted">{{ c.offerta ? c.offerta.titolo : '—' }}</td>
                <td class="muted">{{ c.dataPubblicazione ? c.dataPubblicazione|date('d/m/Y H:i') : '—' }}</td>
                <td><span class="{{ c.stato.badgeClass }}">{{ c.stato.label }}</span></td>
                <td style="text-align:right">
                    <a class="btn" href="{{ path('app_creator_digital_anteprima', {id: c.id}) }}">Anteprima</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="muted" style="text-align:center;padding:28px">Archivio vuoto: i contenuti creati con gli editor finiranno qui.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
