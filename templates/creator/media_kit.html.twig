{% extends 'app.html.twig' %}

{% block title %}Media Kit · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Media Kit{% endblock %}

{% macro slot(tipo, asset_mk, gruppoSet) %}
    <div style="border:1px solid var(--line);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:10px;min-width:0">
        <div>
            <strong>{{ tipo.label }}</strong>
            <div class="muted" style="font-size:12px">{{ tipo.descrizione }}</div>
        </div>

        {% if tipo.isTesto %}
            {% set f = asset_mk ? asset_mk.valore : {} %}
            <form method="post" action="{{ path('app_creator_mediakit_font', {gruppo: gruppoSet}) }}" style="display:grid;gap:8px">
                <input type="hidden" name="_token" value="{{ csrf_token('mediakit_font_' ~ gruppoSet) }}">
                <div>
                    <label style="font-size:12px">Font titoli</label>
                    <input type="text" name="font_titoli" value="{{ f.titoli|default('') }}" placeholder="es. Montserrat" style="width:100%">
                </div>
                <div>
                    <label style="font-size:12px">Font testo</label>
                    <input type="text" name="font_testo" value="{{ f.testo|default('') }}" placeholder="es. Lato" style="width:100%">
                </div>
                <button class="btn btn-primary">Applica font</button>
                <div class="muted" style="font-size:11px">
                    {% if asset_mk and asset_mk.valore %}Aggiornato il {{ asset_mk.updatedAt|date('d/m/Y H:i') }} · vuoto = font di sistema
                    {% else %}Nome esatto della famiglia su fonts.google.com{% endif %}
                </div>
            </form>
        {% else %}
            {% if asset_mk %}
                {% if tipo.isVideo %}
                    <video src="{{ asset('uploads/creator/mediakit/' ~ asset_mk.file) }}" controls muted style="width:100%;max-height:120px;border-radius:8px;background:#000"></video>
                {% else %}
                    <div style="background:conic-gradient(#e8e8e8 90deg,#fff 90deg 180deg,#e8e8e8 180deg 270deg,#fff 270deg) 0 0/16px 16px;border-radius:8px;padding:10px;text-align:center">
                        <img src="{{ asset('uploads/creator/mediakit/' ~ asset_mk.file) }}" alt="{{ tipo.label }}" style="max-width:100%;max-height:90px">
                    </div>
                {% endif %}
                <div class="muted" style="font-size:11px">Aggiornato il {{ asset_mk.updatedAt|date('d/m/Y H:i') }}</div>
            {% else %}
                <div class="muted" style="font-size:13px;border:1px dashed var(--line);border-radius:8px;padding:16px;text-align:center">Slot vuoto</div>
            {% endif %}

            <form method="post" action="{{ path('app_creator_mediakit_carica', {gruppo: gruppoSet, tipo: tipo.value}) }}" enctype="multipart/form-data" style="display:grid;gap:8px;margin-top:auto">
                <input type="hidden" name="_token" value="{{ csrf_token('mediakit_carica_' ~ gruppoSet ~ '_' ~ tipo.value) }}">
                <input type="file" name="file" accept="{{ tipo.isVideo ? '.mp4,.webm,.mov' : '.jpg,.jpeg,.png,.webp,.svg' }}" required style="font-size:12px;width:100%;min-width:0">
                <div style="display:flex;gap:8px">
                    <button class="btn btn-primary" style="flex:1">{{ asset_mk ? 'Sostituisci' : 'Carica' }}</button>
                    {% if asset_mk %}
                        <button class="btn" style="color:var(--danger)" form="rimuovi-{{ gruppoSet }}-{{ tipo.value }}">Rimuovi</button>
                    {% endif %}
                </div>
            </form>
            {% if asset_mk %}
                <form id="rimuovi-{{ gruppoSet }}-{{ tipo.value }}" method="post" action="{{ path('app_creator_mediakit_rimuovi', {gruppo: gruppoSet, tipo: tipo.value}) }}" onsubmit="return confirm('Rimuovere questo asset?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('mediakit_rimuovi_' ~ gruppoSet ~ '_' ~ tipo.value) }}">
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endmacro %}

{% macro setCategoria(categoria, tipi, assets, gruppoSet) %}
    {% import _self as ui %}
    <div class="card-pad" style="border-top:1px solid var(--line)">
        <div class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">
            {{ gruppoSet == 1 ? 'Set 1 · predefinito (usato dagli editor)' : 'Set ' ~ gruppoSet }}
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
            {% for tipo in tipi %}
                {{ ui.slot(tipo, assets[gruppoSet][tipo.value] ?? null, gruppoSet) }}
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% macro setIcone(iconeSet, gruppoSet) %}
    <div class="card-pad" style="border-top:1px solid var(--line)">
        <div class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">
            {{ gruppoSet == 1 ? 'Set 1 · predefinito (usato dagli editor)' : 'Set ' ~ gruppoSet }}
        </div>
        {% if iconeSet|length %}
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:14px">
                {% for ic in iconeSet %}
                    <div style="border:1px solid var(--line);border-radius:10px;padding:10px;text-align:center;min-width:0">
                        <div style="display:flex;gap:4px">
                            <div style="flex:1;background:#123a72;border-radius:8px;padding:8px" title="Variante light">
                                <img src="{{ asset('uploads/creator/mediakit/' ~ ic.file) }}" alt="{{ ic.nome }} (light)" style="height:32px;max-width:100%">
                            </div>
                            <div style="flex:1;background:#f4f7fb;border:1px solid var(--line);border-radius:8px;padding:8px" title="Variante dark">
                                {% if ic.fileDark %}
                                    <img src="{{ asset('uploads/creator/mediakit/' ~ ic.fileDark) }}" alt="{{ ic.nome }} (dark)" style="height:32px;max-width:100%">
                                {% else %}
                                    <span class="muted" style="font-size:10px">tinta auto</span>
                                {% endif %}
                            </div>
                        </div>
                        <div style="font-size:12px;font-weight:600;margin-top:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="{{ ic.nome }}">{{ ic.nome }}</div>
                        <form method="post" action="{{ path('app_creator_mediakit_icona_elimina', {id: ic.id}) }}" onsubmit="return confirm('Eliminare l\'icona «{{ ic.nome }}»?')" style="margin-top:4px">
                            <input type="hidden" name="_token" value="{{ csrf_token('mediakit_icona_elimina_' ~ ic.id) }}">
                            <button class="btn" style="color:var(--danger);font-size:11px;padding:2px 8px">Elimina</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="muted" style="font-size:13px;border:1px dashed var(--line);border-radius:8px;padding:16px;text-align:center;margin-bottom:14px">Nessuna icona in questo set.</div>
        {% endif %}

        <form method="post" action="{{ path('app_creator_mediakit_icona_carica', {gruppo: gruppoSet}) }}" enctype="multipart/form-data" style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end">
            <input type="hidden" name="_token" value="{{ csrf_token('mediakit_icona_' ~ gruppoSet) }}">
            <div style="min-width:0">
                <label style="font-size:12px">Nome</label>
                <input type="text" name="nome" placeholder="es. Aereo, Hotel, Date…" style="width:100%">
            </div>
            <div style="min-width:0">
                <label style="font-size:12px">File light (bianca)</label>
                <input type="file" name="file" accept=".png,.svg,.webp,.jpg,.jpeg" required style="font-size:12px;width:100%;min-width:0">
            </div>
            <div style="min-width:0">
                <label style="font-size:12px">File dark (blu, facolt.)</label>
                <input type="file" name="file_dark" accept=".png,.svg,.webp,.jpg,.jpeg" style="font-size:12px;width:100%;min-width:0">
            </div>
            <button class="btn btn-primary">+ Aggiungi icona</button>
        </form>
    </div>
{% endmacro %}
{% import _self as ui %}

{% block main %}
<p class="muted" style="margin:0 0 16px;max-width:820px">
    L'identità per gli editor, organizzata per categoria: ogni categoria ha i suoi <strong>set</strong>
    indipendenti (il set 1 è quello usato dagli editor) e il suo «Aggiungi set». Font indicati per nome
    (li applicano gli editor), icone in doppia variante light/dark, basi SVG per il cartello e sting video.
</p>

{% for categoria, tipi in gruppi_tipi %}
    <div class="card" style="margin-bottom:18px">
        <div class="card-pad" style="display:flex;align-items:center;justify-content:space-between">
            <h3>{{ categoria }}</h3>
            <details>
                <summary class="btn" style="display:inline-block;cursor:pointer;font-size:12px">＋ Aggiungi set {{ set_categoria[categoria].prossimo }}</summary>
            </details>
        </div>
        {% for gruppoSet in set_categoria[categoria].set %}
            {{ ui.setCategoria(categoria, tipi, assets, gruppoSet) }}
        {% endfor %}
        {# slot vuoti del prossimo set, visibili aprendo il details #}
        <div data-nuovo-set style="display:none">
            {{ ui.setCategoria(categoria, tipi, assets, set_categoria[categoria].prossimo) }}
        </div>
    </div>
{% endfor %}

<div class="card" style="margin-bottom:18px">
    <div class="card-pad" style="display:flex;align-items:center;justify-content:space-between">
        <h3>Icone</h3>
        <details>
            <summary class="btn" style="display:inline-block;cursor:pointer;font-size:12px">＋ Aggiungi set {{ set_categoria['Icone'].prossimo }}</summary>
        </details>
    </div>
    <p class="muted" style="font-size:12px;margin:0;padding:0 20px 10px">Un'icona per ogni dettaglio del viaggio: compaiono nei picker (righe, temi, tipologie) e sulle visual. Light = bianca per fondi scuri, dark = blu per fondi chiari (se manca, si tinge in automatico).</p>
    {% for gruppoSet in set_categoria['Icone'].set %}
        {{ ui.setIcone(icone[gruppoSet] ?? [], gruppoSet) }}
    {% endfor %}
    <div data-nuovo-set style="display:none">
        {{ ui.setIcone([], set_categoria['Icone'].prossimo) }}
    </div>
</div>

<script>
// «Aggiungi set N»: il details nella testata mostra gli slot vuoti del prossimo set della SUA card
document.querySelectorAll('.card > .card-pad > details').forEach(function (d) {
    d.addEventListener('toggle', function () {
        const blocco = d.closest('.card').querySelector('[data-nuovo-set]');
        if (blocco) blocco.style.display = d.open ? '' : 'none';
    });
});
</script>
{% endblock %}
