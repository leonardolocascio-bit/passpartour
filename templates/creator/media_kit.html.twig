{% extends 'app.html.twig' %}

{% block title %}Media Kit · Passpartour{% endblock %}
{% block page_title %}Creator Studio · Media Kit{% endblock %}

{% macro slot(tipo, asset_mk, gruppoSet) %}
    <div style="border:1px solid var(--line);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:10px">
        <div>
            <strong>{{ tipo.label }}</strong>
            <div class="muted" style="font-size:12px">{{ tipo.descrizione }}</div>
        </div>

        {% if asset_mk %}
            {% if tipo.isArchivio %}
                <a class="btn" href="{{ asset('uploads/creator/mediakit/' ~ asset_mk.file) }}">⬇ {{ asset_mk.nomeOriginale ?: asset_mk.file }}</a>
            {% else %}
                {# scacchiera per vedere anche i loghi bianchi/trasparenti #}
                <div style="background:conic-gradient(#e8e8e8 90deg,#fff 90deg 180deg,#e8e8e8 180deg 270deg,#fff 270deg) 0 0/16px 16px;border-radius:8px;padding:10px;text-align:center">
                    <img src="{{ asset('uploads/creator/mediakit/' ~ asset_mk.file) }}" alt="{{ tipo.label }}" style="max-width:100%;max-height:90px">
                </div>
            {% endif %}
            <div class="muted" style="font-size:11px">Aggiornato il {{ asset_mk.updatedAt|date('d/m/Y H:i') }}</div>
        {% else %}
            <div class="muted" style="font-size:13px;border:1px dashed var(--line);border-radius:8px;padding:16px;text-align:center">Slot vuoto</div>
        {% endif %}

        <form method="post" action="{{ path('app_creator_mediakit_carica', {gruppo: gruppoSet, tipo: tipo.value}) }}" enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center">
            <input type="hidden" name="_token" value="{{ csrf_token('mediakit_carica_' ~ gruppoSet ~ '_' ~ tipo.value) }}">
            <input type="file" name="file" accept="{{ tipo.isArchivio ? '.zip' : '.jpg,.jpeg,.png,.webp,.svg' }}" required style="font-size:12px">
            <button class="btn btn-primary">{{ asset_mk ? 'Sostituisci' : 'Carica' }}</button>
        </form>
        {% if asset_mk %}
            <form method="post" action="{{ path('app_creator_mediakit_rimuovi', {gruppo: gruppoSet, tipo: tipo.value}) }}" onsubmit="return confirm('Rimuovere questo asset?')">
                <input type="hidden" name="_token" value="{{ csrf_token('mediakit_rimuovi_' ~ gruppoSet ~ '_' ~ tipo.value) }}">
                <button class="btn" style="color:var(--danger);font-size:12px">Rimuovi</button>
            </form>
        {% endif %}
    </div>
{% endmacro %}
{% import _self as ui %}

{% block main %}
<p class="muted" style="margin:0 0 16px;max-width:760px">
    Qui il grafico carica loghi, format e font, organizzati in <strong>set</strong>: il set 1 è quello
    predefinito che gli editor usano (la scelta del set negli editor arriverà in seguito).
    Per un rebranding basta sostituire i file, o preparare un nuovo set.
</p>

{% for gruppoSet in set_esistenti %}
    <h2 style="font-size:16px;margin:0 0 10px">{{ gruppoSet == 1 ? 'Set 1 · predefinito' : 'Set ' ~ gruppoSet }}</h2>
    {% for gruppo, tipi in gruppi_tipi %}
        <div class="card" style="margin-bottom:18px">
            <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>{{ gruppo }}</h3></div>
            <div class="card-pad" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
                {% for tipo in tipi %}
                    {{ ui.slot(tipo, assets[gruppoSet][tipo.value] ?? null, gruppoSet) }}
                {% endfor %}
            </div>
        </div>
    {% endfor %}
{% endfor %}

{# nuovo set: slot vuoti pronti per il primo caricamento #}
<details style="margin-top:8px">
    <summary class="btn" style="display:inline-block;cursor:pointer">＋ Aggiungi set {{ prossimo_set }}</summary>
    <div style="margin-top:14px">
        {% for gruppo, tipi in gruppi_tipi %}
            <div class="card" style="margin-bottom:18px">
                <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>{{ gruppo }} · set {{ prossimo_set }}</h3></div>
                <div class="card-pad" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
                    {% for tipo in tipi %}
                        {{ ui.slot(tipo, null, prossimo_set) }}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</details>
{% endblock %}
