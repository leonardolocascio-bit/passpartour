{% extends 'app.html.twig' %}

{% block title %}Clienti · Passpartour{% endblock %}
{% block page_title %}Clienti{% endblock %}

{% block main %}
<div class="card">
    <div class="card-pad" style="border-bottom:1px solid var(--line)">
        <h3>Clienti <span class="muted" style="font-weight:500">({{ clienti|length }})</span></h3>
    </div>
    <table class="grid-table">
        <thead><tr><th>Nome</th><th>Email</th><th>Telefono</th><th>Preventivi</th></tr></thead>
        <tbody>
        {% for c in clienti %}
            <tr>
                <td style="font-weight:600">{{ c.nomeCompleto }}</td>
                <td class="muted">{{ c.email ?: '—' }}</td>
                <td class="muted">{{ c.telefono ?: '—' }}</td>
                <td>{{ c.preventivi|length }}</td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="muted" style="text-align:center;padding:28px">Nessun cliente. Si popolerà convertendo i lead.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
