{% extends 'app.html.twig' %}

{% block title %}Impaginatore · {{ offerta.titolo }} · Passpartour{% endblock %}
{% block page_title %}Impaginatore — {{ offerta.titolo }}{% endblock %}

{% block main %}
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap">
    <p class="muted" style="margin:0;font-size:13px">
        Contenuti social (Instagram 3:4, carosello) e stampa generati dall'offerta.
        <a href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">Modifica dati offerta</a>
    </p>
    <div style="display:flex;gap:8px;align-items:center">
        <span id="stato-salvataggio" class="muted" style="font-size:12px"></span>
        <button type="button" class="btn btn-primary" id="btn-salva">💾 Salva</button>
        <a class="btn" href="{{ path('app_offerta_index') }}">← Offerte</a>
    </div>
</div>

<div style="display:grid;grid-template-columns:minmax(380px,1fr) minmax(360px,460px);gap:18px;align-items:start">

    {# ============ COLONNA SINISTRA: CONTROLLI ============ #}
    <div style="display:grid;gap:14px">

        <div class="card"><div class="card-pad">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <strong>Slide del carosello</strong>
                <div style="display:flex;gap:6px">
                    <button type="button" class="btn" id="slide-sposta-sx" title="Sposta slide a sinistra">◀</button>
                    <button type="button" class="btn" id="slide-sposta-dx" title="Sposta slide a destra">▶</button>
                    <button type="button" class="btn" id="slide-elimina" title="Elimina slide" style="color:var(--danger)">✕</button>
                    <button type="button" class="btn" id="slide-aggiungi">+ Slide</button>
                </div>
            </div>
            <div id="slide-tabs" style="display:flex;gap:6px;flex-wrap:wrap"></div>
        </div></div>

        <div class="card"><div class="card-pad" style="display:grid;gap:12px">
            <strong>Elementi in evidenza</strong>
            <div>
                <label>Claim (facoltativo)</label>
                <input type="text" id="inp-claim" maxlength="200" placeholder="Es. Il paradiso esiste, prenotalo" value="{{ offerta.claim }}">
            </div>
            <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:13px">
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-titolo"> Titolo</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-destinazione"> Destinazione</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-tipologia"> Tipologia</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-claim"> Claim</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-durata"> Durata</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-prezzo"> Prezzo</label>
                <label style="display:flex;gap:6px;align-items:center;cursor:pointer"><input type="checkbox" id="chk-logo"> Logo</label>
            </div>
            <p class="muted" style="margin:0;font-size:12px">
                Titolo: <strong>{{ offerta.titolo }}</strong>
                {% if offerta.durata %} · Durata: <strong>{{ offerta.durata }}</strong>{% endif %}
                {% if offerta.prezzoDa %} · Prezzo: <strong>da € {{ offerta.prezzoDa|number_format(0, ',', '.') }}</strong>{% endif %}
                — si modificano nella <a href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">scheda offerta</a>.
            </p>
        </div></div>

        <div class="card"><div class="card-pad">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <strong>Righe del viaggio</strong>
                <a class="btn" href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">✎ Modifica nel configuratore</a>
            </div>
            <div id="righe-box" style="display:grid;gap:6px"></div>
            <p class="muted" style="font-size:11px;margin:8px 0 0">Le righe si compilano nel configuratore dell'offerta; qui scegli cosa mostrare: 📱 nella slide corrente, 💬 nella caption.</p>
        </div></div>

        <div class="card"><div class="card-pad">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <strong>Varianti</strong>
                <a class="btn" href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">✎ Modifica nel configuratore</a>
            </div>
            <div id="varianti-box" style="display:grid;gap:6px"></div>
            <p class="muted" style="font-size:11px;margin:8px 0 0">Le varianti di durata con prezzo sostituiscono il prezzo unico sulla slide; partenze e validità compaiono come righe; le varianti di riga si aggiungono alla riga.</p>
        </div></div>

        <div class="card"><div class="card-pad">
            <strong>Sfondo della slide</strong>
            <div id="sfondi-correnti" style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"></div>
            {% if unsplash_configurato %}
                <div style="display:flex;gap:8px;margin-top:10px">
                    <input type="text" id="unsplash-q" placeholder="Cerca foto della destinazione…" value="{{ offerta.destinazione ? offerta.destinazione.nome : offerta.titolo }}" style="flex:1">
                    <button type="button" class="btn" id="unsplash-cerca">Cerca</button>
                </div>
                <div id="unsplash-risultati" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px"></div>
                <div id="unsplash-stato" class="muted" style="font-size:12px;margin-top:6px"></div>
            {% else %}
                <p class="muted" style="font-size:12px;margin:8px 0 0">💡 Imposta <code>UNSPLASH_ACCESS_KEY</code> in <code>.env.local</code> per scegliere lo sfondo tra le foto della destinazione.</p>
            {% endif %}
        </div></div>

        <div class="card"><div class="card-pad" style="display:grid;gap:10px">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
                <strong>Caption Instagram</strong>
                <div style="display:flex;gap:8px;align-items:center">
                    <select id="sel-tono" style="min-width:200px">
                        {% for chiave, etichetta in toni %}
                            <option value="{{ chiave }}">{{ etichetta }}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="btn btn-primary" id="btn-genera-caption">✨ Genera</button>
                </div>
            </div>
            {% if not ai_configurata %}
                <p class="muted" style="font-size:11px;margin:0">Generazione da template. Per caption AI imposta <code>ANTHROPIC_API_KEY</code> in <code>.env.local</code>.</p>
            {% endif %}
            <textarea id="txt-caption" rows="9" placeholder="La caption comparirà qui: puoi modificarla liberamente."></textarea>
            <div style="display:flex;justify-content:space-between;align-items:center">
                <span class="muted" style="font-size:11px" id="caption-contatore">0 / 2200 · le prime 125 battute sono quelle visibili nel feed</span>
                <button type="button" class="btn" id="btn-copia-caption">📋 Copia</button>
            </div>
        </div></div>

        <div class="card"><div class="card-pad">
            <strong>Stampa</strong>
            <p class="muted" style="font-size:12px;margin:6px 0 10px">Layout base A4/A3 — apri e stampa (o salva in PDF) dal browser.</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <a class="btn" target="_blank" href="{{ path('app_offerta_stampa', {id: offerta.id, formato: 'a4v'}) }}">🖨 A4 verticale</a>
                <a class="btn" target="_blank" href="{{ path('app_offerta_stampa', {id: offerta.id, formato: 'a4o'}) }}">🖨 A4 orizzontale</a>
                <a class="btn" target="_blank" href="{{ path('app_offerta_stampa', {id: offerta.id, formato: 'a3v'}) }}">🖨 A3 verticale</a>
                <a class="btn" target="_blank" href="{{ path('app_offerta_stampa', {id: offerta.id, formato: 'a3o'}) }}">🖨 A3 orizzontale</a>
            </div>
        </div></div>
    </div>

    {# ============ COLONNA DESTRA: ANTEPRIMA ============ #}
    <div style="position:sticky;top:16px">
        <div class="card"><div class="card-pad" style="display:grid;gap:10px;justify-items:center">
            <canvas id="canvas" width="1080" height="1440" style="width:100%;max-width:420px;border-radius:12px;box-shadow:0 10px 30px rgba(18,58,114,.25)"></canvas>
            <div id="credito-foto" class="muted" style="font-size:11px"></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
                <button type="button" class="btn btn-primary" id="btn-png">⬇ Scarica PNG (1080×1440)</button>
                <button type="button" class="btn" id="btn-png-tutte">⬇ Scarica tutto il carosello</button>
            </div>
            <p class="muted" style="font-size:11px;margin:0;text-align:center">Formato 3:4 secondo le linee guida Instagram (1080×1440 px). Max 20 slide per carosello.</p>
        </div></div>
    </div>
</div>

<script>
(function () {
    'use strict';

    /* ---------- Dati iniziali ---------- */
    const OFFERTA = {
        id: {{ offerta.id }},
        titolo: {{ offerta.titolo|json_encode|raw }},
        sottotitolo: {{ offerta.sottotitolo|json_encode|raw }},
        destinazioneMacro: {{ offerta.destinazioneMacro|json_encode|raw }},
        destinazioneMicro: {{ offerta.destinazioneMicro|json_encode|raw }},
        tipologie: {{ offerta.tipologieLabel|json_encode|raw }},
        durata: {{ offerta.durata|json_encode|raw }},
        prezzoDa: {{ offerta.prezzoDa ? offerta.prezzoDa|number_format(0, ',', '.')|json_encode|raw : 'null' }},
        immagine: {{ offerta.immagineFile|json_encode|raw }},
        fotografo: {{ offerta.fotografoEffettivo|json_encode|raw }},
        fotografoUrl: {{ offerta.fotografoUrlEffettivo|json_encode|raw }},
        righe: {{ offerta.righe|json_encode|raw }},
        varianti: {{ offerta.varianti|json_encode|raw }},
    };
    const URLS = {
        salva: {{ path('app_offerta_impaginatore_salva', {id: offerta.id})|json_encode|raw }},
        caption: {{ path('app_offerta_impaginatore_caption', {id: offerta.id})|json_encode|raw }},
        sfondo: {{ path('app_offerta_impaginatore_sfondo', {id: offerta.id})|json_encode|raw }},
        unsplashSearch: {{ path('api_unsplash_search')|json_encode|raw }},
        unsplashSelect: {{ path('api_unsplash_select')|json_encode|raw }},
        uploads: {{ asset('uploads/destinazioni/')|json_encode|raw }},
        logo: {{ asset('images/passpartour-white.png')|json_encode|raw }},
    };
    const CSRF = {{ csrf_token('impaginatore_' ~ offerta.id)|json_encode|raw }};

    /* ---------- Stato ---------- */
    const tuttiGliId = () => OFFERTA.righe.map(r => r.id);
    const tuttiGliIdVar = () => OFFERTA.varianti.map(v => v.id);
    const nuovaSlide = () => ({
        sfondo: OFFERTA.immagine ? { file: OFFERTA.immagine, fotografo: OFFERTA.fotografo || '', fotografoUrl: OFFERTA.fotografoUrl || '' } : null,
        mostra: { titolo: true, destinazione: true, tipologia: true, claim: true, durata: true, prezzo: true, logo: true },
        righe: tuttiGliId(),
        varianti: tuttiGliIdVar(),
    });

    let stato = {{ offerta.impaginato ? offerta.impaginato|json_encode|raw : 'null' }};
    if (!stato || !Array.isArray(stato.slides) || !stato.slides.length) {
        stato = { slides: [nuovaSlide()], caption: { tono: 'professionale', testo: '' } };
    }
    stato.caption = stato.caption || { tono: 'professionale', testo: '' };
    if (!Array.isArray(stato.caption.righe)) stato.caption.righe = tuttiGliId();
    if (!Array.isArray(stato.caption.varianti)) stato.caption.varianti = tuttiGliIdVar();
    // le slide referenziano righe e varianti dell'offerta per id: scarta id orfani
    stato.slides.forEach(s => {
        s.righe = (s.righe || []).filter(id => typeof id === 'string' && tuttiGliId().includes(id));
        s.varianti = Array.isArray(s.varianti) ? s.varianti.filter(id => tuttiGliIdVar().includes(id)) : tuttiGliIdVar();
    });
    stato.caption.righe = stato.caption.righe.filter(id => tuttiGliId().includes(id));
    stato.caption.varianti = stato.caption.varianti.filter(id => tuttiGliIdVar().includes(id));
    let corrente = 0;
    let sporco = false;

    /** Righe dell'offerta selezionate (in ordine di configuratore) dato un elenco di id. */
    function righeDaId(ids) {
        return OFFERTA.righe.filter(r => (ids || []).includes(r.id));
    }

    function variantiDaId(ids) {
        return OFFERTA.varianti.filter(v => (ids || []).includes(v.id));
    }

    /** Etichetta umana del campo di una variante ('durata' | 'validita' | 'partenza' | id riga). */
    function etichettaCampo(v) {
        if (v.campo === 'durata') return 'Durata';
        if (v.campo === 'validita') return 'Validità';
        if (v.campo === 'partenza') return 'Partenza da';
        const riga = OFFERTA.righe.find(r => r.id === v.campo);
        return riga ? (riga.argomento || riga.testo || 'Riga') : 'Opzioni';
    }

    function prezzoLabel(p) {
        p = (p || '').trim();
        return p ? (p.includes('€') ? p : '€ ' + p) : '';
    }

    function variantePiuPrezzo(v) {
        const pr = prezzoLabel(v.prezzo);
        return v.valore + (pr ? ' ' + pr : '');
    }

    /* ---------- Riferimenti DOM ---------- */
    const $ = id => document.getElementById(id);
    const canvas = $('canvas'), ctx = canvas.getContext('2d');
    const cacheImg = {};

    function slide() { return stato.slides[corrente]; }
    function segnaSporco() { sporco = true; $('stato-salvataggio').textContent = 'Modifiche non salvate'; }

    /* ---------- Rendering canvas 1080×1440 ---------- */
    function caricaImg(src) {
        return new Promise(resolve => {
            if (cacheImg[src]) return resolve(cacheImg[src]);
            const im = new Image();
            im.onload = () => { cacheImg[src] = im; resolve(im); };
            im.onerror = () => resolve(null);
            im.src = src;
        });
    }

    function testoACapo(c, testo, x, y, maxLarghezza, interlinea) {
        const parole = String(testo).split(/\s+/);
        let riga = '', yy = y;
        for (const p of parole) {
            const tentativo = riga ? riga + ' ' + p : p;
            if (c.measureText(tentativo).width > maxLarghezza && riga) {
                c.fillText(riga, x, yy); yy += interlinea; riga = p;
            } else riga = tentativo;
        }
        if (riga) c.fillText(riga, x, yy);
        return yy + interlinea;
    }

    async function disegna(s, c) {
        const W = 1080, H = 1440, PAD = 72;
        c.clearRect(0, 0, W, H);

        // Sfondo
        let img = null;
        if (s.sfondo && s.sfondo.file) img = await caricaImg(URLS.uploads + s.sfondo.file);
        if (img) {
            const scala = Math.max(W / img.width, H / img.height);
            const w = img.width * scala, h = img.height * scala;
            c.drawImage(img, (W - w) / 2, (H - h) / 2, w, h);
        } else {
            const g = c.createLinearGradient(0, 0, W, H);
            g.addColorStop(0, '#123a72'); g.addColorStop(1, '#1f9fd6');
            c.fillStyle = g; c.fillRect(0, 0, W, H);
        }

        // Velature per leggibilità
        let g = c.createLinearGradient(0, 0, 0, 320);
        g.addColorStop(0, 'rgba(10,22,44,.55)'); g.addColorStop(1, 'rgba(10,22,44,0)');
        c.fillStyle = g; c.fillRect(0, 0, W, 320);
        g = c.createLinearGradient(0, H * .38, 0, H);
        g.addColorStop(0, 'rgba(10,22,44,0)'); g.addColorStop(.45, 'rgba(10,22,44,.62)'); g.addColorStop(1, 'rgba(10,22,44,.92)');
        c.fillStyle = g; c.fillRect(0, H * .38, W, H * .62);
        // tinta calda brand (duotone leggero verso il basso)
        g = c.createLinearGradient(0, H * .32, 0, H);
        g.addColorStop(0, 'rgba(234,91,36,0)'); g.addColorStop(1, 'rgba(234,91,36,.30)');
        c.fillStyle = g; c.fillRect(0, H * .32, W, H * .68);

        const FONT = "-apple-system,'Segoe UI',Roboto,'Helvetica Neue',sans-serif";

        // ===== Cover in stile brand: logo centrato → tipologia (corsivo) → destinazione → prezzo → righe =====
        const vSel = variantiDaId(s.varianti);
        const vDurata = vSel.filter(v => v.campo === 'durata' && (v.valore || '').trim());

        // Logo centrato in alto
        c.textAlign = 'center';
        let yTop = 130;
        if (s.mostra.logo) {
            const logo = await caricaImg(URLS.logo);
            if (logo) { const lw = 250, lh = lw * logo.height / logo.width; c.drawImage(logo, (W - lw) / 2, 92, lw, lh); yTop = 92 + lh + 64; }
        }

        // Eyebrow: tipologia in corsivo (es. "Tour del …")
        if (s.mostra.tipologia && OFFERTA.tipologie && OFFERTA.tipologie.length) {
            c.font = 'italic 600 60px ' + FONT; c.fillStyle = '#fff';
            c.shadowColor = 'rgba(0,0,0,.35)'; c.shadowBlur = 12; c.shadowOffsetY = 3;
            c.fillText(OFFERTA.tipologie[0], W / 2, yTop + 46);
            c.shadowColor = 'transparent'; c.shadowBlur = 0; c.shadowOffsetY = 0;
            yTop += 62;
        }

        // Titolo hero centrato: destinazione (se attiva), altrimenti titolo offerta
        const heroTxt = (s.mostra.destinazione && (OFFERTA.destinazioneMicro || OFFERTA.destinazioneMacro))
            ? (OFFERTA.destinazioneMicro || OFFERTA.destinazioneMacro)
            : (s.mostra.titolo ? OFFERTA.titolo : '');
        if (heroTxt) {
            const t = heroTxt.toUpperCase();
            let size = 200;
            c.font = '900 ' + size + 'px ' + FONT;
            while (c.measureText(t).width > W - 2 * PAD && size > 80) { size -= 6; c.font = '900 ' + size + 'px ' + FONT; }
            c.fillStyle = '#fff';
            c.shadowColor = 'rgba(0,0,0,.45)'; c.shadowBlur = 22; c.shadowOffsetY = 5;
            c.fillText(t, W / 2, yTop + size);
            c.shadowColor = 'transparent'; c.shadowBlur = 0; c.shadowOffsetY = 0;
            yTop += size + 16;
        }

        // Claim centrato (corsivo, ambra)
        if (s.mostra.claim) {
            const claim = $('inp-claim').value.trim();
            if (claim) {
                c.font = 'italic 600 46px ' + FONT; c.fillStyle = '#f6a41f';
                c.fillText(claim, W / 2, yTop + 46);
                yTop += 74;
            }
        }
        c.textAlign = 'left';

        // Prezzo: badge ambra a sinistra "da €X"
        if (s.mostra.prezzo && (OFFERTA.prezzoDa || vDurata.length)) {
            const pTxt = OFFERTA.prezzoDa ? ('€' + OFFERTA.prezzoDa) : prezzoLabel(vDurata[0].prezzo).replace('€ ', '€');
            c.font = '900 84px ' + FONT; const pw = c.measureText(pTxt).width;
            c.font = '700 42px ' + FONT; const daw = c.measureText('da ').width;
            const bh = 112, bx = PAD, by = yTop + 34, bw = 44 + daw + pw + 44;
            c.fillStyle = '#f6a41f'; c.beginPath(); c.roundRect(bx, by, bw, bh, 10); c.fill();
            c.textBaseline = 'middle';
            c.fillStyle = 'rgba(255,255,255,.92)'; c.font = '700 42px ' + FONT; c.fillText('da ', bx + 44, by + bh / 2 + 2);
            c.fillStyle = '#fff'; c.font = '900 84px ' + FONT; c.fillText(pTxt, bx + 44 + daw, by + bh / 2 + 4);
            c.textBaseline = 'alphabetic';
            yTop = by + bh;
        }

        // Righe/feature: icona a filo + parola chiave in grassetto + descrizione (con a-capo)
        const righe = righeDaId(s.righe).filter(r => (r.argomento || r.testo)).map(r => {
            const extra = vSel.filter(v => v.campo === r.id).map(variantePiuPrezzo).join(' · ');
            return extra ? { ...r, testo: (r.testo ? r.testo + ' · ' : '') + extra } : r;
        });
        const vPartenza = vSel.filter(v => v.campo === 'partenza');
        if (vPartenza.length) righe.push({ icona: '🛫', argomento: 'Partenze da', testo: vPartenza.map(variantePiuPrezzo).join(' · ') });
        const vValidita = vSel.filter(v => v.campo === 'validita');
        if (vValidita.length) righe.push({ icona: '📅', argomento: 'Validità', testo: vValidita.map(variantePiuPrezzo).join(' · ') });
        if (righe.length) {
            const iconX = PAD, textX = PAD + 78, maxW = W - PAD - (PAD + 78), lh = 52, gap = 28;
            let y = Math.max(yTop + 46, H * 0.60);
            for (const r of righe) {
                // token: parole dell'argomento (bold) + parole della descrizione (regular)
                const boldWords = (r.argomento || '').trim() ? r.argomento.trim().split(/\s+/).map(p => ({ p, bold: true })) : [];
                const regWords = (r.testo || '').trim() ? r.testo.trim().split(/\s+/).map(p => ({ p, bold: false })) : [];
                const tokens = boldWords.concat(regWords);
                // wrap
                const linee = []; let cur = []; let curW = 0;
                for (const tok of tokens) {
                    c.font = (tok.bold ? '800 40px ' : '500 40px ') + FONT;
                    const w = c.measureText(tok.p + ' ').width;
                    if (curW + w > maxW && cur.length) { linee.push(cur); cur = []; curW = 0; }
                    cur.push(tok); curW += w;
                }
                if (cur.length) linee.push(cur);

                c.font = '400 46px ' + FONT; c.fillStyle = '#fff'; c.fillText(r.icona || '▪️', iconX, y + 40);
                let ly = y + 38;
                for (const linea of linee) {
                    let x = textX;
                    for (const tok of linea) {
                        c.font = (tok.bold ? '800 40px ' : '500 40px ') + FONT; c.fillStyle = '#fff';
                        c.fillText(tok.p, x, ly);
                        x += c.measureText(tok.p + ' ').width;
                    }
                    ly += lh;
                }
                y += linee.length * lh + gap;
            }
        }

        // Credito foto (obbligo attribuzione Unsplash)
        if (s.sfondo && s.sfondo.fotografo) {
            c.font = '400 24px ' + FONT; c.fillStyle = 'rgba(255,255,255,.7)';
            c.fillText('Foto: ' + s.sfondo.fotografo + ' / Unsplash', PAD, H - 24);
        }
    }

    function misuraACapo(c, testo, maxLarghezza, interlinea) {
        const parole = String(testo).split(/\s+/);
        let riga = '', n = 1;
        for (const p of parole) {
            const tentativo = riga ? riga + ' ' + p : p;
            if (c.measureText(tentativo).width > maxLarghezza && riga) { n++; riga = p; } else riga = tentativo;
        }
        return n * interlinea;
    }

    let renderRichiesto = false;
    function ridisegna() {
        if (renderRichiesto) return;
        renderRichiesto = true;
        requestAnimationFrame(async () => { renderRichiesto = false; await disegna(slide(), ctx); aggiornaCredito(); });
    }

    function aggiornaCredito() {
        const s = slide(), box = $('credito-foto');
        if (s.sfondo && s.sfondo.fotografo) {
            box.innerHTML = 'Foto di ' + (s.sfondo.fotografoUrl
                ? '<a href="' + s.sfondo.fotografoUrl + '" target="_blank" rel="noopener">' + s.sfondo.fotografo + '</a>'
                : s.sfondo.fotografo) + ' · Unsplash';
        } else box.textContent = '';
    }

    /* ---------- UI slide (carosello) ---------- */
    function renderTabs() {
        const box = $('slide-tabs'); box.innerHTML = '';
        stato.slides.forEach((s, i) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'btn'; b.textContent = 'Slide ' + (i + 1);
            if (i === corrente) { b.style.background = 'var(--brand)'; b.style.color = '#fff'; b.style.borderColor = 'var(--brand)'; }
            b.addEventListener('click', () => { corrente = i; renderTutto(); });
            box.appendChild(b);
        });
    }

    $('slide-aggiungi').addEventListener('click', () => {
        if (stato.slides.length >= 20) return alert('Instagram consente al massimo 20 slide per carosello.');
        const copia = JSON.parse(JSON.stringify(slide()));
        copia.mostra = { titolo: false, destinazione: false, tipologia: false, claim: false, durata: false, prezzo: false, logo: true };
        stato.slides.splice(corrente + 1, 0, copia);
        corrente++; segnaSporco(); renderTutto();
    });
    $('slide-elimina').addEventListener('click', () => {
        if (stato.slides.length === 1) return alert('Il carosello deve avere almeno una slide.');
        if (!confirm('Eliminare la slide ' + (corrente + 1) + '?')) return;
        stato.slides.splice(corrente, 1);
        corrente = Math.max(0, corrente - 1); segnaSporco(); renderTutto();
    });
    $('slide-sposta-sx').addEventListener('click', () => {
        if (corrente === 0) return;
        [stato.slides[corrente - 1], stato.slides[corrente]] = [stato.slides[corrente], stato.slides[corrente - 1]];
        corrente--; segnaSporco(); renderTutto();
    });
    $('slide-sposta-dx').addEventListener('click', () => {
        if (corrente === stato.slides.length - 1) return;
        [stato.slides[corrente + 1], stato.slides[corrente]] = [stato.slides[corrente], stato.slides[corrente + 1]];
        corrente++; segnaSporco(); renderTutto();
    });

    /* ---------- UI elementi in evidenza ---------- */
    const chk = { titolo: $('chk-titolo'), destinazione: $('chk-destinazione'), tipologia: $('chk-tipologia'), claim: $('chk-claim'), durata: $('chk-durata'), prezzo: $('chk-prezzo'), logo: $('chk-logo') };
    Object.entries(chk).forEach(([k, el]) => el.addEventListener('change', () => { slide().mostra[k] = el.checked; segnaSporco(); ridisegna(); }));
    $('inp-claim').addEventListener('input', () => { segnaSporco(); ridisegna(); });

    /* ---------- Selezione righe (ereditate dal configuratore offerta) ---------- */
    function renderRighe() {
        const box = $('righe-box'); box.innerHTML = '';
        if (!OFFERTA.righe.length) {
            box.innerHTML = '<p class="muted" style="font-size:12px;margin:0">Nessuna riga sull\'offerta: compilale nel configuratore («Modifica nel configuratore»).</p>';
            return;
        }

        const testata = document.createElement('div');
        testata.className = 'muted';
        testata.style.cssText = 'display:grid;grid-template-columns:1fr 52px 52px;gap:6px;font-size:10px;text-transform:uppercase;letter-spacing:.5px';
        testata.innerHTML = '<span></span><span style="text-align:center">📱 Slide</span><span style="text-align:center">💬 Caption</span>';
        box.appendChild(testata);

        const s = slide();
        OFFERTA.righe.forEach(r => {
            const div = document.createElement('div');
            div.style.cssText = 'display:grid;grid-template-columns:1fr 52px 52px;gap:6px;align-items:center;font-size:13px';

            const etichetta = document.createElement('div');
            etichetta.style.cssText = 'display:flex;gap:6px;align-items:baseline;min-width:0';
            etichetta.innerHTML = '<span>' + (r.icona || '▪️') + '</span>'
                + (r.argomento ? '<strong style="color:var(--brand);font-size:12px">' + r.argomento.toUpperCase() + '</strong>' : '')
                + '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + (r.testo || '') + '</span>'
                + (r.evidenza ? '<span title="In evidenza" style="color:#f6a41f">★</span>' : '');

            const cbSlide = document.createElement('input');
            cbSlide.type = 'checkbox'; cbSlide.style.justifySelf = 'center';
            cbSlide.checked = s.righe.includes(r.id);
            cbSlide.addEventListener('change', () => {
                s.righe = cbSlide.checked ? [...s.righe, r.id] : s.righe.filter(id => id !== r.id);
                segnaSporco(); ridisegna();
            });

            const cbCaption = document.createElement('input');
            cbCaption.type = 'checkbox'; cbCaption.style.justifySelf = 'center';
            cbCaption.checked = stato.caption.righe.includes(r.id);
            cbCaption.addEventListener('change', () => {
                stato.caption.righe = cbCaption.checked ? [...stato.caption.righe, r.id] : stato.caption.righe.filter(id => id !== r.id);
                segnaSporco();
            });

            div.append(etichetta, cbSlide, cbCaption);
            box.appendChild(div);
        });
    }

    /* ---------- Selezione varianti (ereditate dal configuratore offerta) ---------- */
    function renderVarianti() {
        const box = $('varianti-box'); box.innerHTML = '';
        if (!OFFERTA.varianti.length) {
            box.innerHTML = '<p class="muted" style="font-size:12px;margin:0">Nessuna variante sull\'offerta: compilale nel configuratore.</p>';
            return;
        }

        const testata = document.createElement('div');
        testata.className = 'muted';
        testata.style.cssText = 'display:grid;grid-template-columns:1fr 52px 52px;gap:6px;font-size:10px;text-transform:uppercase;letter-spacing:.5px';
        testata.innerHTML = '<span></span><span style="text-align:center">📱 Slide</span><span style="text-align:center">💬 Caption</span>';
        box.appendChild(testata);

        const s = slide();
        OFFERTA.varianti.forEach(v => {
            const div = document.createElement('div');
            div.style.cssText = 'display:grid;grid-template-columns:1fr 52px 52px;gap:6px;align-items:center;font-size:13px';

            const etichetta = document.createElement('div');
            etichetta.style.cssText = 'display:flex;gap:6px;align-items:baseline;min-width:0';
            etichetta.innerHTML = '<strong style="color:var(--brand);font-size:12px">' + etichettaCampo(v).toUpperCase() + '</strong>'
                + '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + (v.valore || '') + '</span>'
                + (prezzoLabel(v.prezzo) ? '<span style="color:#ea5b24;font-weight:700">' + prezzoLabel(v.prezzo) + '</span>' : '');

            const cbSlide = document.createElement('input');
            cbSlide.type = 'checkbox'; cbSlide.style.justifySelf = 'center';
            cbSlide.checked = s.varianti.includes(v.id);
            cbSlide.addEventListener('change', () => {
                s.varianti = cbSlide.checked ? [...s.varianti, v.id] : s.varianti.filter(id => id !== v.id);
                segnaSporco(); ridisegna();
            });

            const cbCaption = document.createElement('input');
            cbCaption.type = 'checkbox'; cbCaption.style.justifySelf = 'center';
            cbCaption.checked = stato.caption.varianti.includes(v.id);
            cbCaption.addEventListener('change', () => {
                stato.caption.varianti = cbCaption.checked ? [...stato.caption.varianti, v.id] : stato.caption.varianti.filter(id => id !== v.id);
                segnaSporco();
            });

            div.append(etichetta, cbSlide, cbCaption);
            box.appendChild(div);
        });
    }

    /* ---------- Sfondi ---------- */
    function renderSfondiCorrenti() {
        const box = $('sfondi-correnti'); box.innerHTML = '';
        const s = slide();
        const opzioni = [];
        if (OFFERTA.immagine) opzioni.push({ file: OFFERTA.immagine, fotografo: OFFERTA.fotografo || '', fotografoUrl: OFFERTA.fotografoUrl || '', label: 'Immagine offerta' });
        if (s.sfondo && s.sfondo.file && (!OFFERTA.immagine || s.sfondo.file !== OFFERTA.immagine)) opzioni.push({ ...s.sfondo, label: 'Sfondo attuale' });
        opzioni.forEach(o => {
            const w = document.createElement('div'); w.style.cssText = 'text-align:center';
            const img = document.createElement('img');
            img.src = URLS.uploads + o.file;
            const attivo = s.sfondo && s.sfondo.file === o.file;
            img.style.cssText = 'width:84px;height:112px;object-fit:cover;border-radius:8px;cursor:pointer;border:3px solid ' + (attivo ? 'var(--brand)' : 'transparent');
            img.title = o.label;
            img.addEventListener('click', () => { s.sfondo = { file: o.file, fotografo: o.fotografo, fotografoUrl: o.fotografoUrl }; segnaSporco(); renderSfondiCorrenti(); ridisegna(); });
            const l = document.createElement('div'); l.className = 'muted'; l.style.fontSize = '10px'; l.textContent = o.label;
            w.append(img, l); box.appendChild(w);
        });
        const nessuno = document.createElement('div'); nessuno.style.cssText = 'text-align:center';
        const bN = document.createElement('div');
        const attivoN = !s.sfondo;
        bN.style.cssText = 'width:84px;height:112px;border-radius:8px;cursor:pointer;display:grid;place-items:center;font-size:10px;color:#fff;background:linear-gradient(135deg,#123a72,#1f9fd6);border:3px solid ' + (attivoN ? 'var(--brand)' : 'transparent');
        bN.textContent = 'Gradiente'; bN.title = 'Nessuna foto: gradiente brand';
        bN.addEventListener('click', () => { s.sfondo = null; segnaSporco(); renderSfondiCorrenti(); ridisegna(); });
        const lN = document.createElement('div'); lN.className = 'muted'; lN.style.fontSize = '10px'; lN.textContent = 'Senza foto';
        nessuno.append(bN, lN); box.appendChild(nessuno);
    }

    {% if unsplash_configurato %}
    async function cercaUnsplash() {
        const q = $('unsplash-q').value.trim(); if (!q) return;
        const box = $('unsplash-risultati');
        box.innerHTML = '<span class="muted" style="font-size:12px">Ricerca…</span>';
        try {
            const r = await fetch(URLS.unsplashSearch + '?orientation=portrait&per_page=12&q=' + encodeURIComponent(q));
            if (!r.ok) { box.innerHTML = '<span class="muted" style="font-size:12px">Ricerca non disponibile (limite orario o chiave).</span>'; return; }
            const data = await r.json();
            const risultati = data.results || [];
            box.innerHTML = '';
            if (!risultati.length) { box.innerHTML = '<span class="muted" style="font-size:12px">Nessun risultato.</span>'; return; }
            risultati.forEach(foto => {
                const img = document.createElement('img');
                img.src = foto.urls.thumb || foto.urls.small;
                img.title = 'Foto di ' + (foto.credit ? foto.credit.name : 'Unsplash');
                img.style.cssText = 'width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:6px;cursor:pointer;border:2px solid transparent;background:' + (foto.color || '#eee');
                img.addEventListener('click', () => scegliUnsplash(foto, img));
                box.appendChild(img);
            });
        } catch (e) { box.innerHTML = '<span class="muted" style="font-size:12px">Errore di ricerca.</span>'; }
    }

    async function scegliUnsplash(foto, img) {
        document.querySelectorAll('#unsplash-risultati img').forEach(i => i.style.borderColor = 'transparent');
        img.style.borderColor = 'var(--brand)';
        const statoBox = $('unsplash-stato');
        statoBox.textContent = 'Download foto…';
        try {
            const sel = await fetch(URLS.unsplashSelect, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: foto.id }),
            });
            const dSel = await sel.json();
            const credit = (dSel.photo && dSel.photo.credit) || foto.credit || {};
            const r = await fetch(URLS.sfondo, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
                body: JSON.stringify({
                    url: dSel.download_url || foto.urls.full,
                    fotografo: credit.name || '',
                    fotografoUrl: credit.profile_url || '',
                }),
            });
            const data = await r.json();
            if (!r.ok || !data.file) { statoBox.textContent = data.error || 'Download non riuscito.'; return; }
            slide().sfondo = { file: data.file, fotografo: data.fotografo, fotografoUrl: data.fotografoUrl };
            statoBox.textContent = 'Sfondo impostato: foto di ' + (credit.name || 'Unsplash') + '.';
            segnaSporco(); renderSfondiCorrenti(); ridisegna();
        } catch (e) { statoBox.textContent = 'Errore durante il download.'; }
    }

    $('unsplash-cerca').addEventListener('click', cercaUnsplash);
    $('unsplash-q').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); cercaUnsplash(); } });
    {% endif %}

    /* ---------- Caption ---------- */
    const txtCaption = $('txt-caption'), selTono = $('sel-tono');
    txtCaption.value = stato.caption.testo || '';
    selTono.value = stato.caption.tono || 'professionale';
    function aggiornaContatore() {
        const n = txtCaption.value.length;
        $('caption-contatore').textContent = n + ' / 2200 · le prime 125 battute sono quelle visibili nel feed';
        $('caption-contatore').style.color = n > 2200 ? 'var(--danger)' : '';
    }
    txtCaption.addEventListener('input', () => { stato.caption.testo = txtCaption.value; segnaSporco(); aggiornaContatore(); });
    selTono.addEventListener('change', () => { stato.caption.tono = selTono.value; segnaSporco(); });

    $('btn-genera-caption').addEventListener('click', async () => {
        const b = $('btn-genera-caption'); b.disabled = true; b.textContent = '… genero';
        try {
            const righe = righeDaId(stato.caption.righe).filter(r => r.argomento || r.testo);
            const varianti = variantiDaId(stato.caption.varianti)
                .filter(v => (v.valore || '').trim())
                .map(v => ({ campo: etichettaCampo(v), valore: v.valore, prezzo: v.prezzo || '' }));
            const r = await fetch(URLS.caption, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tono: selTono.value, righe, varianti, claim: $('inp-claim').value }),
            });
            const data = await r.json();
            if (data.caption) { txtCaption.value = data.caption; stato.caption.testo = data.caption; segnaSporco(); aggiornaContatore(); }
        } catch (e) { alert('Generazione non riuscita.'); }
        b.disabled = false; b.textContent = '✨ Genera';
    });

    $('btn-copia-caption').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(txtCaption.value); $('btn-copia-caption').textContent = '✓ Copiata'; }
        catch (e) { txtCaption.select(); document.execCommand('copy'); $('btn-copia-caption').textContent = '✓ Copiata'; }
        setTimeout(() => $('btn-copia-caption').textContent = '📋 Copia', 1500);
    });

    /* ---------- Export PNG ---------- */
    function scaricaCanvas(cv, nome) {
        const a = document.createElement('a');
        a.download = nome; a.href = cv.toDataURL('image/png');
        a.click();
    }
    function slugOfferta() {
        return (OFFERTA.titolo || 'offerta').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
    $('btn-png').addEventListener('click', async () => {
        await disegna(slide(), ctx);
        scaricaCanvas(canvas, slugOfferta() + '-slide-' + (corrente + 1) + '.png');
    });
    $('btn-png-tutte').addEventListener('click', async () => {
        const off = document.createElement('canvas');
        off.width = 1080; off.height = 1440;
        const octx = off.getContext('2d');
        for (let i = 0; i < stato.slides.length; i++) {
            await disegna(stato.slides[i], octx);
            scaricaCanvas(off, slugOfferta() + '-slide-' + (i + 1) + '.png');
            await new Promise(res => setTimeout(res, 400)); // il browser ha bisogno di respiro tra i download
        }
    });

    /* ---------- Salvataggio ---------- */
    $('btn-salva').addEventListener('click', async () => {
        const b = $('btn-salva'); b.disabled = true;
        try {
            const r = await fetch(URLS.salva, {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
                body: JSON.stringify({ claim: $('inp-claim').value, impaginato: stato }),
            });
            if (r.ok) { sporco = false; $('stato-salvataggio').textContent = 'Salvato ✓'; }
            else { const d = await r.json(); alert(d.error || 'Salvataggio non riuscito.'); }
        } catch (e) { alert('Salvataggio non riuscito.'); }
        b.disabled = false;
    });
    window.addEventListener('beforeunload', e => { if (sporco) { e.preventDefault(); e.returnValue = ''; } });

    /* ---------- Avvio ---------- */
    function renderTutto() {
        renderTabs();
        const m = slide().mostra;
        Object.entries(chk).forEach(([k, el]) => el.checked = !!m[k]);
        renderRighe();
        renderVarianti();
        renderSfondiCorrenti();
        ridisegna();
    }
    aggiornaContatore();
    renderTutto();
})();
</script>
{% endblock %}
