{% extends 'app.html.twig' %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{% block main %}
<div class="card" style="max-width:760px"><div class="card-pad">
    {{ form_start(form, {attr: {id: 'form-offerta'}}) }}

    <div class="tabs" role="tablist">
        <button type="button" class="tab-btn is-active" data-tab="generale">Generale</button>
        <button type="button" class="tab-btn" data-tab="caratteristiche">Caratteristiche</button>
        <button type="button" class="tab-btn" data-tab="offerta">Offerta</button>
        <button type="button" class="tab-btn" data-tab="info">Info utili</button>
    </div>

    {# ---------- GENERALE ---------- #}
    <section class="tab-panel" data-panel="generale">
        {{ form_row(form.titolo) }}
        {{ form_row(form.sottotitolo) }}
        {{ form_row(form.claim) }}

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.destinazioneMacro) }}
            {{ form_row(form.destinazioneMicro) }}
        </div>

        {{ include('_partials/_chip_picker.html.twig', {
            name: 'tipologie',
            label: 'Tipologia di viaggio',
            scelte: tipologie_scelte,
            selezionati: offerta.tipologie,
            placeholder: 'Aggiungi una tipologia…',
        }) }}
        {{ include('_partials/_chip_picker.html.twig', {
            name: 'temi',
            label: 'Tema / occasione',
            scelte: temi_scelte,
            selezionati: offerta.temi,
            placeholder: 'Aggiungi un tema…',
        }) }}

        {{ include('_partials/_image_picker.html.twig', {
            form: form,
            unsplash_configurato: unsplash_configurato,
            immagine_corrente: offerta.immagineFile ? asset('uploads/destinazioni/' ~ offerta.immagineFile) : null,
            fotografo: offerta.fotografoEffettivo,
            fotografoUrl: offerta.fotografoUrlEffettivo,
        }) }}

        {{ form_row(form.destinazione) }}
        {{ form_row(form.descrizione) }}
    </section>

    {# ---------- CARATTERISTICHE (Fase B) ---------- #}
    <section class="tab-panel" data-panel="caratteristiche" hidden>
        {{ include('offerta/_caratteristiche.html.twig', {
            form: form,
            offerta: offerta,
            tipologia_alloggio_scelte: tipologia_alloggio_scelte,
            stelle_scelte: stelle_scelte,
            trattamento_scelte: trattamento_scelte,
            assicurazioni_scelte: assicurazioni_scelte,
        }) }}
        <div class="section-hint">Voli, treni, navi, trasferimenti ed extra: in arrivo.</div>
    </section>

    {# ---------- OFFERTA (economics) ---------- #}
    <section class="tab-panel" data-panel="offerta" hidden>
        {{ include('_partials/_righe_editor.html.twig', {offerta: offerta}) }}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.prezzoDa) }}
            {{ form_row(form.durata) }}
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.validoDal) }}
            {{ form_row(form.validoAl) }}
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
            {{ form_widget(form.attiva) }} Offerta attiva (visibile nel catalogo)
        </label>
    </section>

    {# ---------- INFO UTILI (Fase D) ---------- #}
    <section class="tab-panel" data-panel="info" hidden>
        <div class="section-hint">Clima nel periodo, dress code e usi locali: in arrivo.</div>
    </section>

    {{ form_end(form) }}

    {# form di eliminazione: separato (NON annidato nel form principale) #}
    <div style="margin-top:18px;display:flex;gap:10px;justify-content:space-between">
        <div style="display:flex;gap:10px">
            <button type="submit" form="form-offerta" class="btn btn-primary">Salva</button>
            <a class="btn" href="{{ path('app_offerta_index') }}">Annulla</a>
        </div>
        {% if offerta.id %}
            <form method="post" action="{{ path('app_offerta_elimina', {id: offerta.id}) }}" onsubmit="return confirm('Eliminare l\'offerta?')">
                <input type="hidden" name="_token" value="{{ csrf_token('offerta_elimina_' ~ offerta.id) }}">
                <button class="btn" style="color:var(--danger)">Elimina</button>
            </form>
        {% endif %}
    </div>
</div></div>

{{ include('_partials/_chip_picker_js.html.twig') }}
<script>
(function () {
    var tabs = document.querySelectorAll('.tab-btn');
    var panels = document.querySelectorAll('.tab-panel');
    tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
            tabs.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
            panels.forEach(function (p) { p.hidden = (p.dataset.panel !== btn.dataset.tab); });
        });
    });
})();
</script>
{% endblock %}
