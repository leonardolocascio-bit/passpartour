{% extends 'app.html.twig' %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{% block main %}
<div class="card" style="max-width:760px"><div class="card-pad">
    {{ form_start(form, {attr: {id: 'form-offerta'}}) }}

    <div class="tabs" role="tablist">
        <button type="button" class="tab-btn is-active" data-tab="generale">Generale</button>
        <button type="button" class="tab-btn" data-tab="caratteristiche">Caratteristiche</button>
        <button type="button" class="tab-btn" data-tab="itinerario">Itinerario</button>
        <button type="button" class="tab-btn" data-tab="offerta">Offerta</button>
        <button type="button" class="tab-btn" data-tab="info">Info utili</button>
        {% if offerta.id %}
            <a class="tab-btn tab-link" href="{{ path('app_offerta_impaginatore', {id: offerta.id}) }}">Impaginatore ↗</a>
            <a class="tab-btn tab-link" href="{{ path('app_offerta_anteprima', {id: offerta.id}) }}" target="_blank">Anteprima ↗</a>
        {% endif %}
    </div>

    {# ---------- GENERALE ---------- #}
    <section class="tab-panel" data-panel="generale">
        {{ form_row(form.titolo) }}
        {{ form_row(form.sottotitolo) }}
        {{ form_row(form.claim) }}

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.destinazioneMacro) }}
            {{ form_row(form.destinazioneMicro) }}
        </div>

        {{ include('_partials/_chip_picker.html.twig', {
            name: 'tipologie',
            label: 'Tipologia di viaggio',
            scelte: tipologie_scelte,
            selezionati: offerta.tipologie,
            placeholder: 'Aggiungi una tipologia…',
        }) }}
        {{ include('_partials/_chip_picker.html.twig', {
            name: 'temi',
            label: 'Tema / occasione',
            scelte: temi_scelte,
            selezionati: offerta.temi,
            placeholder: 'Aggiungi un tema…',
        }) }}

        {{ include('_partials/_image_picker.html.twig', {
            form: form,
            unsplash_configurato: unsplash_configurato,
            immagine_corrente: offerta.immagineFile ? asset('uploads/destinazioni/' ~ offerta.immagineFile) : null,
            fotografo: offerta.fotografoEffettivo,
            fotografoUrl: offerta.fotografoUrlEffettivo,
        }) }}

        {{ form_row(form.destinazione) }}
        {{ form_row(form.descrizione) }}
    </section>

    {# ---------- CARATTERISTICHE (Fase B) ---------- #}
    <section class="tab-panel" data-panel="caratteristiche" hidden>
        {{ include('offerta/_caratteristiche.html.twig', {
            form: form,
            offerta: offerta,
            tipologia_alloggio_scelte: tipologia_alloggio_scelte,
            stelle_scelte: stelle_scelte,
            trattamento_scelte: trattamento_scelte,
            assicurazioni_scelte: assicurazioni_scelte,
            extra_scelte: extra_scelte,
        }) }}
    </section>

    {# ---------- ITINERARIO (tab a sé, per tutte le offerte) ---------- #}
    <section class="tab-panel" data-panel="itinerario" hidden>
        <p class="muted" style="font-size:13px;margin:0">Componi l'itinerario giorno per giorno. Eredita le caratteristiche del viaggio (voli, tappe, alloggio) e le organizza in tappe pubblicabili su web, social e stampa.</p>
        {{ include('_partials/_segmenti_editor.html.twig', {
            name: 'itinerario',
            label: 'Tappe dell\'itinerario',
            dati: offerta.itinerario,
            add_label: 'Tappa',
            hint: 'Giorno, porto/città, orari e descrizione.',
            campi: [
                {key: 'giorno', label: 'Giorno', type: 'text', placeholder: 'es. Giorno 1'},
                {key: 'luogo', label: 'Porto / città', type: 'text'},
                {key: 'arrivo', label: 'Arrivo', type: 'text', placeholder: 'es. 08:00'},
                {key: 'partenza', label: 'Partenza', type: 'text', placeholder: 'es. 18:00'},
                {key: 'descrizione', label: 'Descrizione', type: 'textarea'},
            ],
        }) }}
    </section>

    {# ---------- OFFERTA (economics) ---------- #}
    <section class="tab-panel" data-panel="offerta" hidden>
        {# Quota di vendita (IVA inclusa) #}
        <fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
            <legend style="font-weight:700;padding:0 6px">Quota</legend>
            <p class="muted" style="font-size:12px;margin:0 0 10px">Le quote si intendono IVA inclusa.</p>
            <div style="display:grid;grid-template-columns:160px 1fr;gap:14px;align-items:end">
                {{ form_row(form.valuta) }}
                {{ form_row(form.supplementoSingola) }}
            </div>
            {{ include('_partials/_segmenti_editor.html.twig', {
                name: 'quote',
                label: 'Quote',
                dati: offerta.quote,
                add_label: 'Quota',
                hint: 'Es. «Per persona · doppia · 1990». Aggiungine una per ogni combinazione.',
                campi: [
                    {key: 'tipo', label: 'Riferimento', type: 'select', options: {persona: 'Per persona', gruppo: 'Quota gruppo'}},
                    {key: 'sistemazione', label: 'Sistemazione', type: 'datalist', options: ['In doppia', 'In tripla', 'In singola', 'In quadrupla']},
                    {key: 'importo', label: 'Importo', type: 'text'},
                ],
            }) }}
        </fieldset>

        {# Costi / MOL — dato interno all'operatore #}
        {% set co = offerta.costi %}
        <fieldset style="border:1px solid var(--amber);border-radius:10px;padding:14px;margin:0;background:#fffdf6">
            <legend style="font-weight:700;padding:0 6px">Costi e margine (MOL)</legend>
            <p class="muted" style="font-size:12px;margin:0 0 12px">🔒 Dato interno: non pubblicare su web o social.</p>
            <div style="display:grid;gap:12px">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label for="co_quota">Quota di vendita (su cui calcolare il margine)</label>
                        <input type="text" id="co_quota" name="costi[quotaVendita]" inputmode="decimal" value="{{ co.quotaVendita|default('') }}" placeholder="es. 1990">
                    </div>
                    <div>
                        <label for="co_tipo">Modalità</label>
                        <select id="co_tipo" name="costi[tipo]" data-costi-tipo>
                            <option value="">—</option>
                            <option value="netta"{{ (co.tipo|default('')) == 'netta' ? ' selected' }}>Quota netta</option>
                            <option value="commissionabile"{{ (co.tipo|default('')) == 'commissionabile' ? ' selected' }}>Commissionabile</option>
                        </select>
                    </div>
                </div>

                <div data-costi-netta style="{{ (co.tipo|default('')) == 'netta' ? '' : 'display:none' }}">
                    <label for="co_netta">Quota netta (costo fornitore)</label>
                    <input type="text" id="co_netta" name="costi[quotaNetta]" inputmode="decimal" value="{{ co.quotaNetta|default('') }}" placeholder="es. 1650">
                </div>

                <div data-costi-comm style="{{ (co.tipo|default('')) == 'commissionabile' ? '' : 'display:none' }}">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                        <div>
                            <label for="co_modo">Commissione</label>
                            <select id="co_modo" name="costi[commissioneModo]">
                                <option value="percentuale"{{ (co.commissioneModo|default('percentuale')) == 'percentuale' ? ' selected' }}>Percentuale (%)</option>
                                <option value="fisso"{{ (co.commissioneModo|default('')) == 'fisso' ? ' selected' }}>Importo fisso</option>
                            </select>
                        </div>
                        <div>
                            <label for="co_valore">Valore</label>
                            <input type="text" id="co_valore" name="costi[commissioneValore]" inputmode="decimal" value="{{ co.commissioneValore|default('') }}" placeholder="es. 12 (%) o 200 (€)">
                        </div>
                    </div>
                </div>

                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
                    <input type="checkbox" name="costi[nettaLordoIva]" value="1"{{ co.nettaLordoIva|default(false) ? ' checked' }}> L'importo della commissione è a lordo IVA (da scorporare)
                </label>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label for="co_iva">IVA %</label>
                        <input type="text" id="co_iva" name="costi[ivaPercentuale]" inputmode="decimal" value="{{ co.ivaPercentuale|default('22') }}">
                    </div>
                    <div>
                        <label for="co_rit">Ritenuta d'acconto % (facoltativa)</label>
                        <input type="text" id="co_rit" name="costi[ritenutaPercentuale]" inputmode="decimal" value="{{ co.ritenutaPercentuale|default('') }}">
                    </div>
                </div>

                {% if margine %}
                    <div style="border-top:1px solid var(--line);padding-top:10px;font-size:13px;display:grid;gap:4px">
                        <div style="display:flex;justify-content:space-between"><span class="muted">Commissione lorda</span><strong>{{ offerta.valuta }} {{ margine.commissioneLorda|number_format(2, ',', '.') }}</strong></div>
                        <div style="display:flex;justify-content:space-between"><span class="muted">IVA ({{ margine.ivaPercentuale|number_format(0, ',', '.') }}%)</span><span>{{ offerta.valuta }} {{ margine.iva|number_format(2, ',', '.') }}</span></div>
                        {% if margine.ritenutaPercentuale > 0 %}
                            <div style="display:flex;justify-content:space-between"><span class="muted">Ritenuta d'acconto ({{ margine.ritenutaPercentuale|number_format(0, ',', '.') }}%)</span><span>−{{ offerta.valuta }} {{ margine.ritenuta|number_format(2, ',', '.') }}</span></div>
                        {% endif %}
                        <div style="display:flex;justify-content:space-between;font-size:15px;margin-top:2px"><strong>MOL (imponibile)</strong><strong style="color:var(--ok)">{{ offerta.valuta }} {{ margine.imponibile|number_format(2, ',', '.') }}</strong></div>
                        {% if margine.ritenutaPercentuale > 0 %}
                            <div style="display:flex;justify-content:space-between"><span class="muted">Netto dopo ritenuta</span><span>{{ offerta.valuta }} {{ margine.nettoDopoRitenuta|number_format(2, ',', '.') }}</span></div>
                        {% endif %}
                        <p class="muted" style="font-size:11px;margin:4px 0 0">Ricalcolato al salvataggio.</p>
                    </div>
                {% else %}
                    <p class="muted" style="font-size:12px;margin:0">Compila quota di vendita e modalità per vedere il MOL (al salvataggio).</p>
                {% endif %}
            </div>
        </fieldset>

        {# Badge commerciali #}
        <fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
            <legend style="font-weight:700;padding:0 6px">Badge</legend>
            <div style="display:grid;gap:10px">
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.earlyBooking) }} Early booking</label>
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.lastMinute) }} Last minute</label>
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.cancellazioneGratuita) }} Cancellazione gratuita</label>
                <div style="max-width:280px">{{ form_row(form.cancellazioneEntroGiorni) }}</div>
            </div>
        </fieldset>

        {{ include('_partials/_righe_editor.html.twig', {offerta: offerta}) }}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.prezzoDa) }}
            {{ form_row(form.durata) }}
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.validoDal) }}
            {{ form_row(form.validoAl) }}
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
            {{ form_widget(form.attiva) }} Offerta attiva (visibile nel catalogo)
        </label>
    </section>

    {# ---------- INFO UTILI (Fase D) ---------- #}
    <section class="tab-panel" data-panel="info" hidden>
        <div class="section-hint">Clima nel periodo, dress code e usi locali: in arrivo.</div>
    </section>

    {{ form_end(form) }}

    {# form di eliminazione: separato (NON annidato nel form principale) #}
    <div style="margin-top:18px;display:flex;gap:10px;justify-content:space-between">
        <div style="display:flex;gap:10px">
            <button type="submit" form="form-offerta" class="btn btn-primary">Salva</button>
            <a class="btn" href="{{ path('app_offerta_index') }}">Annulla</a>
        </div>
        {% if offerta.id %}
            <form method="post" action="{{ path('app_offerta_elimina', {id: offerta.id}) }}" onsubmit="return confirm('Eliminare l\'offerta?')">
                <input type="hidden" name="_token" value="{{ csrf_token('offerta_elimina_' ~ offerta.id) }}">
                <button class="btn" style="color:var(--danger)">Elimina</button>
            </form>
        {% endif %}
    </div>
</div></div>

{{ include('_partials/_chip_picker_js.html.twig') }}
{{ include('_partials/_segmenti_editor_js.html.twig') }}
<script>
(function () {
    // bagaglio: mostra numero/kg quando la relativa casella è spuntata
    document.querySelectorAll('[data-bag-toggle]').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var box = document.getElementById(cb.dataset.bagToggle);
            if (box) box.style.display = cb.checked ? 'grid' : 'none';
        });
    });

    // costi: mostra i campi in base alla modalità (netta / commissionabile)
    var tipoSel = document.querySelector('[data-costi-tipo]');
    if (tipoSel) {
        var netta = document.querySelector('[data-costi-netta]');
        var comm = document.querySelector('[data-costi-comm]');
        var aggiorna = function () {
            if (netta) netta.style.display = tipoSel.value === 'netta' ? 'block' : 'none';
            if (comm) comm.style.display = tipoSel.value === 'commissionabile' ? 'block' : 'none';
        };
        tipoSel.addEventListener('change', aggiorna);
        aggiorna();
    }
})();
(function () {
    var tabs = document.querySelectorAll('.tab-btn:not(.tab-link)');
    var panels = document.querySelectorAll('.tab-panel');
    tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
            tabs.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
            panels.forEach(function (p) { p.hidden = (p.dataset.panel !== btn.dataset.tab); });
        });
    });
})();
</script>
{% endblock %}
