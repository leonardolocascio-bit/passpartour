{% extends 'app.html.twig' %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{% block main %}
<div class="card" style="max-width:760px"><div class="card-pad">
    {{ form_start(form, {attr: {id: 'form-offerta'}}) }}

    <div class="tabs" role="tablist">
        <button type="button" class="tab-btn is-active" data-tab="generale">Generale</button>
        <button type="button" class="tab-btn" data-tab="caratteristiche">Caratteristiche</button>
        <button type="button" class="tab-btn" data-tab="itinerario">Itinerario</button>
        <button type="button" class="tab-btn" data-tab="offerta">Offerta</button>
        <button type="button" class="tab-btn" data-tab="info">Info utili</button>
        {% if offerta.id %}
            {# post social e stampa si fanno nel Creator Studio; qui resta l'anteprima web #}
            <a class="tab-btn tab-link" href="{{ path('app_offerta_anteprima', {id: offerta.id}) }}" target="_blank">Anteprima ↗</a>
        {% endif %}
    </div>

    {# ---------- GENERALE ---------- #}
    <section class="tab-panel" data-panel="generale">
        {{ include('_partials/_import_link.html.twig') }}
        {{ form_row(form.titolo) }}
        {{ form_row(form.sottotitolo) }}
        {{ form_row(form.claim) }}

        {# ordine richiesto: tema → tipologia → destinazione #}
        {{ include('_partials/_chip_picker.html.twig', {
            name: 'temi',
            label: 'Tema / occasione',
            scelte: temi_scelte,
            selezionati: offerta.temi,
            placeholder: 'Aggiungi un tema…',
        }) }}
        <p class="muted" style="font-size:12px;margin:-6px 0 12px">Un tema nuovo crea anche la sua scheda in Portale → Temi (e quindi la sezione sul sito).</p>
        {{ include('_partials/_chip_picker.html.twig', {
            name: 'tipologie',
            label: 'Tipologia di viaggio',
            scelte: tipologie_scelte,
            selezionati: offerta.tipologie,
            placeholder: 'Aggiungi una tipologia…',
        }) }}

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.destinazioneMacro) }}
            {{ form_row(form.destinazioneMicro) }}
        </div>
        <datalist id="lista-destinazioni">
            {% for n in destinazioni_nomi %}<option value="{{ n }}">{% endfor %}
        </datalist>
        <p class="muted" style="font-size:12px;margin:-6px 0 12px">Se il nome combacia con una voce di Portale → Destinazioni, l'offerta viene collegata (immagine inclusa).</p>

        {{ form_row(form.tourOperator) }}

        {{ include('_partials/_image_picker.html.twig', {
            form: form,
            unsplash_configurato: unsplash_configurato,
            immagine_corrente: offerta.immagineFile ? asset('uploads/destinazioni/' ~ offerta.immagineFile) : null,
            fotografo: offerta.fotografoEffettivo,
            fotografoUrl: offerta.fotografoUrlEffettivo,
        }) }}

        {{ form_row(form.descrizione) }}
    </section>

    {# ---------- CARATTERISTICHE (Fase B) ---------- #}
    <section class="tab-panel" data-panel="caratteristiche" hidden>
        {{ include('offerta/_caratteristiche.html.twig', {
            form: form,
            offerta: offerta,
            tipologia_alloggio_scelte: tipologia_alloggio_scelte,
            stelle_scelte: stelle_scelte,
            trattamento_scelte: trattamento_scelte,
            assicurazioni_scelte: assicurazioni_scelte,
            extra_scelte: extra_scelte,
        }) }}
    </section>

    {# ---------- ITINERARIO (tab a sé, per tutte le offerte) ---------- #}
    <section class="tab-panel" data-panel="itinerario" hidden>
        <p class="muted" style="font-size:13px;margin:0">Componi l'itinerario giorno per giorno. Eredita le caratteristiche del viaggio (voli, tappe, alloggio) e le organizza in tappe pubblicabili su web, social e stampa.</p>
        {{ include('_partials/_segmenti_editor.html.twig', {
            name: 'itinerario',
            label: 'Tappe dell\'itinerario',
            dati: offerta.itinerario,
            add_label: 'Tappa',
            hint: 'Giorno, porto/città, orari e descrizione.',
            campi: [
                {key: 'giorno', label: 'Giorno', type: 'text', placeholder: 'es. Giorno 1, o Giorni 2–3'},
                {key: 'luogo', label: 'Porto / città', type: 'text'},
                {key: 'arrivo', label: 'Arrivo', type: 'text', placeholder: 'es. 08:00 (vuoto = stay)'},
                {key: 'partenza', label: 'Partenza', type: 'text', placeholder: 'es. 18:00 (vuoto = stay)'},
                {key: 'descrizione', label: 'Descrizione', type: 'textarea'},
            ],
        }) }}
    </section>

    {# ---------- OFFERTA (economics) ---------- #}
    <section class="tab-panel" data-panel="offerta" hidden>
        {# Quota di vendita (IVA inclusa) #}
        <fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
            <legend style="font-weight:700;padding:0 6px">Quota</legend>
            <p class="muted" style="font-size:12px;margin:0 0 10px">Le quote si intendono IVA inclusa.</p>
            <div style="display:grid;grid-template-columns:160px;gap:14px;align-items:end">
                {{ form_row(form.valuta) }}
            </div>
            {{ include('_partials/_segmenti_editor.html.twig', {
                name: 'quote',
                label: 'Quote',
                dati: offerta.quote,
                add_label: 'Quota',
                hint: 'Es. «Per persona · doppia · 1990». Aggiungine una per ogni combinazione.',
                campi: [
                    {key: 'tipo', label: 'Riferimento', type: 'select', options: {persona: 'Per persona', gruppo: 'Quota gruppo'}},
                    {key: 'sistemazione', label: 'Sistemazione', type: 'datalist', options: ['In doppia', 'In tripla', 'In singola', 'In quadrupla']},
                    {key: 'importo', label: 'Prezzo di vendita', type: 'text'},
                    {key: 'modo', label: 'Costo (interno)', type: 'select', options: {netta: 'Quota netta (importo)', commissionabile: 'Commissionabile (%)'}},
                    {key: 'costo', label: 'Netto o %', type: 'text'},
                ],
            }) }}
            <p class="muted" style="font-size:12px;margin:6px 0 0">Il «prezzo a partire da» si ricava in automatico dalla quota più bassa. Costo e % sono dati interni (MOL qui sotto).</p>
            {# il supplemento singola viene DOPO le quote #}
            <div style="margin-top:12px;max-width:260px">
                {{ form_row(form.supplementoSingola) }}
            </div>
        </fieldset>

        {# Costi / MOL — dato interno all'operatore #}
        {% set co = offerta.costi %}
        <fieldset style="border:1px solid var(--amber);border-radius:10px;padding:14px;margin:0;background:#fffdf6">
            <legend style="font-weight:700;padding:0 6px">Costi e margine (MOL)</legend>
            <p class="muted" style="font-size:12px;margin:0 0 12px">🔒 Dato interno: non pubblicare su web o social.</p>
            <div style="display:grid;gap:12px">
                <p class="muted" style="font-size:12px;margin:0">Il costo si imposta su ogni quota (netta o commissionabile). Qui restano le aliquote comuni.</p>
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
                    <input type="checkbox" name="costi[nettaLordoIva]" value="1"{{ co.nettaLordoIva|default(false) ? ' checked' }}> L'importo della commissione è a lordo IVA (da scorporare)
                </label>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div>
                        <label for="co_iva">IVA %</label>
                        <input type="text" id="co_iva" name="costi[ivaPercentuale]" inputmode="decimal" value="{{ co.ivaPercentuale|default('22') }}">
                    </div>
                    <div>
                        <label for="co_rit">Ritenuta d'acconto % (facoltativa)</label>
                        <input type="text" id="co_rit" name="costi[ritenutaPercentuale]" inputmode="decimal" value="{{ co.ritenutaPercentuale|default('') }}">
                    </div>
                </div>

                {% if margini_quote|filter(m => m.dettaglio) is not empty %}
                    <div style="border-top:1px solid var(--line);padding-top:10px;font-size:13px;display:grid;gap:8px">
                        {% for m in margini_quote %}
                            <div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline">
                                <span>{{ m.etichetta }} · <strong>{{ offerta.valuta }} {{ m.prezzo|number_format(2, ',', '.') }}</strong></span>
                                {% if m.dettaglio %}
                                    <span>MOL <strong style="color:var(--ok)">{{ offerta.valuta }} {{ m.dettaglio.imponibile|number_format(2, ',', '.') }}</strong>
                                        <span class="muted" style="font-size:11px">(comm. {{ m.dettaglio.commissioneLorda|number_format(2, ',', '.') }}{% if m.dettaglio.ritenutaPercentuale > 0 %} · netto {{ m.dettaglio.nettoDopoRitenuta|number_format(2, ',', '.') }}{% endif %})</span></span>
                                {% else %}
                                    <span class="muted" style="font-size:12px">costo non indicato</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                        <p class="muted" style="font-size:11px;margin:0">Ricalcolato al salvataggio.</p>
                    </div>
                {% else %}
                    <p class="muted" style="font-size:12px;margin:0">Imposta costo (netta o %) sulle quote per vedere il MOL al salvataggio.</p>
                {% endif %}
            </div>
        </fieldset>

        {# Badge commerciali #}
        <fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
            <legend style="font-weight:700;padding:0 6px">Badge</legend>
            <div style="display:grid;gap:10px">
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.earlyBooking) }} Early booking</label>
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.lastMinute) }} Last minute</label>
                <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">{{ form_widget(form.cancellazioneGratuita) }} Cancellazione gratuita</label>
                <div style="max-width:280px">{{ form_row(form.cancellazioneEntroGiorni) }}</div>
            </div>
        </fieldset>

        {{ include('_partials/_righe_editor.html.twig', {offerta: offerta}) }}
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.durata) }}
            <div>
                <label style="visibility:hidden">Prezzo da</label>
                <p class="muted" style="font-size:12px;margin:8px 0 0">Prezzo «a partire da»: {{ offerta.prezzoDa ? offerta.valuta ~ ' ' ~ offerta.prezzoDa|number_format(0, ',', '.') : 'si ricava dalle quote' }}.</p>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            {{ form_row(form.validoDal) }}
            {{ form_row(form.validoAl) }}
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
            {{ form_widget(form.attiva) }} Offerta attiva (visibile nel catalogo)
        </label>
    </section>

    {# ---------- INFO UTILI (Fase D) ---------- #}
    <section class="tab-panel" data-panel="info" hidden>
        {% set iu = offerta.infoUtili %}
        <p class="muted" style="font-size:13px;margin:0 0 12px">Clima nel periodo, dress code e usi locali della destinazione. «Genera» compila una bozza (AI se configurata): sempre modificabile a mano prima di salvare.</p>
        <div style="display:flex;justify-content:flex-end;margin-bottom:10px">
            <button type="button" class="btn" id="btn-info-genera" data-url="{{ path('app_offerta_info_genera') }}">✨ Genera automaticamente</button>
        </div>
        <div style="display:grid;gap:14px">
            <div>
                <label for="info_clima">Meteo / clima nel periodo</label>
                <textarea id="info_clima" name="info_clima" rows="3">{{ iu.clima|default('') }}</textarea>
            </div>
            <div>
                <label for="info_dresscode">Dress code / come vestirsi</label>
                <textarea id="info_dresscode" name="info_dresscode" rows="3">{{ iu.dressCode|default('') }}</textarea>
            </div>
            <div>
                <label for="info_usilocali">Usi locali e consigli pratici</label>
                <textarea id="info_usilocali" name="info_usilocali" rows="3">{{ iu.usiLocali|default('') }}</textarea>
            </div>
        </div>
    </section>

    {{ form_end(form) }}

    {# form di eliminazione: separato (NON annidato nel form principale) #}
    <div style="margin-top:18px;display:flex;gap:10px;justify-content:space-between">
        <div style="display:flex;gap:10px">
            <button type="submit" form="form-offerta" class="btn btn-primary">Salva</button>
            <a class="btn" href="{{ path('app_offerta_index') }}">Annulla</a>
        </div>
        {% if offerta.id %}
            <form method="post" action="{{ path('app_offerta_elimina', {id: offerta.id}) }}" onsubmit="return confirm('Eliminare l\'offerta?')">
                <input type="hidden" name="_token" value="{{ csrf_token('offerta_elimina_' ~ offerta.id) }}">
                <button class="btn" style="color:var(--danger)">Elimina</button>
            </form>
        {% endif %}
    </div>
</div></div>

{{ include('_partials/_chip_picker_js.html.twig') }}
{{ include('_partials/_segmenti_editor_js.html.twig') }}
<script>
(function () {
    // bagaglio: mostra numero/kg quando la relativa casella è spuntata
    document.querySelectorAll('[data-bag-toggle]').forEach(function (cb) {
        cb.addEventListener('change', function () {
            var box = document.getElementById(cb.dataset.bagToggle);
            if (box) box.style.display = cb.checked ? 'grid' : 'none';
        });
    });

    // «Genera» info utili: chiede al server una bozza per la destinazione corrente
    var btnInfo = document.getElementById('btn-info-genera');
    if (btnInfo) btnInfo.addEventListener('click', function () {
        var campo = function (nome) {
            var el = document.querySelector('[name$="[' + nome + ']"]');
            return el ? el.value : '';
        };
        btnInfo.disabled = true; btnInfo.textContent = 'Genero…';
        fetch(btnInfo.dataset.url, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({titolo: campo('titolo'), macro: campo('destinazioneMacro'), micro: campo('destinazioneMicro'), durata: campo('durata')}),
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d.clima) document.getElementById('info_clima').value = d.clima;
            if (d.dressCode) document.getElementById('info_dresscode').value = d.dressCode;
            if (d.usiLocali) document.getElementById('info_usilocali').value = d.usiLocali;
        }).finally(function () { btnInfo.disabled = false; btnInfo.textContent = '✨ Genera automaticamente'; });
    });
})();
(function () {
    var tabs = document.querySelectorAll('.tab-btn:not(.tab-link)');
    var panels = document.querySelectorAll('.tab-panel');
    function mostra(nome) {
        tabs.forEach(function (b) { b.classList.toggle('is-active', b.dataset.tab === nome); });
        panels.forEach(function (p) { p.hidden = (p.dataset.panel !== nome); });
    }
    tabs.forEach(function (btn) {
        btn.addEventListener('click', function () { mostra(btn.dataset.tab); });
    });
    // un campo obbligatorio in una scheda nascosta bloccherebbe il submit in
    // silenzio: al primo campo invalido si apre la scheda che lo contiene
    var form = document.getElementById('form-offerta');
    if (form) form.addEventListener('invalid', function (e) {
        var panel = e.target.closest('.tab-panel');
        if (panel && panel.hidden) mostra(panel.dataset.panel);
    }, true);
})();
</script>
{% endblock %}
