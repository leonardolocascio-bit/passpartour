{% extends 'app.html.twig' %}

{% block title %}{{ offerta.titolo }} · Passpartour{% endblock %}
{% block page_title %}Scheda offerta{% endblock %}

{% block main %}
<div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap">
    <a class="btn" href="{{ path('app_offerta_index') }}">← Catalogo</a>
    <a class="btn btn-primary" href="{{ path('app_offerta_invia', {id: offerta.id}) }}">✉ Invia</a>
    <a class="btn" href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">Modifica</a>
    <a class="btn" href="{{ path('app_offerta_impaginatore', {id: offerta.id}) }}">Impaginatore</a>
    <a class="btn" href="{{ path('app_offerta_stampa', {id: offerta.id, formato: 'a4v'}) }}" target="_blank">Stampa</a>
</div>

<div class="card" style="max-width:820px;overflow:hidden">
    <div style="height:220px;background:linear-gradient(135deg,var(--navy),var(--cyan));position:relative">
        {% if offerta.immagineFile %}
            <img src="{{ asset('uploads/destinazioni/' ~ offerta.immagineFile) }}" alt="{{ offerta.titolo }}" style="width:100%;height:100%;object-fit:cover;display:block">
        {% endif %}
        {% if not offerta.attiva %}<div class="badge" style="position:absolute;top:12px;left:12px">Sospesa</div>{% endif %}
        {% if offerta.fotografoEffettivo %}
            <div style="position:absolute;bottom:6px;left:12px;color:rgba(255,255,255,.9);font-size:11px">📷 {{ offerta.fotografoEffettivo }} · Unsplash</div>
        {% endif %}
    </div>
    <div class="card-pad" style="padding:22px 24px">
        <h1 style="font-size:26px;font-weight:800;margin:0;color:var(--navy)">{{ offerta.titolo }}</h1>
        {% if offerta.sottotitolo %}<div class="muted" style="font-size:15px;margin-top:2px">{{ offerta.sottotitolo }}</div>{% endif %}
        {% if offerta.claim %}<div style="color:var(--brand);font-style:italic;font-weight:600;margin-top:6px">{{ offerta.claim }}</div>{% endif %}
        <div style="margin-top:16px">
            {{ include('_partials/_scheda_offerta.html.twig', {offerta: offerta}) }}
        </div>
    </div>
</div>
{% endblock %}
