{# Scheda "Caratteristiche" dell'offerta. Va DENTRO #form-offerta.
   Parametri: form, offerta, tipologia_alloggio_scelte (list label), stelle_scelte,
   trattamento_scelte (list label), assicurazioni_scelte, extra_scelte, compagnie. #}
{# ---------- ALLOGGI (ripetibile: più strutture per tour e combinati) ---------- #}
{# tipologia/trattamento: valori storici a slug risolti in label (datalist libera) #}
{% set alloggi_editor = [] %}
{% for a in offerta.alloggi %}
    {% set alloggi_editor = alloggi_editor|merge([a|merge({
        tipologia: offerta.tipologiaAlloggioLabel(a.tipologia|default(null)) ?? '',
        trattamento: offerta.trattamentoAlloggioLabel(a.trattamento|default(null)) ?? '',
    })]) %}
{% endfor %}
{{ include('_partials/_segmenti_editor.html.twig', {
    name: 'alloggi',
    label: 'Alloggi',
    dati: alloggi_editor,
    add_label: 'Alloggio',
    hint: 'Una struttura per soggiorno (es. tour con più tappe). Tipologia e trattamento: scegli dai suggerimenti o scrivi una voce nuova (entra nei suggerimenti futuri).',
    campi: [
        {key: 'nome', label: 'Nome struttura', type: 'text', placeholder: 'Es. Katikies Suites'},
        {key: 'citta', label: 'Città', type: 'text', placeholder: 'Es. Oia'},
        {key: 'indirizzo', label: 'Indirizzo', type: 'text', placeholder: 'Via / zona'},
        {key: 'tipologia', label: 'Tipologia', type: 'datalist', options: tipologia_alloggio_scelte},
        {key: 'stelle', label: 'Stelle', type: 'select', options: stelle_scelte},
        {key: 'trattamento', label: 'Trattamento', type: 'datalist', options: trattamento_scelte},
    ],
}) }}

{# ---------- VOLI ---------- #}
{{ include('_partials/_segmenti_editor.html.twig', {
    name: 'voli',
    label: 'Voli',
    dati: offerta.voli,
    add_label: 'Volo',
    hint: 'Con «Andata e ritorno» il ritorno si ricava in automatico a tratta invertita: compila anche data e scalo del ritorno. Per gli scali indica la durata.',
    campi: [
        {key: 'tipo', label: 'Tipo', type: 'select', options: {ar: 'Andata e ritorno', andata: 'Andata', ritorno: 'Ritorno', interno: 'Interno'}},
        {key: 'da', label: 'Da', type: 'text', placeholder: 'Aeroporto / città'},
        {key: 'a', label: 'A', type: 'text', placeholder: 'Aeroporto / città'},
        {key: 'data', label: 'Data e ora andata', type: 'datetime'},
        {key: 'stay', label: 'Scalo andata (durata)', type: 'text', placeholder: 'es. 2h 30m'},
        {key: 'dataRitorno', label: 'Data e ora ritorno (A/R)', type: 'datetime'},
        {key: 'stayRitorno', label: 'Scalo ritorno (durata)', type: 'text', placeholder: 'es. 1h 45m'},
        {key: 'compagnia', label: 'Compagnia', type: 'datalist', options: compagnie.volo},
        {key: 'descrizione', label: 'Note', type: 'textarea'},
    ],
}) }}

{# ---------- BAGAGLIO ---------- #}
{% set bg = offerta.bagaglio %}
<fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
    <legend style="font-weight:700;padding:0 6px">Bagaglio</legend>
    <div style="display:grid;gap:10px">
        <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
            <input type="checkbox" name="bagaglio[borsaPiccola]" value="1"{{ bg.borsaPiccola|default(false) ? ' checked' }}> Borsa piccola (sotto il sedile)
        </label>

        <div>
            <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
                <input type="checkbox" name="bagaglio[mano]" value="1" data-bag-toggle="bag-mano"{{ bg.mano|default(false) ? ' checked' }}> Bagaglio a mano
            </label>
            <div id="bag-mano" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px{{ bg.mano|default(false) ? '' : ';display:none' }}">
                <div><label>Numero</label><input type="number" min="0" name="bagaglio[manoNum]" value="{{ bg.manoNum|default('') }}"></div>
                <div><label>Kg</label><input type="number" min="0" step="0.1" name="bagaglio[manoKg]" value="{{ bg.manoKg|default('') }}"></div>
            </div>
        </div>

        <div>
            <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
                <input type="checkbox" name="bagaglio[stiva]" value="1" data-bag-toggle="bag-stiva"{{ bg.stiva|default(false) ? ' checked' }}> Bagaglio da stiva
            </label>
            <div id="bag-stiva" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px{{ bg.stiva|default(false) ? '' : ';display:none' }}">
                <div><label>Numero</label><input type="number" min="0" name="bagaglio[stivaNum]" value="{{ bg.stivaNum|default('') }}"></div>
                <div><label>Kg</label><input type="number" min="0" step="0.1" name="bagaglio[stivaKg]" value="{{ bg.stivaKg|default('') }}"></div>
            </div>
        </div>

        <div>
            <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
                <input type="checkbox" name="bagaglio[altro]" value="1" data-bag-toggle="bag-altro"{{ bg.altro|default(false) ? ' checked' }}> Altro
            </label>
            <div id="bag-altro" style="margin-top:8px{{ bg.altro|default(false) ? '' : ';display:none' }}">
                <input type="text" name="bagaglio[altroTesto]" value="{{ bg.altroTesto|default('') }}" placeholder="es. Attrezzatura sportiva 1 × 20 kg">
            </div>
        </div>
    </div>
</fieldset>

