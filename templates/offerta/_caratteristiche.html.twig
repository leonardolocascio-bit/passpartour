{# ---------- CONDIZIONI ---------- #}
<fieldset style="border:1px solid var(--line);border-radius:10px;padding:14px;margin:0">
    <legend style="font-weight:700;padding:0 6px">Condizioni</legend>
    <div style="display:grid;gap:12px">
        <div>
            {{ form_row(form.comprende) }}
            <p class="muted" style="font-size:12px;margin:4px 0 0">Vuoto = generato in automatico dalle caratteristiche al salvataggio (poi modificabile).</p>
        </div>
        <div>
            {{ form_row(form.nonComprende) }}
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
                {% if template_testi is not empty %}
                    <select id="noncomp-template" style="max-width:260px">
                        <option value="">Richiama un template…</option>
                        {% for t in template_testi %}
                            <option value="{{ t.testo }}">{{ t.titolo }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
                <button type="button" class="btn" id="btn-noncomp-salva"
                        data-url="{{ path('app_offerta_template_testo') }}"
                        data-token="{{ csrf_token('template_testo') }}">💾 Salva come template</button>
            </div>
        </div>
    </div>
</fieldset>
<script>
(function () {
    var area = document.querySelector('[name$="[nonComprende]"]');
    var sel = document.getElementById('noncomp-template');
    if (sel && area) sel.addEventListener('change', function () {
        if (!sel.value) return;
        area.value = area.value.trim() ? area.value.replace(/\s+$/, '') + '\n' + sel.value : sel.value;
        sel.selectedIndex = 0;
    });
    var btn = document.getElementById('btn-noncomp-salva');
    if (btn && area) btn.addEventListener('click', function () {
        var testo = area.value.trim();
        if (!testo) { alert('Scrivi prima il testo da salvare.'); return; }
        var titolo = prompt('Titolo del template:');
        if (!titolo) return;
        fetch(btn.dataset.url, {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-CSRF-Token': btn.dataset.token},
            body: JSON.stringify({titolo: titolo, testo: testo}),
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d.error) { alert(d.error); return; }
            var s = sel;
            if (s) {
                var o = document.createElement('option');
                o.value = testo; o.textContent = d.titolo;
                s.appendChild(o);
            }
            btn.textContent = '✓ Template salvato';
            setTimeout(function () { btn.textContent = '💾 Salva come template'; }, 2000);
        });
    });
})();
</script>
