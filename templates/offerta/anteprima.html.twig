{% extends 'base.html.twig' %}

{% block title %}{{ offerta.titolo }} · Passpartour{% endblock %}

{% block body %}
<div style="background:#fff8f2;border-bottom:1px solid var(--line);padding:8px 16px;text-align:center;font-size:12px;color:var(--muted)">
    Anteprima — così apparirà sul sito web. <a href="{{ path('app_offerta_modifica', {id: offerta.id}) }}">Torna alla scheda</a>
</div>

<div style="max-width:920px;margin:0 auto;padding:0 16px 60px">
    {# Hero #}
    <div style="position:relative;border-radius:0 0 16px 16px;overflow:hidden;height:380px;background:linear-gradient(135deg,var(--navy),var(--cyan))">
        {% if offerta.immagineFile %}
            <img src="{{ asset('uploads/destinazioni/' ~ offerta.immagineFile) }}" alt="{{ offerta.titolo }}" style="width:100%;height:100%;object-fit:cover;display:block">
        {% endif %}
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,22,44,.15),rgba(10,22,44,.75))"></div>
        <div style="position:absolute;left:0;right:0;bottom:0;padding:28px 32px;color:#fff">
            {% if offerta.destinazioneMicro or offerta.destinazioneMacro %}
                <div style="font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.9;margin-bottom:6px">
                    {{ offerta.destinazioneMacro }}{% if offerta.destinazioneMacro and offerta.destinazioneMicro %} · {% endif %}{{ offerta.destinazioneMicro }}
                </div>
            {% endif %}
            <h1 style="margin:0;font-size:38px;font-weight:900;line-height:1.05;text-shadow:0 2px 12px rgba(0,0,0,.4)">{{ offerta.titolo }}</h1>
            {% if offerta.sottotitolo %}<div style="font-size:17px;margin-top:6px;opacity:.95">{{ offerta.sottotitolo }}</div>{% endif %}
            {% if offerta.claim %}<div style="font-style:italic;color:var(--amber);font-weight:600;margin-top:8px">{{ offerta.claim }}</div>{% endif %}
        </div>
        {% if offerta.fotografoEffettivo %}
            <div style="position:absolute;bottom:6px;right:12px;color:rgba(255,255,255,.8);font-size:11px">📷 {{ offerta.fotografoEffettivo }} · Unsplash</div>
        {% endif %}
    </div>

    {# Contenuto #}
    <div style="background:#fff;border:1px solid var(--line);border-top:none;border-radius:0 0 16px 16px;padding:28px 32px;margin-top:-2px">
        {{ include('_partials/_scheda_offerta.html.twig', {offerta: offerta}) }}

        <div style="margin-top:28px;padding-top:22px;border-top:1px solid var(--line);text-align:center">
            <div style="font-weight:700;font-size:18px;color:var(--navy)">Ti interessa questo viaggio?</div>
            <p class="muted" style="margin:6px 0 14px">Contatta la nostra agenzia: prepariamo la proposta su misura per te.</p>
            <span class="btn btn-primary" style="pointer-events:none">Richiedi informazioni</span>
        </div>
    </div>

    <div style="text-align:center;margin-top:22px">
        <img src="{{ asset('images/passpartour-color.png') }}" alt="Passpartour" style="height:34px;opacity:.8">
    </div>
</div>
{% endblock %}
