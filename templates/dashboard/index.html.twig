{% extends 'app.html.twig' %}

{% block title %}Dashboard · Passpartour{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block main %}
<div class="grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:16px">
    <div class="card stat">
        <div class="label">Lead totali</div>
        <div class="value">{{ tot_lead }}</div>
        <div class="sub">{{ aperti }} in lavorazione</div>
    </div>
    <div class="card stat">
        <div class="label">Tasso conversione</div>
        <div class="value">{{ tasso_conversione }}%</div>
        <div class="sub">su lead chiusi</div>
    </div>
    <div class="card stat">
        <div class="label">Vinti</div>
        <div class="value">{{ per_stato['vinto'] }}</div>
        <div class="sub">opportunità concluse</div>
    </div>
    <div class="card stat">
        <div class="label">Preventivi</div>
        <div class="value">{{ preventivi_attivi }}</div>
        <div class="sub">totali a sistema</div>
    </div>
</div>

<div class="grid" style="grid-template-columns:1.4fr 1fr">
    <div class="card">
        <div class="card-pad" style="border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center">
            <h3>Ultimi lead</h3>
            <a class="btn" href="{{ path('app_lead_index') }}">Vedi tutti</a>
        </div>
        <table class="grid-table">
            <thead><tr><th>Nome</th><th>Destinazione</th><th>Fonte</th><th>Stato</th></tr></thead>
            <tbody>
            {% for l in ultimi_lead %}
                <tr>
                    <td style="font-weight:600">{{ l.nomeCompleto }}</td>
                    <td class="muted">{{ l.destinazione ?: '—' }}</td>
                    <td class="muted">{{ l.fonte.label }}</td>
                    <td><span class="badge dot badge-{{ l.stato.value }}">{{ l.stato.label }}</span></td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="muted" style="text-align:center;padding:24px">Nessun lead ancora.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card">
        <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>Pipeline</h3></div>
        <div class="card-pad">
            {% for stato, n in per_stato %}
                {% set pct = tot_lead > 0 ? (n / tot_lead * 100)|round : 0 %}
                <div style="margin-bottom:14px">
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                        <span class="badge badge-{{ stato }}">{{ stato|replace({'_':' '})|capitalize }}</span>
                        <span style="font-weight:700">{{ n }}</span>
                    </div>
                    <div style="height:7px;background:#eef2f7;border-radius:20px;overflow:hidden">
                        <div style="height:100%;width:{{ pct }}%;background:var(--brand);border-radius:20px"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
