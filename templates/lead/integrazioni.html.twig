{% extends 'app.html.twig' %}

{% block title %}Integrazioni · Passpartour{% endblock %}
{% block page_title %}Integrazioni · ingestione lead{% endblock %}

{% block main %}
<div style="max-width:860px;display:grid;gap:16px">
    <div class="card">
        <div class="card-pad" style="border-bottom:1px solid var(--line)">
            <h3>Webhook lead</h3>
            <p class="muted" style="margin:6px 0 0">Invia i lead delle campagne a questo endpoint. Meta Lead Ads e Google si collegano tramite Zapier/Make (o direttamente); il campo <code>fonte</code> etichetta la provenienza (<code>meta</code>, <code>google</code>, <code>webhook</code>…).</p>
        </div>
        <div class="card-pad">
            <label style="display:block;font-weight:600;margin-bottom:6px">Endpoint (POST)</label>
            <div style="display:flex;gap:8px;align-items:center">
                <input type="text" readonly value="{{ webhook_url }}" onclick="this.select()" style="font-family:monospace;font-size:12px">
            </div>
            <p class="muted" style="font-size:12px;margin:8px 0 0">Il token nell'URL protegge l'endpoint. Rigeneralo cambiando <code>PASSPARTOUR_WEBHOOK_TOKEN</code> nella configurazione.</p>

            <label style="display:block;font-weight:600;margin:18px 0 6px">Esempio JSON</label>
            <pre style="background:#0e3266;color:#cfe0f5;padding:12px 14px;border-radius:9px;overflow:auto;font-size:12px;margin:0">curl -X POST "{{ webhook_url }}" \
  -H "Content-Type: application/json" \
  -d '{
    "fonte": "meta",
    "nome": "Marco", "cognome": "Neri",
    "email": "marco.neri@example.com",
    "telefono": "3401234567",
    "destinazione": "Maldive", "periodo": "Feb 2026",
    "passeggeri": 2, "budget": 4500,
    "campagna": "Maldive Inverno 2026",
    "consenso": "si"
  }'</pre>
            <p class="muted" style="font-size:12px;margin:10px 0 0">Risposta: <code>{ "ok": true, "esito": "creato|duplicato|scartato", "lead_id": 123 }</code>. I duplicati (stessa email/telefono) vengono saltati.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-pad">
            <h3 style="margin-bottom:8px">Import CSV &amp; inserimento manuale</h3>
            <p class="muted" style="margin:0 0 12px">Oltre al webhook puoi <a href="{{ path('app_lead_importa') }}">importare un CSV</a> o <a href="{{ path('app_lead_nuovo') }}">inserire un lead a mano</a>. Stesse regole di deduplica e collegamento campagna.</p>
            <div style="display:flex;gap:8px">
                <a class="btn" href="{{ path('app_lead_importa') }}">↥ Importa CSV</a>
                <a class="btn btn-primary" href="{{ path('app_lead_nuovo') }}">+ Nuovo lead</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
