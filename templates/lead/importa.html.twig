{% extends 'app.html.twig' %}

{% block title %}Importa lead · Passpartour{% endblock %}
{% block page_title %}Importa lead da CSV{% endblock %}

{% block main %}
<div style="max-width:820px;display:grid;gap:16px">

    {% if esiti %}
        <div class="card">
            <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>Esito importazione</h3></div>
            <div class="card-pad" style="display:flex;gap:24px">
                <div><div class="muted" style="font-size:12px">RIGHE</div><div style="font-size:24px;font-weight:800">{{ esiti.totale }}</div></div>
                <div><div class="muted" style="font-size:12px">CREATI</div><div style="font-size:24px;font-weight:800;color:var(--ok)">{{ esiti.conteggi.creato }}</div></div>
                <div><div class="muted" style="font-size:12px">DUPLICATI</div><div style="font-size:24px;font-weight:800;color:var(--amber)">{{ esiti.conteggi.duplicato }}</div></div>
                <div><div class="muted" style="font-size:12px">SCARTATI</div><div style="font-size:24px;font-weight:800;color:var(--danger)">{{ esiti.conteggi.scartato }}</div></div>
            </div>
            <table class="grid-table">
                <thead><tr><th>Riga</th><th>Contatto</th><th>Esito</th><th>Nota</th></tr></thead>
                <tbody>
                {% for d in esiti.dettaglio %}
                    <tr>
                        <td class="muted">{{ d.riga }}</td>
                        <td style="font-weight:600">{{ d.nome }}</td>
                        <td>
                            {% set col = {'creato':'vinto','duplicato':'contattato','scartato':'perso'} %}
                            <span class="badge badge-{{ col[d.esito.value] }}">{{ d.esito.label }}</span>
                        </td>
                        <td class="muted" style="font-size:12px">{{ d.messaggio ?: '' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="card-pad"><a class="btn btn-primary" href="{{ path('app_lead_index') }}">Vai ai lead</a></div>
        </div>
    {% endif %}

    <div class="card">
        <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>Carica un file CSV</h3></div>
        <div class="card-pad">
            <form method="post" enctype="multipart/form-data">
                <label style="display:block;font-weight:600;margin-bottom:6px">File CSV</label>
                <input type="file" name="csv" accept=".csv,text/csv" required style="margin-bottom:16px">
                <div style="display:flex;gap:10px">
                    <button type="submit" class="btn btn-primary">Importa</button>
                    <a class="btn" href="{{ path('app_lead_index') }}">Annulla</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-pad">
            <h3 style="margin-bottom:8px">Formato atteso</h3>
            <p class="muted" style="margin:0 0 10px">Prima riga = intestazioni. Separatore <code>,</code> o <code>;</code> (rilevato in automatico). Colonne riconosciute (tutte facoltative tranne un identificativo tra nome/email/telefono):</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px">
                {% for c in colonne %}<span class="badge">{{ c }}</span>{% endfor %}
            </div>
            <pre style="background:#0e3266;color:#cfe0f5;padding:12px 14px;border-radius:9px;overflow:auto;font-size:12px;margin:0">nome,cognome,email,telefono,destinazione,periodo,passeggeri,budget,campagna,consenso
Marco,Neri,marco.neri@example.com,3401234567,Maldive,Feb 2026,2,4500,Maldive Inverno 2026,si</pre>
            <p class="muted" style="font-size:12px;margin:10px 0 0">I duplicati (stessa email o stesso telefono) vengono saltati automaticamente. La campagna viene collegata se il nome corrisponde a una campagna esistente.</p>
        </div>
    </div>
</div>
{% endblock %}
