{% extends 'app.html.twig' %}

{% block title %}Messaggio · Passpartour{% endblock %}
{% block page_title %}Invia messaggio{% endblock %}

{% block main %}
<div class="card" style="max-width:560px"><div class="card-pad">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="font-weight:700">{{ lead.nomeCompleto }}</div>
        <a class="btn" href="{{ path('app_lead_scheda', {id: lead.id}) }}">Annulla</a>
    </div>

    {% if not configurato %}
        <div class="card-pad" style="background:#fff3e2;color:#c07d1e;border-radius:9px;margin-bottom:16px;font-size:13px">
            ⚠️ Twilio non configurato: imposta <code>TWILIO_ACCOUNT_SID</code>, <code>TWILIO_AUTH_TOKEN</code> e i numeri mittente in <code>.env</code> per inviare SMS/WhatsApp.
        </div>
    {% endif %}

    <form method="post" style="display:grid;gap:14px">
        <input type="hidden" name="_token" value="{{ csrf_token('lead_messaggio_' ~ lead.id) }}">

        <div>
            <label style="display:block;font-weight:600;margin-bottom:6px;font-size:13px">Canale</label>
            <div style="display:flex;gap:8px">
                <label class="canale-pill" style="flex:1">
                    <input type="radio" name="canale" value="sms" {{ sms_ok or not whatsapp_ok ? 'checked' }} style="display:none">
                    <span class="btn" style="width:100%;justify-content:center">SMS</span>
                </label>
                <label class="canale-pill" style="flex:1">
                    <input type="radio" name="canale" value="whatsapp" {{ whatsapp_ok and not sms_ok ? 'checked' }} style="display:none">
                    <span class="btn" style="width:100%;justify-content:center">WhatsApp</span>
                </label>
            </div>
        </div>

        <div>
            <label style="display:block;font-weight:600;margin-bottom:5px;font-size:13px">Numero</label>
            <input type="text" name="telefono" value="{{ lead.telefono }}" required placeholder="+39 340 1234567"
                   style="width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;font-family:inherit">
        </div>
        <div>
            <label style="display:block;font-weight:600;margin-bottom:5px;font-size:13px">Messaggio</label>
            <textarea name="testo" rows="4" required maxlength="1000" placeholder="Ciao {{ lead.nome }}, …"
                      style="width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;font-family:inherit;resize:vertical"></textarea>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">✆ Invia messaggio</button>
        </div>
    </form>
</div></div>

<style>
    .canale-pill input:checked + .btn { background: var(--brand); border-color: var(--brand); color: #fff; }
</style>
{% endblock %}
