{% extends 'app.html.twig' %}

{% block title %}{{ preventivo.numero }} · Passpartour{% endblock %}
{% block page_title %}Preventivo{% endblock %}

{% block main %}
<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;gap:12px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:12px">
        <a class="btn" href="{{ path('app_preventivo_index') }}">← Preventivi</a>
        <div>
            <div style="display:flex;align-items:center;gap:10px">
                <h2 style="font-size:20px">{{ preventivo.titolo }}</h2>
                <span class="badge">{{ preventivo.stato.label }}</span>
            </div>
            <div class="muted" style="font-size:13px;margin-top:2px">
                {{ preventivo.numero }}
                {% set dest = preventivo.cliente ? preventivo.cliente.nomeCompleto : (preventivo.lead ? preventivo.lead.nomeCompleto : null) %}
                {% if dest %} · {{ dest }}{% endif %}
                {% if preventivo.validoFino %} · valido fino al {{ preventivo.validoFino|date('d/m/Y') }}{% endif %}
                {% if preventivo.inviatoIl %} · <span style="color:var(--ok)">✉ inviato il {{ preventivo.inviatoIl|date('d/m/Y H:i') }}</span>{% endif %}
            </div>
        </div>
    </div>
    <div style="display:flex;gap:8px">
        <a class="btn" href="{{ path('app_preventivo_anteprima', {id: preventivo.id}) }}" target="_blank">⎙ Anteprima</a>
        <a class="btn" href="{{ path('app_preventivo_pdf', {id: preventivo.id}) }}">↓ PDF</a>
        <a class="btn" href="{{ path('app_preventivo_modifica', {id: preventivo.id}) }}">Modifica</a>
        <a class="btn btn-primary" href="{{ path('app_preventivo_email', {id: preventivo.id}) }}">✉ Invia</a>
    </div>
</div>

{% if preventivo.scenari|length == 0 %}
    <div class="card"><div class="card-pad muted" style="text-align:center;padding:32px">
        Nessuno scenario. <a href="{{ path('app_preventivo_modifica', {id: preventivo.id}) }}">Aggiungi le varianti</a>.
    </div></div>
{% else %}
    <div style="display:grid;grid-template-columns:repeat({{ min(preventivo.scenari|length, 3) }}, 1fr);gap:16px;align-items:start">
        {% for s in preventivo.scenari %}
            {% set prezzo = calc.prezzoFinale(s) %}
            {% set costo = calc.costoNetto(s) %}
            <div class="card" style="{{ s.consigliato ? 'border:2px solid var(--brand)' }}">
                {% if s.consigliato %}
                    <div style="background:var(--brand);color:#fff;text-align:center;font-size:11px;font-weight:800;letter-spacing:.05em;padding:4px;border-radius:10px 10px 0 0">CONSIGLIATO</div>
                {% endif %}
                <div class="card-pad">
                    <h3>{{ s.nome }}</h3>
                    {% if s.descrizione %}<p class="muted" style="font-size:13px;margin:6px 0 0">{{ s.descrizione }}</p>{% endif %}
                    <div style="margin:14px 0;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
                        <div style="font-size:28px;font-weight:800;letter-spacing:-.02em">€ {{ prezzo|number_format(0, ',', '.') }}</div>
                        <div class="muted" style="font-size:12px">costo € {{ costo|number_format(0, ',', '.') }} · commissioni {{ s.markupPercentuale }}% (€ {{ calc.commissioni(s)|number_format(0, ',', '.') }})</div>
                    </div>
                    <table style="width:100%;font-size:13px;border-collapse:collapse">
                        {% for v in s.voci %}
                            <tr>
                                <td style="padding:8px 0;color:var(--ink);vertical-align:top;border-top:1px solid #f0f3f7">
                                    <table style="width:100%"><tr>
                                        <td style="width:28px;vertical-align:top">{{ include('preventivo/_icona.html.twig', {categoria: v.categoria, size: 22}) }}</td>
                                        <td style="vertical-align:top">
                                            <div style="font-weight:600">{{ v.etichetta }}{% if v.quantita > 1 %} <span class="muted">×{{ v.quantita }}</span>{% endif %}</div>
                                            {{ include('preventivo/_voce_dettagli.html.twig', {voce: v, web: true}) }}
                                        </td>
                                    </tr></table>
                                </td>
                                <td style="padding:8px 0;text-align:right;white-space:nowrap;vertical-align:top;border-top:1px solid #f0f3f7">€ {{ (v.quantita * v.costoUnitario)|number_format(0, ',', '.') }}</td>
                            </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% if preventivo.tappe|length > 0 %}
    <div class="card" style="margin-top:16px">
        <div class="card-pad" style="border-bottom:1px solid var(--line)"><h3>Diario di viaggio</h3></div>
        <div class="card-pad">
            {% for t in preventivo.tappe %}
                <div class="dv-item">
                    <div class="dv-when">{{ t.etichettaTemporale }}</div>
                    <div class="dv-rail"><span class="dv-node"></span></div>
                    <div class="dv-body">
                        {% if t.destinazione and t.destinazione.immagine %}
                            <img src="{{ asset('uploads/destinazioni/' ~ t.destinazione.immagine) }}" alt="{{ t.destinazione.nome }}">
                        {% endif %}
                        <div>
                            <div style="font-weight:700">{{ t.titolo }}</div>
                            {% if t.descrizione %}<div class="muted" style="font-size:13px;margin-top:3px">{{ t.descrizione|nl2br }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{% if preventivo.note %}
    <div class="card" style="margin-top:16px"><div class="card-pad">
        <h3 style="margin-bottom:6px">Note interne</h3>
        <p class="muted" style="margin:0">{{ preventivo.note|nl2br }}</p>
    </div></div>
{% endif %}
{% endblock %}
