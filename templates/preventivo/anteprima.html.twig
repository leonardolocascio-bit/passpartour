{% extends 'base.html.twig' %}

{% block title %}{{ preventivo.numero }} · Proposta di viaggio{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body { background: #eef1f6; }
        .foglio { max-width: 820px; margin: 24px auto; background: #fff; border-radius: 14px; box-shadow: var(--shadow); padding: 40px 44px; }
        .doc-head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--navy); padding-bottom: 18px; margin-bottom: 22px; }
        .doc-head img { height: 40px; }
        .proposta-scenario { border: 1px solid var(--line); border-radius: 12px; padding: 20px 22px; margin-bottom: 16px; }
        .proposta-scenario.top { border: 2px solid var(--brand); }
        .prezzo-big { font-size: 30px; font-weight: 800; letter-spacing: -.02em; color: var(--navy); }
        .voci-list { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
        .voci-list td { padding: 7px 0; border-bottom: 1px dashed var(--line); }
        .toolbar { max-width: 820px; margin: 16px auto 0; display: flex; justify-content: flex-end; gap: 8px; }
        @media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .foglio { box-shadow: none; margin: 0; max-width: none; border-radius: 0; padding: 0; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="toolbar no-print">
    <a class="btn" href="{{ path('app_preventivo_scheda', {id: preventivo.id}) }}">← Torna al preventivo</a>
    <a class="btn" href="{{ path('app_preventivo_pdf', {id: preventivo.id}) }}">↓ Scarica PDF</a>
    <button class="btn btn-primary" onclick="window.print()">⎙ Stampa</button>
</div>

<div class="foglio">
    <div class="doc-head">
        <div>
            <img src="{{ asset('images/passpartour-color.png') }}" alt="Passpartour">
            <div class="muted" style="font-size:12px;margin-top:8px">Proposta di viaggio · {{ preventivo.numero }}</div>
        </div>
        <div style="text-align:right;font-size:13px" class="muted">
            {% set intest = preventivo.cliente ? preventivo.cliente.nomeCompleto : (preventivo.lead ? preventivo.lead.nomeCompleto : null) %}
            {% if intest %}<div><b style="color:var(--ink)">{{ intest }}</b></div>{% endif %}
            <div>{{ "now"|date('d/m/Y') }}</div>
            {% if preventivo.validoFino %}<div>Valida fino al {{ preventivo.validoFino|date('d/m/Y') }}</div>{% endif %}
        </div>
    </div>

    <h1 style="font-size:24px;margin-bottom:20px">{{ preventivo.titolo }}</h1>

    {% for s in preventivo.scenari %}
        <div class="proposta-scenario {{ s.consigliato ? 'top' }}">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
                <div>
                    <div style="display:flex;align-items:center;gap:8px">
                        <h2 style="font-size:19px">{{ s.nome }}</h2>
                        {% if s.consigliato %}<span class="badge" style="background:var(--brand);color:#fff">Consigliato</span>{% endif %}
                    </div>
                    {% if s.descrizione %}<p class="muted" style="font-size:14px;margin:6px 0 0;max-width:440px">{{ s.descrizione }}</p>{% endif %}
                </div>
                <div style="text-align:right">
                    <div class="prezzo-big">€ {{ calc.prezzoFinale(s)|number_format(0, ',', '.') }}</div>
                    <div class="muted" style="font-size:12px">tutto incluso</div>
                </div>
            </div>
            <table class="voci-list">
                {% for v in s.voci %}
                    <tr>
                        <td>
                            {{ include('preventivo/_icona.html.twig', {categoria: v.categoria, size: 24}) }}
                            <span style="vertical-align:middle;margin-left:8px">{{ v.descrizione ?: v.categoria.label }}{% if v.quantita > 1 %} <span class="muted">×{{ v.quantita }}</span>{% endif %}</span>
                        </td>
                        <td style="text-align:right;white-space:nowrap;color:var(--muted)">{{ v.categoria.label }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endfor %}

    {% if preventivo.tappe|length > 0 %}
        <h2 style="font-size:19px;margin:28px 0 16px;border-top:1px solid var(--line);padding-top:20px">Diario di viaggio</h2>
        {% for t in preventivo.tappe %}
            <div style="display:flex;gap:16px;margin-bottom:16px;align-items:flex-start">
                {% if t.destinazione and t.destinazione.immagine %}
                    <img src="{{ asset('uploads/destinazioni/' ~ t.destinazione.immagine) }}" alt="{{ t.destinazione.nome }}" style="width:170px;height:106px;object-fit:cover;border-radius:10px;flex-shrink:0">
                {% endif %}
                <div>
                    <div style="font-weight:700;font-size:15px">{% if t.giorno %}Giorno {{ t.giorno }} · {% endif %}{{ t.titolo }}</div>
                    {% if t.descrizione %}<p class="muted" style="margin:5px 0 0;font-size:14px">{{ t.descrizione|nl2br }}</p>{% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}

    <p class="muted" style="font-size:12px;margin-top:22px;border-top:1px solid var(--line);padding-top:14px">
        Prezzi comprensivi dei servizi elencati. La disponibilità è da riconfermare all'atto della prenotazione.
        Passpartour · Gestionale agenzia viaggi.
    </p>
</div>
{% endblock %}
