{% extends 'app.html.twig' %}
{% import _self as ui %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{# ---------- macro: voce di costo (campi per categoria) ---------- #}
{% macro voceCard(s, v, categorie, trattamenti, voce) %}
{% set p = 'preventivo[scenari][' ~ s ~ '][voci][' ~ v ~ ']' %}
<div class="voce-card" style="border:1px solid var(--line);border-radius:9px;padding:12px 14px;margin-bottom:8px;background:#fbfcfe">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <select class="v-cat" name="{{ p }}[categoria]" style="width:150px">
            {% for c in categorie %}<option value="{{ c.value }}" {{ voce and voce.categoria == c ? 'selected' }}>{{ c.label }}</option>{% endfor %}
        </select>
        <div style="flex:1"></div>
        <input type="number" min="1" class="v-qta" name="{{ p }}[quantita]" value="{{ voce ? voce.quantita : 1 }}" title="Quantità" style="width:64px">
        <input type="text" inputmode="decimal" class="v-costo" name="{{ p }}[costoUnitario]" value="{{ voce ? voce.costoUnitario : '' }}" placeholder="Costo €" title="Costo unitario" style="width:110px">
        <button type="button" class="btn del-voce" style="padding:6px 10px">✕</button>
    </div>

    <div class="vg vg-tratta" style="margin-top:10px;display:grid;grid-template-columns:2fr 1fr 2fr 1fr;gap:8px">
        <div><label>Da</label><input type="text" name="{{ p }}[da]" value="{{ voce ? voce.da }}" placeholder="Partenza"></div>
        <div><label>Ora part.</label><input type="text" name="{{ p }}[orarioPartenza]" value="{{ voce ? voce.orarioPartenza }}" placeholder="10:30"></div>
        <div><label>A</label><input type="text" name="{{ p }}[a]" value="{{ voce ? voce.a }}" placeholder="Arrivo"></div>
        <div><label>Ora arr.</label><input type="text" name="{{ p }}[orarioArrivo]" value="{{ voce ? voce.orarioArrivo }}" placeholder="13:15"></div>
    </div>

    <div class="vg vg-hotel" style="margin-top:10px;display:grid;grid-template-columns:2fr 90px;gap:8px">
        <div><label>Nome struttura</label><input type="text" name="{{ p }}[nomeStruttura]" value="{{ voce ? voce.nomeStruttura }}" placeholder="Es. Hotel Belvedere"></div>
        <div><label>Stelle</label><input type="number" min="1" max="5" name="{{ p }}[stelle]" value="{{ voce ? voce.stelle }}"></div>
        <div style="grid-column:1/-1"><label>Indirizzo (Google Maps)</label><input type="text" name="{{ p }}[indirizzo]" value="{{ voce ? voce.indirizzo }}" placeholder="Via, città"></div>
        <div style="grid-column:1/-1"><label>Trattamento</label>
            <select name="{{ p }}[trattamento]">
                <option value="">—</option>
                {% for t in trattamenti %}<option value="{{ t.value }}" {{ voce and voce.trattamento == t ? 'selected' }}>{{ t.label }}</option>{% endfor %}
            </select>
        </div>
        <div style="grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:8px">
            <div><label>Check-in</label><div style="display:flex;gap:6px"><input type="date" name="{{ p }}[dataInizio]" value="{{ voce and voce.dataInizio ? voce.dataInizio|date('Y-m-d') }}"><input type="text" name="{{ p }}[orarioInizio]" value="{{ voce ? voce.orarioInizio }}" placeholder="14:00" style="width:70px"></div></div>
            <div><label>Check-out</label><div style="display:flex;gap:6px"><input type="date" name="{{ p }}[dataFine]" value="{{ voce and voce.dataFine ? voce.dataFine|date('Y-m-d') }}"><input type="text" name="{{ p }}[orarioFine]" value="{{ voce ? voce.orarioFine }}" placeholder="10:00" style="width:70px"></div></div>
        </div>
    </div>

    <div class="vg vg-semplice" style="margin-top:10px">
        <label>Descrizione</label>
        <input type="text" name="{{ p }}[descrizione]" value="{{ voce ? voce.descrizione }}" placeholder="Descrizione">
    </div>

    <div style="margin-top:8px">
        <label>Note</label>
        <textarea name="{{ p }}[note]" placeholder="Note (facoltative)" style="min-height:48px">{{ voce ? voce.note }}</textarea>
    </div>
</div>
{% endmacro %}

{# ---------- macro: blocco scenario ---------- #}
{% macro scenarioBlock(s, categorie, trattamenti, scenario) %}
{% import _self as ui %}
<div class="scenario-block card" data-s="{{ s }}" data-vindex="{{ scenario ? scenario.voci|length : 0 }}" style="margin-bottom:14px">
    <div class="card-pad">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
            <div style="flex:1;min-width:180px">
                <label>Nome scenario</label>
                <input type="text" name="preventivo[scenari][{{ s }}][nome]" value="{{ scenario ? scenario.nome }}" placeholder="Es. Comfort">
            </div>
            <div style="width:130px">
                <label>Commissioni %</label>
                <input type="text" inputmode="decimal" class="s-markup" name="preventivo[scenari][{{ s }}][markupPercentuale]" value="{{ scenario ? scenario.markupPercentuale : '0' }}">
            </div>
            <label style="display:flex;align-items:center;gap:7px;font-weight:500;padding-bottom:9px;cursor:pointer">
                <input type="checkbox" name="preventivo[scenari][{{ s }}][consigliato]" value="1" {{ scenario and scenario.consigliato ? 'checked' }}> Consigliato
            </label>
            <input type="hidden" name="preventivo[scenari][{{ s }}][ordinamento]" value="{{ scenario ? scenario.ordinamento : 0 }}">
            <button type="button" class="btn del-scenario" style="padding-bottom:9px;margin-left:auto">Rimuovi scenario</button>
        </div>

        <div class="voci-body" style="margin-top:14px">
            {% if scenario %}
                {% for voce in scenario.voci %}{{ ui.voceCard(s, loop.index0, categorie, trattamenti, voce) }}{% endfor %}
            {% endif %}
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px">
            <button type="button" class="btn add-voce">+ Aggiungi voce</button>
            <div class="s-totali muted" style="font-size:13px">Costo <b class="s-costo">€ 0</b> · Commissioni <b class="s-commissioni" style="color:var(--brand)">€ 0</b> · Prezzo <b class="s-prezzo" style="color:var(--ink)">€ 0</b></div>
        </div>
    </div>
</div>
{% endmacro %}

{# ---------- macro: tappa del diario di viaggio ---------- #}
{% macro tappaBlock(t, destinazioni, tappa) %}
{% set p = 'preventivo[tappe][' ~ t ~ ']' %}
<div class="tappa-block card" style="margin-bottom:10px"><div class="card-pad" style="display:flex;gap:14px;align-items:flex-start">
    <input type="hidden" name="{{ p }}[ordinamento]" value="{{ tappa ? tappa.ordinamento : 0 }}">
    <div style="flex:1">
        <label>Tappa</label>
        <input type="text" name="{{ p }}[titolo]" value="{{ tappa ? tappa.titolo }}" placeholder="Es. Arrivo a Santorini">
        <textarea name="{{ p }}[descrizione]" placeholder="Cosa succede in questa tappa" style="margin-top:8px">{{ tappa ? tappa.descrizione }}</textarea>
    </div>
    <div style="width:240px">
        <label>Immagine (destinazione)</label>
        <select name="{{ p }}[destinazione]">
            <option value="">— nessuna —</option>
            {% for d in destinazioni %}<option value="{{ d.id }}" {{ tappa and tappa.destinazione and tappa.destinazione.id == d.id ? 'selected' }}>{{ d.nome }}</option>{% endfor %}
        </select>
        <label style="margin-top:10px">Quando <span class="muted" style="font-weight:400">(compila ciò che serve)</span></label>
        <div style="display:flex;gap:6px;align-items:center;font-size:12px">
            <span class="muted">Giorno</span>
            <input type="number" min="1" name="{{ p }}[giorno]" value="{{ tappa ? tappa.giorno }}" style="width:52px">
            <span class="muted">–</span>
            <input type="number" min="1" name="{{ p }}[giornoA]" value="{{ tappa ? tappa.giornoA }}" style="width:52px">
        </div>
        <div style="display:flex;gap:6px;align-items:center;font-size:12px;margin-top:6px">
            <span class="muted">Date</span>
            <input type="date" name="{{ p }}[data]" value="{{ tappa and tappa.data ? tappa.data|date('Y-m-d') }}">
            <input type="date" name="{{ p }}[dataA]" value="{{ tappa and tappa.dataA ? tappa.dataA|date('Y-m-d') }}">
        </div>
    </div>
    <button type="button" class="btn del-tappa" style="margin-top:22px">✕</button>
</div></div>
{% endmacro %}

{% block main %}
<div style="max-width:960px">
    {{ form_start(form) }}

    <div class="card" style="margin-bottom:16px"><div class="card-pad">
        <div style="display:grid;grid-template-columns:1fr;gap:14px">
            {{ form_row(form.titolo) }}
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                {{ form_row(form.lead) }}
                {{ form_row(form.cliente) }}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                {{ form_row(form.stato) }}
                {{ form_row(form.validoFino) }}
            </div>
            {{ form_row(form.note) }}
        </div>
    </div></div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3>Scenari (varianti di proposta)</h3>
        <button type="button" class="btn btn-primary" id="add-scenario">+ Aggiungi scenario</button>
    </div>

    {% do form.scenari.setRendered %}
    <div id="scenari" data-index="{{ preventivo.scenari|length }}">
        {% for scenario in preventivo.scenari %}
            {{ ui.scenarioBlock(loop.index0, categorie, trattamenti, scenario) }}
        {% endfor %}
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:26px 0 12px">
        <div>
            <h3>Diario di viaggio</h3>
            <p class="muted" style="margin:2px 0 0;font-size:13px">Le tappe del viaggio (timeline). L'immagine arriva dalla libreria destinazioni.</p>
        </div>
        <button type="button" class="btn btn-primary" id="add-tappa">+ Aggiungi tappa</button>
    </div>

    {% do form.tappe.setRendered %}
    <div id="tappe" data-index="{{ preventivo.tappe|length }}">
        {% for tappa in preventivo.tappe %}
            {{ ui.tappaBlock(loop.index0, destinazioni, tappa) }}
        {% endfor %}
    </div>

    <div style="margin-top:18px;display:flex;gap:10px">
        <button type="submit" class="btn btn-primary">Salva preventivo</button>
        <a class="btn" href="{{ preventivo.id ? path('app_preventivo_scheda', {id: preventivo.id}) : path('app_preventivo_index') }}">Annulla</a>
    </div>

    {{ form_end(form) }}
</div>

<template id="tpl-scenario">{{ ui.scenarioBlock('__S__', categorie, trattamenti, null) }}</template>
<template id="tpl-voce">{{ ui.voceCard('__S__', '__V__', categorie, trattamenti, null) }}</template>
<template id="tpl-tappa">{{ ui.tappaBlock('__T__', destinazioni, null) }}</template>

<script>
(function () {
    // ---- Diario tappe ----
    const contT = document.getElementById('tappe');
    const tplT = document.getElementById('tpl-tappa').innerHTML;
    document.getElementById('add-tappa').addEventListener('click', () => {
        const idx = parseInt(contT.dataset.index, 10); contT.dataset.index = idx + 1;
        const div = document.createElement('div'); div.innerHTML = tplT.replaceAll('__T__', idx);
        contT.appendChild(div.firstElementChild);
    });
    contT.addEventListener('click', e => { if (e.target.classList.contains('del-tappa')) e.target.closest('.tappa-block').remove(); });

    // ---- Scenari / voci ----
    const cont = document.getElementById('scenari');
    const tplScenario = document.getElementById('tpl-scenario').innerHTML;
    const tplVoce = document.getElementById('tpl-voce').innerHTML;
    const GRUPPI = { volo: 'tratta', transfer: 'tratta', hotel: 'hotel', escursione: 'semplice', assicurazione: 'semplice', altro: 'semplice' };
    const fmt = n => '€ ' + (Math.round(n)).toLocaleString('it-IT');

    function campiVoce(card) {
        const g = GRUPPI[card.querySelector('.v-cat').value] || 'semplice';
        card.querySelectorAll('.vg').forEach(el => { el.style.display = el.classList.contains('vg-' + g) ? '' : 'none'; });
    }
    function ricalcola(block) {
        let costo = 0;
        block.querySelectorAll('.voce-card').forEach(c => {
            const q = parseFloat(c.querySelector('.v-qta').value) || 0;
            const cu = parseFloat((c.querySelector('.v-costo').value || '').replace(',', '.')) || 0;
            costo += q * cu;
        });
        const markup = parseFloat((block.querySelector('.s-markup').value || '').replace(',', '.')) || 0;
        const prezzo = costo * (1 + markup / 100);
        block.querySelector('.s-costo').textContent = fmt(costo);
        block.querySelector('.s-commissioni').textContent = fmt(prezzo - costo);
        block.querySelector('.s-prezzo').textContent = fmt(prezzo);
    }
    function initTutto() {
        cont.querySelectorAll('.voce-card').forEach(campiVoce);
        cont.querySelectorAll('.scenario-block').forEach(ricalcola);
    }

    document.getElementById('add-scenario').addEventListener('click', () => {
        const idx = parseInt(cont.dataset.index, 10); cont.dataset.index = idx + 1;
        const div = document.createElement('div'); div.innerHTML = tplScenario.replaceAll('__S__', idx);
        cont.appendChild(div.firstElementChild);
        div.firstElementChild && div.querySelectorAll('.voce-card').forEach(campiVoce);
        initTutto();
    });

    cont.addEventListener('click', e => {
        if (e.target.classList.contains('add-voce')) {
            const block = e.target.closest('.scenario-block');
            const s = block.dataset.s; const v = parseInt(block.dataset.vindex, 10); block.dataset.vindex = v + 1;
            const div = document.createElement('div');
            div.innerHTML = tplVoce.replaceAll('__S__', s).replaceAll('__V__', v);
            const card = div.firstElementChild;
            block.querySelector('.voci-body').appendChild(card);
            campiVoce(card);
        } else if (e.target.classList.contains('del-voce')) {
            const block = e.target.closest('.scenario-block');
            e.target.closest('.voce-card').remove(); ricalcola(block);
        } else if (e.target.classList.contains('del-scenario')) {
            e.target.closest('.scenario-block').remove();
        }
    });
    cont.addEventListener('change', e => { if (e.target.classList.contains('v-cat')) campiVoce(e.target.closest('.voce-card')); });
    cont.addEventListener('input', e => { if (e.target.matches('.v-qta, .v-costo, .s-markup')) ricalcola(e.target.closest('.scenario-block')); });

    initTutto();
})();
</script>
{% endblock %}
