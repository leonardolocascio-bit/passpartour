{% extends 'app.html.twig' %}

{% block title %}Preventivi · Passpartour{% endblock %}
{% block page_title %}Preventivi{% endblock %}

{% block main %}
<div style="display:flex;justify-content:flex-end;margin-bottom:16px">
    <a class="btn btn-primary" href="{{ path('app_preventivo_nuovo') }}">+ Nuovo preventivo</a>
</div>
<div class="card">
    <div class="card-pad" style="border-bottom:1px solid var(--line)">
        <h3>Preventivi <span class="muted" style="font-weight:500">({{ preventivi|length }})</span></h3>
    </div>
    <table class="grid-table">
        <thead><tr><th>Numero</th><th>Titolo</th><th>Intestatario</th><th>Scenari</th><th>Da (consigliato)</th><th>Stato</th></tr></thead>
        <tbody>
        {% for p in preventivi %}
            {% set prezzo = calc.prezzoRappresentativo(p) %}
            <tr>
                <td style="font-weight:600"><a href="{{ path('app_preventivo_scheda', {id: p.id}) }}">{{ p.numero }}</a></td>
                <td><a href="{{ path('app_preventivo_scheda', {id: p.id}) }}">{{ p.titolo }}</a></td>
                <td class="muted">{{ p.cliente ? p.cliente.nomeCompleto : (p.lead ? p.lead.nomeCompleto : '—') }}</td>
                <td>{{ p.scenari|length }}</td>
                <td style="font-weight:700">{{ prezzo is not null ? '€ ' ~ prezzo|number_format(0, ',', '.') : '—' }}</td>
                <td><span class="badge">{{ p.stato.label }}</span></td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="muted" style="text-align:center;padding:28px">Nessun preventivo. Creane uno o partendo da un lead.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
