<!DOCTYPE html>
<html lang="it">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Passpartour{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
        {% block stylesheets %}
        <style>
            :root {
                /* Palette brand Passpartour (dal logo) */
                --navy: #123a72;       /* royal navy del wordmark — sidebar */
                --navy-700: #0e3266;
                --navy-600: #1c5099;
                --brand: #ea5b24;      /* arancio logo — CTA */
                --brand-600: #d34e1b;
                --cyan: #1f9fd6;       /* azzurro/ciano logo — accento */
                --amber: #f6a41f;      /* giallo/ambra logo */
                --ink: #14243b;
                --muted: #6a7788;
                --line: #e5e9f0;
                --bg: #f4f7fb;
                --card: #ffffff;
                --ok: #1f9d54;
                --warn: #f6a41f;
                --danger: #e05260;
                --radius: 12px;
                --shadow: 0 1px 2px rgba(18,58,114,.06), 0 8px 24px rgba(18,58,114,.07);
                --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            }
            * { box-sizing: border-box; }
            body {
                margin: 0;
                font-family: var(--font);
                color: var(--ink);
                background: var(--bg);
                font-size: 14px;
                line-height: 1.5;
                -webkit-font-smoothing: antialiased;
            }
            a { color: inherit; text-decoration: none; }
            h1, h2, h3 { margin: 0; font-weight: 700; letter-spacing: -.01em; }

            /* ---- App shell ---- */
            .app { display: flex; min-height: 100vh; }
            .sidebar {
                width: 236px; flex-shrink: 0; background: var(--navy);
                color: #cdd8e6; display: flex; flex-direction: column;
                position: sticky; top: 0; height: 100vh;
            }
            .brand {
                display: flex; align-items: center;
                padding: 22px 20px 18px;
            }
            .brand-logo { height: 30px; width: auto; display: block; }
            .nav { padding: 8px; display: flex; flex-direction: column; gap: 2px; flex: 1; }
            .nav a {
                display: flex; align-items: center; gap: 11px;
                padding: 10px 12px; border-radius: 9px; color: #b7c4d6;
                font-weight: 500; transition: background .12s, color .12s;
            }
            .nav a .ic { width: 20px; text-align: center; opacity: .9; }
            .nav a:hover { background: var(--navy-700); color: #fff; }
            .nav a.active { background: var(--navy-600); color: #fff; }
            .nav a.active .ic { color: var(--brand); }
            .sidebar-foot { padding: 14px 16px; border-top: 1px solid rgba(255,255,255,.08); font-size: 12px; color: #7d8ea6; }

            .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
            .topbar {
                height: 60px; background: var(--card); border-bottom: 1px solid var(--line);
                display: flex; align-items: center; justify-content: space-between;
                padding: 0 24px; position: sticky; top: 0; z-index: 10;
            }
            .topbar .page-title { font-size: 16px; font-weight: 700; }
            .user-chip { display: flex; align-items: center; gap: 10px; color: var(--muted); }
            .avatar {
                width: 32px; height: 32px; border-radius: 50%; background: var(--cyan);
                color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 13px;
            }
            .content { padding: 24px; max-width: 1200px; width: 100%; }

            /* ---- Components ---- */
            .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
            .card-pad { padding: 18px 20px; }
            .grid { display: grid; gap: 16px; }
            .stat { padding: 18px 20px; }
            .stat .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
            .stat .value { font-size: 30px; font-weight: 800; margin-top: 6px; letter-spacing: -.02em; }
            .stat .sub { color: var(--muted); font-size: 12px; margin-top: 2px; }

            .btn {
                display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
                padding: 9px 15px; border-radius: 9px; border: 1px solid var(--line);
                background: var(--card); color: var(--ink); font-weight: 600; font-size: 13px;
                font-family: inherit; transition: .12s;
            }
            .btn:hover { border-color: #cfd8e3; }
            .btn-primary { background: var(--brand); border-color: var(--brand); color: #fff; }
            .btn-primary:hover { background: var(--brand-600); border-color: var(--brand-600); }

            .badge {
                display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px;
                border-radius: 20px; font-size: 12px; font-weight: 600; background: #eef2f7; color: var(--muted);
            }
            .badge.dot::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
            .badge-nuovo { background: #e4f4fb; color: #1889bd; }             /* ciano */
            .badge-contattato { background: #fdf3e0; color: #c98314; }        /* ambra */
            .badge-preventivo_inviato { background: #e9eff9; color: #1c5099; } /* navy */
            .badge-trattativa { background: #fdece1; color: #d2551b; }        /* arancio */
            .badge-vinto { background: #e6f6ec; color: #1f9d54; }             /* verde */
            .badge-perso { background: #fdecee; color: #cc3c4c; }             /* rosso */

            table.grid-table { width: 100%; border-collapse: collapse; }
            table.grid-table th {
                text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
                color: var(--muted); font-weight: 700; padding: 10px 14px; border-bottom: 1px solid var(--line);
            }
            table.grid-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); }
            table.grid-table tr:last-child td { border-bottom: none; }
            table.grid-table tr:hover td { background: #fafbfd; }

            /* Form */
            .card-pad input:not([type=checkbox]):not([type=submit]):not([type=file]),
            .card-pad select, .card-pad textarea {
                width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px;
                font-size: 14px; font-family: inherit; background: #fff; color: var(--ink);
            }
            .card-pad input:focus, .card-pad select:focus, .card-pad textarea:focus {
                outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(31,159,214,.14);
            }
            .card-pad label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 13px; }
            .card-pad textarea { min-height: 80px; resize: vertical; }
            .card-pad .form-help, .card-pad small { color: var(--muted); font-size: 12px; }
            .field-error, .card-pad ul li { color: var(--danger); font-size: 12px; list-style: none; }
            .card-pad ul { padding: 0; margin: 4px 0 0; }

            /* Kanban */
            .kanban { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 8px; align-items: flex-start; }
            .kb-col { flex: 0 0 260px; background: #eef1f6; border-radius: 12px; display: flex; flex-direction: column; max-height: calc(100vh - 150px); }
            .kb-col-head { padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; }
            .kb-count { background: #fff; border-radius: 20px; padding: 1px 9px; font-size: 12px; font-weight: 700; color: var(--muted); }
            .kb-body { padding: 0 10px 10px; display: flex; flex-direction: column; gap: 9px; overflow-y: auto; min-height: 40px; }
            .kb-body.drag-over { background: rgba(31,159,214,.10); border-radius: 8px; outline: 2px dashed var(--cyan); outline-offset: -4px; }
            .kb-card {
                background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 11px 12px;
                box-shadow: 0 1px 2px rgba(15,37,64,.05); cursor: grab; transition: box-shadow .12s, transform .06s;
            }
            .kb-card:hover { box-shadow: 0 4px 14px rgba(15,37,64,.10); }
            .kb-card.dragging { opacity: .5; }
            .kb-card .nome { font-weight: 700; margin-bottom: 3px; }
            .kb-card .meta { color: var(--muted); font-size: 12px; display: flex; flex-wrap: wrap; gap: 4px 10px; }
            .kb-card .foot { display: flex; align-items: center; justify-content: space-between; margin-top: 9px; }
            .avatar-sm { width: 22px; height: 22px; border-radius: 50%; background: var(--cyan); color: #fff; display: grid; place-items: center; font-size: 10px; font-weight: 700; }

            /* Calendario */
            .cal-head { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-bottom: 6px; }
            .cal-head div { text-align: center; font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
            .cal-month { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
            .cal-cell { background: var(--card); border: 1px solid var(--line); border-radius: 8px; min-height: 98px; padding: 6px 7px; overflow: hidden; }
            .cal-cell.fuori { background: #f7f9fc; }
            .cal-cell.fuori .cal-daynum { color: #b7c1cf; }
            .cal-cell.oggi { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
            .cal-daynum { font-size: 12px; font-weight: 700; margin-bottom: 4px; }
            .cal-chip { display: block; font-size: 11px; padding: 2px 6px; border-radius: 5px; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; text-decoration: none; }
            .cal-more { font-size: 10px; color: var(--muted); }
            .cal-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; align-items: start; }
            .cal-week-col { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px; min-height: 220px; }
            .cal-week-col.oggi { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
            .cal-year { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
            .mini-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-top: 8px; }
            .mini-day { text-align: center; font-size: 9px; padding: 3px 0; border-radius: 3px; color: #9aa6b4; }
            .mini-day.has { background: var(--brand); color: #fff; font-weight: 700; }

            /* Diario di viaggio — timeline grafica verticale */
            .dv-item { display: flex; align-items: stretch; }
            .dv-when { width: 100px; flex-shrink: 0; text-align: right; padding: 1px 12px 0 0; font-size: 12px; font-weight: 700; color: var(--navy); }
            .dv-rail { width: 24px; flex-shrink: 0; position: relative; }
            .dv-rail::before { content: ""; position: absolute; left: 11px; top: 0; bottom: 0; width: 2px; background: var(--line); }
            .dv-item:last-child .dv-rail::before { bottom: auto; height: 22px; }
            .dv-node { position: absolute; left: 5px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--brand); border: 3px solid var(--card); box-shadow: 0 0 0 1px var(--line); }
            .dv-body { flex: 1; min-width: 0; padding: 0 0 24px 16px; display: flex; gap: 14px; align-items: flex-start; }
            .dv-body img { width: 150px; height: 100px; object-fit: cover; border-radius: 10px; flex-shrink: 0; }

            /* Timeline */
            .timeline { position: relative; padding-left: 22px; }
            .timeline::before { content: ""; position: absolute; left: 6px; top: 4px; bottom: 4px; width: 2px; background: var(--line); }
            .tl-item { position: relative; padding: 0 0 16px; }
            .tl-item::before { content: ""; position: absolute; left: -20px; top: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--cyan); border: 2px solid #fff; box-shadow: 0 0 0 1px var(--line); }
            .tl-item.done::before { background: var(--ok); }

            .demo-flag {
                background: var(--brand); color: #fff; font-size: 10px; font-weight: 800;
                text-transform: uppercase; letter-spacing: .06em; padding: 3px 8px; border-radius: 6px;
            }
            .muted { color: var(--muted); }

            /* Tabs (schede di un form lungo) */
            .tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin-bottom: 20px; flex-wrap: wrap; }
            .tab-btn {
                appearance: none; background: none; border: none; border-bottom: 2px solid transparent;
                padding: 10px 16px; font-size: 14px; font-weight: 700; color: var(--muted); cursor: pointer;
                margin-bottom: -1px;
            }
            .tab-btn:hover { color: var(--navy); }
            .tab-btn.is-active { color: var(--navy); border-bottom-color: var(--brand); }
            .tab-panel { display: grid; gap: 14px; }
            .section-hint { color: var(--muted); font-size: 13px; padding: 18px; border: 1px dashed var(--line); border-radius: 10px; text-align: center; }

            /* Scheda offerta (dettaglio read-only) */
            .sk-sec { padding: 16px 0; border-top: 1px solid var(--line); }
            .sk-h { font-size: 15px; font-weight: 700; margin: 0 0 10px; color: var(--navy); }
            .sk-item { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; background: #fbfcfe; }

            /* Editor ripetibile (voli, treni, navi, trasferimenti, extra) */
            .seg-item { position: relative; border: 1px solid var(--line); border-radius: 8px; padding: 10px 34px 10px 10px; background: #fbfcfe; }
            .seg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
            .seg-del { position: absolute; top: 8px; right: 8px; border: none; background: none; color: var(--danger); cursor: pointer; font-size: 14px; font-weight: 800; line-height: 1; }
            .seg-del:hover { color: #b3313e; }

            /* Chip picker (multi-selezione con voci custom) */
            .chip-picker__label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 8px; }
            .chip-picker__chips { display: flex; flex-wrap: wrap; gap: 8px; }
            .chip {
                display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
                padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600;
                background: #eef2f7; color: var(--muted); border: 1px solid var(--line);
                transition: background .12s, color .12s, border-color .12s;
            }
            .chip:hover { border-color: var(--cyan); }
            .chip--on { background: var(--cyan); color: #fff; border-color: var(--cyan); }
            .chip--custom.chip--on { background: var(--navy-600); border-color: var(--navy-600); }
            .chip__x { font-weight: 800; opacity: .8; }
            .chip-picker__add { display: flex; gap: 8px; margin-top: 10px; }
            .chip-picker__input { flex: 1; }
        </style>
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
