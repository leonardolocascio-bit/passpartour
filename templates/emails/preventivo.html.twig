<!DOCTYPE html>
<html lang="it">
<head><meta charset="utf-8"></head>
<body style="margin:0;background:#eef1f6;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#14243b">
    <div style="max-width:600px;margin:0 auto">
        <div style="background:#123a72;color:#ffffff;padding:18px 24px;border-radius:10px 10px 0 0;font-size:19px;font-weight:bold;letter-spacing:.5px">
            PASSPARTOUR
        </div>
        <div style="background:#ffffff;border:1px solid #e5e9f0;border-top:none;border-radius:0 0 10px 10px;padding:24px">
            {% if messaggio %}
                <p style="white-space:pre-line;font-size:14px;line-height:1.6;margin:0 0 18px">{{ messaggio }}</p>
            {% endif %}

            <div style="background:#f4f7fb;border-radius:8px;padding:16px 18px;margin:0 0 18px">
                <div style="font-weight:bold;color:#123a72;font-size:15px">{{ preventivo.titolo }}</div>
                <div style="font-size:13px;color:#6a7788;margin-top:2px">Preventivo {{ preventivo.numero }} · proposta in allegato (PDF)</div>
                {% if preventivo.validoFino %}
                    <div style="font-size:13px;color:#6a7788">Valida fino al {{ preventivo.validoFino|date('d/m/Y') }}</div>
                {% endif %}
            </div>

            <p style="font-size:12px;color:#9aa6b4;margin:0;border-top:1px solid #eef1f6;padding-top:14px">
                Passpartour · Gestionale agenzia viaggi. Questa email è stata inviata dalla tua agenzia di fiducia.
            </p>
        </div>
    </div>
</body>
</html>
