{% extends 'app.html.twig' %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{% block main %}
<div class="card" style="max-width:560px"><div class="card-pad">
    {{ form_start(form) }}
    <div style="display:grid;gap:14px">
        {{ form_row(form.nome) }}
        {{ form_row(form.descrizione) }}
        {% if destinazione.immagine %}
            <div>
                <label>Immagine attuale</label>
                <img src="{{ asset('uploads/destinazioni/' ~ destinazione.immagine) }}" alt="" style="width:100%;max-height:200px;object-fit:cover;border-radius:9px;border:1px solid var(--line)">
            </div>
        {% endif %}
        {{ form_row(form.immagineFile) }}
    </div>
    <div style="margin-top:18px;display:flex;gap:10px;justify-content:space-between">
        <div style="display:flex;gap:10px">
            <button type="submit" class="btn btn-primary">Salva</button>
            <a class="btn" href="{{ path('app_destinazione_index') }}">Annulla</a>
        </div>
        {% if destinazione.id %}
            <form method="post" action="{{ path('app_destinazione_elimina', {id: destinazione.id}) }}" onsubmit="return confirm('Eliminare la destinazione?')">
                <input type="hidden" name="_token" value="{{ csrf_token('destinazione_elimina_' ~ destinazione.id) }}">
                <button class="btn" style="color:var(--danger)">Elimina</button>
            </form>
        {% endif %}
    </div>
    {{ form_end(form) }}
</div></div>
{% endblock %}
