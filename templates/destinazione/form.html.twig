{% extends 'app.html.twig' %}

{% block title %}{{ titolo }} · Passpartour{% endblock %}
{% block page_title %}{{ titolo }}{% endblock %}

{% block main %}
<div class="card" style="max-width:600px"><div class="card-pad">
    {{ form_start(form, {attr: {id: 'form-destinazione'}}) }}
    <div style="display:grid;gap:14px">
        {{ form_row(form.nome) }}
        {{ form_row(form.descrizione) }}

        {{ include('_partials/_image_picker.html.twig', {
            form: form,
            unsplash_configurato: unsplash_configurato,
            immagine_corrente: destinazione.immagine ? asset('uploads/destinazioni/' ~ destinazione.immagine) : null,
            fotografo: destinazione.fotografo,
            fotografoUrl: destinazione.fotografoUrl,
        }) }}
    </div>

    {{ form_end(form) }}

    {# form di eliminazione: separato (NON annidato nel form principale) #}
    <div style="margin-top:18px;display:flex;gap:10px;justify-content:space-between">
        <div style="display:flex;gap:10px">
            <button type="submit" form="form-destinazione" class="btn btn-primary">Salva</button>
            <a class="btn" href="{{ path('app_destinazione_index') }}">Annulla</a>
        </div>
        {% if destinazione.id %}
            <form method="post" action="{{ path('app_destinazione_elimina', {id: destinazione.id}) }}" onsubmit="return confirm('Eliminare la destinazione?')">
                <input type="hidden" name="_token" value="{{ csrf_token('destinazione_elimina_' ~ destinazione.id) }}">
                <button class="btn" style="color:var(--danger)">Elimina</button>
            </form>
        {% endif %}
    </div>
</div></div>
{% endblock %}
