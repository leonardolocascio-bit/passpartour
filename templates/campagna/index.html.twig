{% extends 'app.html.twig' %}

{% block title %}Campagne · Passpartour{% endblock %}
{% block page_title %}Campagne lead gen{% endblock %}

{% block main %}
<div class="card">
    <div class="card-pad" style="border-bottom:1px solid var(--line)">
        <h3>Campagne <span class="muted" style="font-weight:500">({{ campagne|length }})</span></h3>
    </div>
    <table class="grid-table">
        <thead><tr><th>Nome</th><th>Fonte</th><th>Budget</th><th>Lead</th><th>Stato</th></tr></thead>
        <tbody>
        {% for c in campagne %}
            <tr>
                <td style="font-weight:600">{{ c.nome }}</td>
                <td class="muted">{{ c.fonte.label }}</td>
                <td>{{ c.budget ? '€ ' ~ c.budget|number_format(0, ',', '.') : '—' }}</td>
                <td>{{ c.lead|length }}</td>
                <td>
                    {% if c.attiva %}<span class="badge badge-vinto">Attiva</span>
                    {% else %}<span class="badge">Sospesa</span>{% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="muted" style="text-align:center;padding:28px">Nessuna campagna.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
