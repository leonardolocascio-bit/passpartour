{# Selettore immagine riutilizzabile: upload manuale + ricerca Unsplash + anteprima.
   Parametri: form (con campo immagineFile), unsplash_configurato,
   immagine_corrente (URL asset o null), fotografo, fotografoUrl. #}

{% if immagine_corrente %}
    <div>
        <label>Immagine attuale</label>
        <img src="{{ immagine_corrente }}" alt="" style="width:100%;max-height:200px;object-fit:cover;border-radius:9px;border:1px solid var(--line)">
        {% if fotografo %}
            <div class="muted" style="font-size:11px;margin-top:4px">Foto di
                {% if fotografoUrl %}<a href="{{ fotografoUrl }}" target="_blank" rel="noopener">{{ fotografo }}</a>{% else %}{{ fotografo }}{% endif %} · Unsplash</div>
        {% endif %}
    </div>
{% endif %}

{{ form_row(form.immagineFile) }}

{% if unsplash_configurato %}
    <div style="border-top:1px solid var(--line);padding-top:14px">
        <label>…oppure cerca su Unsplash</label>
        <div style="display:flex;gap:8px">
            <input type="text" id="unsplash-q" placeholder="Es. Maldive" style="flex:1">
            <button type="button" class="btn" id="unsplash-cerca">Cerca</button>
        </div>
        <div id="unsplash-risultati" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px"></div>
        <div id="unsplash-scelta" class="muted" style="font-size:12px;margin-top:6px"></div>
    </div>
{% else %}
    <p class="muted" style="font-size:12px;margin:0">💡 Imposta <code>UNSPLASH_ACCESS_KEY</code> in <code>.env.local</code> per cercare immagini direttamente da Unsplash.</p>
{% endif %}

<input type="hidden" name="unsplash_url" id="unsplash_url">
<input type="hidden" name="unsplash_autore" id="unsplash_autore">
<input type="hidden" name="unsplash_autore_url" id="unsplash_autore_url">

{% if unsplash_configurato %}
<script>
(function () {
    const q = document.getElementById('unsplash-q');
    const box = document.getElementById('unsplash-risultati');
    const scelta = document.getElementById('unsplash-scelta');

    async function cerca() {
        if (!q.value.trim()) return;
        box.innerHTML = '<span class="muted" style="font-size:12px">Ricerca…</span>';
        try {
            const r = await fetch('{{ path('api_unsplash_search') }}?orientation=landscape&per_page=12&q=' + encodeURIComponent(q.value));
            if (!r.ok) { box.innerHTML = '<span class="muted" style="font-size:12px">Ricerca non disponibile (limite orario o chiave).</span>'; return; }
            const data = await r.json();
            const risultati = data.results || [];
            box.innerHTML = '';
            if (!risultati.length) { box.innerHTML = '<span class="muted" style="font-size:12px">Nessun risultato.</span>'; return; }
            risultati.forEach(foto => {
                const img = document.createElement('img');
                img.src = foto.urls.thumb || foto.urls.small;
                img.title = 'Foto di ' + (foto.credit ? foto.credit.name : 'Unsplash');
                img.style.cssText = 'width:100%;height:70px;object-fit:cover;border-radius:6px;cursor:pointer;border:2px solid transparent;background:' + (foto.color || '#eee');
                img.addEventListener('click', () => seleziona(foto, img));
                box.appendChild(img);
            });
        } catch (e) { box.innerHTML = '<span class="muted" style="font-size:12px">Errore di ricerca.</span>'; }
    }

    async function seleziona(foto, img) {
        box.querySelectorAll('img').forEach(i => i.style.borderColor = 'transparent');
        img.style.borderColor = 'var(--brand)';
        scelta.textContent = 'Preparazione immagine…';
        try {
            const r = await fetch('{{ path('api_unsplash_select') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: foto.id }),
            });
            const data = await r.json();
            const credit = (data.photo && data.photo.credit) || foto.credit || {};
            document.getElementById('unsplash_url').value = data.download_url || foto.urls.full;
            document.getElementById('unsplash_autore').value = credit.name || '';
            document.getElementById('unsplash_autore_url').value = credit.profile_url || '';
            scelta.textContent = 'Selezionata: foto di ' + (credit.name || 'Unsplash') + ' — verrà scaricata al salvataggio.';
        } catch (e) {
            document.getElementById('unsplash_url').value = foto.urls.full;
            scelta.textContent = 'Selezionata (fallback).';
        }
    }

    document.getElementById('unsplash-cerca').addEventListener('click', cerca);
    q.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); cerca(); } });
})();
</script>
{% endif %}
