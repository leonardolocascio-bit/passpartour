{% extends 'base.html.twig' %}

{% set _route = app.request.attributes.get('_route') %}

{% block body %}
<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <img src="{{ asset('images/passpartour-white.png') }}" alt="Passpartour" class="brand-logo">
        </div>
        <nav class="nav">
            <a href="{{ path('app_dashboard') }}" class="{{ _route == 'app_dashboard' ? 'active' }}">
                <span class="ic">▚</span> Dashboard
            </a>
            <a href="{{ path('app_lead_index') }}" class="{{ _route starts with 'app_lead' ? 'active' }}">
                <span class="ic">◎</span> Lead
            </a>
            <a href="{{ path('app_inbox') }}" class="{{ _route starts with 'app_inbox' ? 'active' }}" style="justify-content:flex-start">
                <span class="ic">✉</span> Inbox
                {% set nonLetti = inbox_non_letti() %}
                <span class="unread-pill" id="inbox-badge" style="margin-left:auto;{{ nonLetti == 0 ? 'display:none' }}">{{ nonLetti }}</span>
            </a>
            <a href="{{ path('app_agenda') }}" class="{{ _route starts with 'app_agenda' or _route == 'app_automazioni' or _route == 'app_impostazioni' ? 'active' }}">
                <span class="ic">◔</span> Agenda
            </a>
            <a href="{{ path('app_preventivo_index') }}" class="{{ _route starts with 'app_preventivo' ? 'active' }}">
                <span class="ic">✎</span> Preventivi
            </a>
            <a href="{{ path('app_offerta_index') }}" class="{{ _route starts with 'app_offerta' ? 'active' }}">
                <span class="ic">✦</span> Offerte
            </a>
            <a href="{{ path('app_destinazione_index') }}" class="{{ _route starts with 'app_destinazione' ? 'active' }}">
                <span class="ic">◇</span> Destinazioni
            </a>
            <a href="{{ path('app_tipologia_index') }}" class="{{ _route starts with 'app_tipologia' ? 'active' }}">
                <span class="ic">◆</span> Tipologie
            </a>
            <a href="{{ path('app_tema_index') }}" class="{{ _route starts with 'app_tema' ? 'active' }}">
                <span class="ic">❖</span> Temi
            </a>
            <a href="{{ path('app_campagna_index') }}" class="{{ _route starts with 'app_campagna' ? 'active' }}">
                <span class="ic">◈</span> Campagne
            </a>
            <a href="{{ path('app_cliente_index') }}" class="{{ _route starts with 'app_cliente' ? 'active' }}">
                <span class="ic">☺</span> Clienti
            </a>
        </nav>
        <div class="sidebar-foot">
            <span class="demo-flag">Demo</span>
            <div style="margin-top:8px">Passpartour · CRM viaggi</div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="page-title">{% block page_title %}{% endblock %}</div>
            <div class="user-chip">
                {% if app.user %}
                    <span>{{ app.user.nomeCompleto ?: app.user.userIdentifier }}</span>
                    <span class="avatar">{{ (app.user.nome|default(app.user.userIdentifier))|first|upper }}</span>
                    <a class="btn" href="{{ path('app_logout') }}">Esci</a>
                {% endif %}
            </div>
        </header>
        <div class="content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="card card-pad" style="margin-bottom:16px;border-left:3px solid var(--{{ label == 'success' ? 'ok' : 'brand' }})">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block main %}{% endblock %}
        </div>
    </div>
</div>

{# ---- Inbox in tempo reale: Mercure (se configurato) + polling di riserva ---- #}
<script>
window.InboxLive = (function () {
    const badge = document.getElementById('inbox-badge');
    const titoloBase = document.title.replace(/^\(\d+\)\s*/, '');
    let ultimoNoto = 0;

    function applica(dati) {
        if (typeof dati.nonLetti === 'number' && badge) {
            badge.textContent = dati.nonLetti;
            badge.style.display = dati.nonLetti > 0 ? '' : 'none';
            document.title = (dati.nonLetti > 0 ? '(' + dati.nonLetti + ') ' : '') + titoloBase;
        }
        if (dati.ultimo && dati.ultimo > ultimoNoto) {
            ultimoNoto = dati.ultimo;
            document.dispatchEvent(new CustomEvent('inbox:segnale', {detail: dati}));
        }
    }

    // Tempo reale: hub Mercure (vuoto in locale → si usa solo il polling)
    const hub = '{{ inbox_mercure_url()|e('js') }}';
    if (hub && window.EventSource) {
        try {
            const es = new EventSource(hub + '?topic=' + encodeURIComponent('passpartour/inbox'));
            es.onmessage = (e) => { try { applica(JSON.parse(e.data)); } catch (err) {} };
            // in caso di errore EventSource si riconnette da solo; il polling copre i buchi
        } catch (e) {}
    }

    // Polling di riserva: 5s nelle pagine inbox, 30s altrove (solo per il badge)
    const inInbox = window.location.pathname.startsWith('/inbox');
    async function poll() {
        if (document.hidden) return;
        try {
            const r = await fetch('{{ path('app_inbox_stato') }}', {headers: {'Accept': 'application/json'}});
            if (r.ok) applica(await r.json());
        } catch (e) { /* rete assente: si riprova al giro dopo */ }
    }
    setInterval(poll, inInbox ? 5000 : 30000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
    poll();

    return {applica};
})();
</script>
{% endblock %}
