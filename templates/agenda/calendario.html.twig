{% extends 'app.html.twig' %}

{% block title %}Agenda · Passpartour{% endblock %}
{% block page_title %}Agenda · calendario{% endblock %}

{% set tipoColore = {'chiamata': '#1f9fd6', 'email': '#1c5099', 'sms': '#7c5cd0', 'whatsapp': '#1f9d54', 'appuntamento': '#ea5b24', 'nota': '#f6a41f', 'pagamento': '#c0392b', 'operativa': '#123a72', 'fattura': '#8e44ad'} %}

{% macro chip(a, tipoColore, full) %}
    <a class="cal-chip" style="background:{{ tipoColore[a.tipo.value] ?? '#6a7788' }}{{ a.completata ? ';opacity:.5;text-decoration:line-through' }}"
       href="{{ path('app_lead_scheda', {id: a.lead.id}) }}"
       title="{{ a.tipo.label }} · {{ a.titolo }} · {{ a.lead.nomeCompleto }}">{{ full and a.dataScadenza|date('H:i') != '00:00' ? a.dataScadenza|date('H:i') ~ ' ' }}{{ a.titolo }}</a>
{% endmacro %}
{% macro chipGoogle(e, full) %}
    <span class="cal-chip google"
          title="Google Calendar · {{ e.utente ? e.utente.nomeCompleto ~ ' · ' }}{{ e.titolo }}{{ not e.tuttoIlGiorno ? ' · ' ~ e.inizio|date('H:i') }}">🗓 {{ full and not e.tuttoIlGiorno ? e.inizio|date('H:i') ~ ' ' }}{{ e.utente ? e.utente.nome ~ ': ' }}{{ e.titolo }}</span>
{% endmacro %}
{% macro chipPub(c, full) %}
    <a class="cal-chip" style="background:#fff;color:#b07400;border:1px solid var(--amber){{ c.pubblicato ? ';opacity:.5;text-decoration:line-through' }}"
       href="{{ path('app_creator_digital_anteprima', {id: c.id}) }}"
       title="Pubblicazione {{ c.tipo.label|lower }} · {{ c.titolo }} · {{ c.stato.label }}">📣 {{ full and c.dataPubblicazione|date('H:i') != '00:00' ? c.dataPubblicazione|date('H:i') ~ ' ' }}{{ c.titolo }}</a>
{% endmacro %}
{% import _self as ui %}

{% block main %}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:12px;flex-wrap:wrap">
    {{ include('agenda/_tabs.html.twig', {attiva: vista, rif: rif}) }}
    <a class="btn" href="{{ path('app_impostazioni') }}">🗓 Google Calendar</a>
</div>

<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
    <a class="btn" href="{{ path('app_agenda_calendario', {vista: vista, data: prev|date('Y-m-d')}) }}">←</a>
    <a class="btn" href="{{ path('app_agenda_calendario', {vista: vista, data: oggi|date('Y-m-d')}) }}">Oggi</a>
    <a class="btn" href="{{ path('app_agenda_calendario', {vista: vista, data: next|date('Y-m-d')}) }}">→</a>
    <h2 style="font-size:18px;margin-left:6px">{{ titolo }}</h2>
</div>

{% if vista == 'giorno' %}
    <div class="card"><div class="card-pad">
        {% if attivita|length > 0 %}
            <div style="display:grid;gap:10px">
                {% for a in attivita %}
                    <div style="display:flex;align-items:center;gap:12px">
                        <span style="width:8px;height:8px;border-radius:50%;background:{{ tipoColore[a.tipo.value] ?? '#6a7788' }}"></span>
                        <span class="muted" style="width:44px;font-size:12px">{{ a.dataScadenza|date('H:i') != '00:00' ? a.dataScadenza|date('H:i') : '—' }}</span>
                        <span class="badge" style="font-size:11px">{{ a.tipo.label }}</span>
                        <span style="font-weight:600;{{ a.completata ? 'text-decoration:line-through;color:var(--muted)' }}">{{ a.titolo }}</span>
                        <a href="{{ path('app_lead_scheda', {id: a.lead.id}) }}" class="muted" style="font-size:13px">· {{ a.lead.nomeCompleto }}</a>
                        {% if a.automatica %}<span class="badge" style="background:#eaf3fb;color:#1c5099;font-size:10px">auto</span>{% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="muted" style="margin:0;text-align:center;padding:24px">Nessuna attività in questo giorno.</p>
        {% endif %}
        {% if pubblicazioni|length > 0 %}
            <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--line)">
                <div class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">📣 Pubblicazioni programmate</div>
                <div style="display:grid;gap:8px">
                    {% for c in pubblicazioni %}
                        <div style="display:flex;align-items:center;gap:12px">
                            <span style="width:8px;height:8px;border-radius:50%;background:var(--amber)"></span>
                            <span class="muted" style="width:44px;font-size:12px">{{ c.dataPubblicazione|date('H:i') != '00:00' ? c.dataPubblicazione|date('H:i') : '—' }}</span>
                            <span class="badge" style="font-size:11px">{{ c.tipo.label }}</span>
                            <a href="{{ path('app_creator_digital_anteprima', {id: c.id}) }}" style="font-weight:600;{{ c.pubblicato ? 'text-decoration:line-through;color:var(--muted)' }}">{{ c.titolo }}</a>
                            <span class="{{ c.stato.badgeClass }}" style="font-size:10px">{{ c.stato.label }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {% if eventi|length > 0 %}
            <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--line)">
                <div class="muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">🗓 Google Calendar operatori</div>
                <div style="display:grid;gap:8px">
                    {% for e in eventi %}
                        <div style="display:flex;align-items:center;gap:12px">
                            <span style="width:8px;height:8px;border-radius:50%;border:2px solid #1f9fd6"></span>
                            <span class="muted" style="width:44px;font-size:12px">{{ e.tuttoIlGiorno ? '—' : e.inizio|date('H:i') }}</span>
                            {% if e.utente %}<span class="badge" style="font-size:11px">{{ e.utente.nomeCompleto }}</span>{% endif %}
                            <span style="font-weight:600">{{ e.titolo }}</span>
                            {% if e.fine %}<span class="muted" style="font-size:12px">fino alle {{ e.fine|date('H:i') }}</span>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div></div>

{% elseif vista == 'settimana' %}
    <div class="cal-head">
        {% for g in giorni %}<div>{{ giorni_settimana[loop.index0] }} {{ g.data|date('d') }}</div>{% endfor %}
    </div>
    <div class="cal-week">
        {% for g in giorni %}
            <div class="cal-week-col {{ g.oggi ? 'oggi' }}">
                {% for a in g.attivita %}{{ ui.chip(a, tipoColore, true) }}{% endfor %}
                {% for c in g.pubblicazioni %}{{ ui.chipPub(c, true) }}{% endfor %}
                {% for e in g.eventi %}{{ ui.chipGoogle(e, true) }}{% endfor %}
                {% if g.attivita|length + g.eventi|length + g.pubblicazioni|length == 0 %}<span class="cal-more">—</span>{% endif %}
            </div>
        {% endfor %}
    </div>

{% elseif vista == 'anno' %}
    <div class="cal-year">
        {% for m in mesi %}
            <a class="card" style="text-decoration:none;color:inherit" href="{{ path('app_agenda_calendario', {vista: 'mese', data: m.data|date('Y-m-d')}) }}">
                <div class="card-pad" style="padding:12px 14px">
                    <div style="display:flex;justify-content:space-between;align-items:baseline">
                        <span style="font-weight:700">{{ m.nome }}</span>
                        <span class="badge" style="{{ m.count > 0 ? 'background:var(--brand);color:#fff' }}">{{ m.count }}</span>
                    </div>
                    <div class="mini-grid">
                        {% for _ in 1..m.offset %}<span class="mini-day"></span>{% endfor %}
                        {% for g in 1..m.giorni_totali %}
                            <span class="mini-day {{ m.giorni_con_attivita[g] is defined ? 'has' }}">{{ g }}</span>
                        {% endfor %}
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

{% else %}
    <div class="cal-head">
        {% for g in giorni_settimana %}<div>{{ g }}</div>{% endfor %}
    </div>
    <div class="cal-month">
        {% for settimana in settimane %}
            {% for cella in settimana %}
                <div class="cal-cell {{ cella.in_mese ? '' : 'fuori' }} {{ cella.oggi ? 'oggi' }}">
                    <div class="cal-daynum">{{ cella.data|date('j') }}</div>
                    {% for a in cella.attivita|slice(0, 3) %}{{ ui.chip(a, tipoColore, false) }}{% endfor %}
                    {% for c in cella.pubblicazioni|slice(0, 2) %}{{ ui.chipPub(c, false) }}{% endfor %}
                    {% for e in cella.eventi|slice(0, 2) %}{{ ui.chipGoogle(e, false) }}{% endfor %}
                    {% set extra = (cella.attivita|length > 3 ? cella.attivita|length - 3 : 0) + (cella.eventi|length > 2 ? cella.eventi|length - 2 : 0) + (cella.pubblicazioni|length > 2 ? cella.pubblicazioni|length - 2 : 0) %}
                    {% if extra > 0 %}<div class="cal-more">+{{ extra }} altre</div>{% endif %}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
