{% extends 'app.html.twig' %}

{% block title %}{{ etichetta|capitalize }} · Passpartour{% endblock %}
{% block page_title %}{{ chiave == 'tipologia' ? 'Tipologie di viaggio' : (chiave == 'tema' ? 'Temi di viaggio' : etichetta|capitalize) }}{% endblock %}

{% block main %}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <p class="muted" style="margin:0;font-size:13px">Sezione-catalogo con immagine e descrizione: diventerà una pagina del sito.</p>
    <a class="btn btn-primary" href="{{ path('app_' ~ chiave ~ '_nuovo') }}">+ Nuova {{ etichetta }}</a>
</div>

{% if voci|length > 0 %}
    <div class="grid" style="grid-template-columns:repeat(4,1fr)">
        {% for v in voci %}
            <div class="card" style="overflow:hidden">
                <div style="height:130px;background:#eef1f6">
                    {% if v.immagine %}
                        <img src="{{ asset('uploads/destinazioni/' ~ v.immagine) }}" alt="{{ v.nome }}" style="width:100%;height:100%;object-fit:cover;display:block">
                    {% else %}
                        <div style="width:100%;height:100%;display:grid;place-items:center;color:var(--muted);font-size:13px">nessuna immagine</div>
                    {% endif %}
                </div>
                <div class="card-pad" style="padding:12px 14px;display:flex;justify-content:space-between;align-items:center">
                    <div>
                        <div style="font-weight:700">{{ v.nome }}</div>
                        {% if v.descrizione %}<div class="muted" style="font-size:12px">{{ v.descrizione|length > 42 ? v.descrizione|slice(0, 42) ~ '…' : v.descrizione }}</div>{% endif %}
                        {% if v.fotografo %}<div class="muted" style="font-size:10px;margin-top:2px">📷 {{ v.fotografo }} · Unsplash</div>{% endif %}
                    </div>
                    <a class="muted" href="{{ path('app_' ~ chiave ~ '_modifica', {id: v.id}) }}" style="font-size:13px">Modifica</a>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="card"><div class="card-pad muted" style="text-align:center;padding:32px">
        Nessuna {{ etichetta }}. <a href="{{ path('app_' ~ chiave ~ '_nuovo') }}">Crea la prima</a>.
    </div></div>
{% endif %}
{% endblock %}
