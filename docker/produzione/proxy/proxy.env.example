# Valori del proxy che cambiano da server a server.
#
#   cp proxy.env.example proxy.env && chmod 600 proxy.env
#
# Il file compilato NON va nel repository: contiene l'impronta della password
# del collaudo.

# Indirizzo a cui Let's Encrypt scrive se un rinnovo dei certificati va storto.
# Dev'essere una casella che qualcuno legge davvero: è l'unico avviso che
# arriva prima che il sito diventi irraggiungibile per certificato scaduto.
ACME_EMAIL=

# Impronta della password che protegge stagingest.passpartour.com
# (utente: collaudo). Si genera con:
#   docker run --rm caddy:2-alpine caddy hash-password
# Incolla qui la riga che inizia con $2a$ — l'impronta, non la password.
STAGING_PASSWORD_HASH=
