# PRODUZIONE — gestionale.passpartour.com. Dati reali di lead e clienti.
#
# Copiare in "prod.env" sul server e compilare. Il file con i valori veri NON
# va mai messo nel repository: contiene le chiavi.
#   cp prod.env.example prod.env && chmod 600 prod.env

# Nome con cui il proxy raggiunge questo ambiente (deve combaciare con il
# Caddyfile). Non cambiarlo se non si cambia anche là.
ALIAS_WEB=prod-app

# --- Applicazione -----------------------------------------------------------
# Stringa casuale, generala con:  openssl rand -hex 32
# Cambiarla dopo il primo avvio invalida tutte le sessioni: si sceglie una volta.
APP_SECRET=

# URL pubblico di questo ambiente: lo usano worker e comandi CLI per i link
# nelle email. Deve combaciare con il dominio nel Caddyfile.
DEFAULT_URI=https://gestionale.passpartour.com

# Nessun dato demo: il database resta vuoto e gli account si creano davvero.
# NON impostare DEMO_SEED qui. Vale 0 e va bene così.

# Token del webhook di ingestione lead (POST /webhook/lead/{token}).
# Da dare alle piattaforme di lead gen. Casuale:  openssl rand -hex 16
PASSPARTOUR_WEBHOOK_TOKEN=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=passpartour
POSTGRES_DB=passpartour
# Password lunga e casuale:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Google Calendar (sync agenda) ------------------------------------------
# Progetto Google Cloud > Credenziali > ID client OAuth "App web".
# Redirect da autorizzare: https://gestionale.passpartour.com/impostazioni/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Unsplash (ricerca immagini destinazioni) -------------------------------
UNSPLASH_ACCESS_KEY=

# --- Anthropic (caption social dell'impaginatore) ---------------------------
# Senza chiave l'impaginatore usa caption da template (funziona comunque).
ANTHROPIC_API_KEY=

# --- Twilio (SMS / WhatsApp) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# --- Posta ------------------------------------------------------------------
# Le email (preventivi, offerte ai clienti) partono dal worker via questo DSN.
# Finché resta null://null non parte niente — e nessuno se ne accorge.
# Esempio: smtp://utente:password@host:587
MAILER_DSN=null://null
MAILER_FROM=Passpartour <noreply@passpartour.com>
