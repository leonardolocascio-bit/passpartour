# COLLAUDO — stagingest.passpartourviaggi.com.
#
# Qui arrivano gli aggiornamenti e le integrazioni PRIMA della produzione: si
# provano su questo ambiente e solo dopo si promuovono. Nessun dato reale.
#
#   cp staging.env.example staging.env && chmod 600 staging.env

ALIAS_WEB=staging-app

# --- Applicazione -----------------------------------------------------------
APP_SECRET=

DEFAULT_URI=https://stagingest.passpartourviaggi.com

# Dati dimostrativi: al primo avvio, se il database è vuoto, si popola da sé
# (account demo master@/giulia@/marco@passpartour.local, password passpartour).
# Toglilo se invece ci carichi a mano una copia della produzione per provare
# una migrazione — ma allora ricordati che dentro ci sono dati veri.
DEMO_SEED=1

# Token del webhook lead per le prove (diverso da quello di produzione).
PASSPARTOUR_WEBHOOK_TOKEN=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=passpartour
POSTGRES_DB=passpartour
POSTGRES_PASSWORD=

# --- Google Calendar --------------------------------------------------------
# Meglio un calendario di prova: la sync è bidirezionale e il collaudo
# scriverebbe eventi finti su quello vero.
# Redirect da autorizzare: https://stagingest.passpartourviaggi.com/impostazioni/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Unsplash ---------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Twilio -----------------------------------------------------------------
# Qui al massimo la sandbox: il collaudo non deve scrivere a clienti veri.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# --- Meta (inbox WhatsApp / Messenger / Instagram) ---------------------------
# App Meta collegata alla pagina Passpartour. Webhook da registrare su Meta:
#   https://stagingest.passpartourviaggi.com/webhook/meta/<META_VERIFY_TOKEN>
# (il proxy lascia passare /webhook/* senza password, come per i lead).
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# --- Mercure (inbox in tempo reale) -------------------------------------------
# Hub integrato in FrankenPHP: pubblicazione interna dall'app, sottoscrizione
# del browser su /.well-known/mercure. Segreto: openssl rand -hex 32
MERCURE_URL=http://127.0.0.1/.well-known/mercure
MERCURE_PUBLIC_URL=https://stagingest.passpartourviaggi.com/.well-known/mercure
MERCURE_JWT_SECRET=

# --- Posta ------------------------------------------------------------------
# null://null = le email si accodano ma non partono: per il collaudo di solito
# va bene così. Per provare l'invio vero usa una casella di prova.
MAILER_DSN=null://null
MAILER_FROM=Passpartour Collaudo <noreply@passpartourviaggi.com>
